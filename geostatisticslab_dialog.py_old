    def export_gslib_model(self):
        structures = self.get_models_from_table()
        if not structures: return
        nugget_sill = sum(s['sill'] for s in structures if s['type'] == "Nugget")
        spatial_structures = [s for s in structures if s['type'] != "Nugget"]
        
        gslib_lines = ["#theoretical variogram parameters", f"{len(spatial_structures)} {nugget_sill:<10.4f} % number of nested structures, nugget effect"]
        gslib_type_mapping = {"Spherical": 1, "Exponential": 2, "Cubic": 5, "Gaussian": 6, "Linear": 12}

        for idx, s in enumerate(spatial_structures):
            it = gslib_type_mapping.get(s['type'], 1)
            gslib_lines.append(f"{it} {s['sill']:.4f} {s['r1']:.4f} {s['r2']:.4f} {s['r3']:.4f} {s['a1']:.4f} {s['a2']:.4f} {s['a3']:.4f} % {idx + 1}st structure")

        file_path, _ = QtWidgets.QFileDialog.getSaveFileName(self, "Export GSLIB Variogram Model Parameters", "", "Text Files (*.txt *.par)")
        if file_path:
            with open(file_path, 'w', encoding='utf-8') as f: f.write("\n".join(gslib_lines) + "\n")

    def calculate_theoretical_semivariance(self, h, azimuth_or_coords, structures):
        """Compute the theoretical semivariance for an array of distances h.

        azimuth_or_coords can be:
          - a float scalar  -> single azimuth in geographic degrees (0=North, clockwise),
            used e.g. for variogram plotting or omnidirectional calls (az=0.0)
          - a tuple (x_from, y_from, x_to, y_to) -> pair coordinates;
            the azimuth is computed automatically per pair as
            arctan2(dX, dY) % 180 (range [0,180) exploiting variogram symmetry)
        """
        h = np.asarray(h, dtype=float)
        # Resolve azimuth: scalar value or per-pair computation from coordinates
        if isinstance(azimuth_or_coords, tuple):
            x_from, y_from, x_to, y_to = azimuth_or_coords
            dx = np.asarray(x_to) - np.asarray(x_from)
            dy = np.asarray(y_to) - np.asarray(y_from)
            azimuth = np.degrees(np.arctan2(dx, dy)) % 180.0  # shape uguale a h
        elif np.isscalar(azimuth_or_coords):
            azimuth = float(azimuth_or_coords)
        else:
            azimuth = np.asarray(azimuth_or_coords, dtype=float)

        gamma = np.zeros_like(h, dtype=float)
        for struct in structures:
            stype = struct['type']
            sill  = struct['sill']
            if sill <= 0:
                continue
            if stype == "Nugget":
                gamma[h > 0] += sill
                continue
            r_major = struct['r1']
            r_minor = struct['r2'] if struct['r2'] > 0 else r_major
            a1      = struct['a1']
            beta    = np.radians(azimuth - a1)
            denom   = np.sqrt((np.cos(beta) / r_major)**2 + (np.sin(beta) / r_minor)**2)
            # r_eff vectorised (works with both a scalar azimuth and a per-pair array)
            r_eff   = np.where(denom > 0, 1.0 / denom, r_major)
            h_ratio = np.where(r_eff > 0, h / r_eff, 0.0)
            if stype == "Spherical":
                gamma += np.where(h_ratio <= 1.0,
                                  sill * (1.5*h_ratio - 0.5*h_ratio**3), sill)
            elif stype == "Exponential":
                gamma += sill * (1.0 - np.exp(-3.0 * h_ratio))
            elif stype == "Gaussian":
                gamma += sill * (1.0 - np.exp(-3.0 * h_ratio**2))
            elif stype == "Linear":
                gamma += sill * h_ratio
            elif stype == "Cubic":
                gamma += np.where(h_ratio <= 1.0,
                                  sill * (7.0*h_ratio**2 - 8.75*h_ratio**3 +
                                          3.5*h_ratio**5 - 0.75*h_ratio**7), sill)
        return gamma
    def get_total_sill(self, structures):
        """Return the total sill of the model (C0)."""
        return sum(struct['sill'] for struct in structures)
    
    def get_covariance(self, h, azimuth, structures):
        """        Converte la semivarianza teorica in covarianza teorica.        C(h) = C(0) - gamma(h)        """
        total_sill = self.get_total_sill(structures)
        gamma = self.calculate_theoretical_semivariance(h, azimuth, structures)
        
        # La covarianza ' il sill totale meno la semivarianza
        # Use np.maximum to avoid tiny negative values caused by floating-point rounding
        return np.maximum(total_sill - gamma, 0.0)
        
        
    def ceil_to_nice_number(self, val):
        if val <= 0: return val
        exponent = int(np.floor(np.log10(val)))
        base = 10 ** exponent
        normalized = val / base
        for step in [1.0, 1.5, 2.0, 2.5, 5.0, 7.5, 10.0]:
            if normalized <= step: return step * base
        return 10.0 * base

    def get_nice_bounds(self, xmin, xmax, ymin, ymax):
        range_x, range_y = xmax - xmin, ymax - ymin
        max_range = max(range_x, range_y)
        if max_range <= 0: return xmin, xmax, ymin, ymax
        exponent = int(np.floor(np.log10(max_range)))
        base = 10 ** exponent
        norm = max_range / base
        step = base / 10.0 if norm < 2 else (base / 5.0 if norm < 5 else base / 2.0)
        return np.floor(xmin / step) * step, np.ceil(xmax / step) * step, np.floor(ymin / step) * step, np.ceil(ymax / step) * step

    def update_kriging_grid_defaults(self):
        layer = self.mMapLayerComboBox.currentLayer()
        if not layer: return
        extent = layer.extent()
        x_min, x_max, y_min, y_max = self.get_nice_bounds(extent.xMinimum(), extent.xMaximum(), extent.yMinimum(), extent.yMaximum())
        
        Nx = 50
        dx = self.ceil_to_nice_number((x_max - x_min) / float(Nx))
        dy = dx
        Ny = int(np.ceil((y_max - y_min) / dy)) if dy > 0 else 50
        x_max, y_max = x_min + Nx * dx, y_min + Ny * dy
        
        for sb in [self.doubleSpinBox_xmin, self.doubleSpinBox_xmax, self.doubleSpinBox_ymin, self.doubleSpinBox_ymax,
                   self.spinBox_Nx, self.spinBox_Ny, self.doubleSpinBox_dx, self.doubleSpinBox_dy]:
            sb.blockSignals(True)
        
        self.doubleSpinBox_xmin.setValue(x_min)
        self.doubleSpinBox_xmax.setValue(x_max)
        self.doubleSpinBox_ymin.setValue(y_min)
        self.doubleSpinBox_ymax.setValue(y_max)
        self.spinBox_Nx.setValue(Nx)
        self.spinBox_Ny.setValue(Ny)
        self.doubleSpinBox_dx.setValue(dx)
        self.doubleSpinBox_dy.setValue(dy)
        
        for sb in [self.doubleSpinBox_xmin, self.doubleSpinBox_xmax, self.doubleSpinBox_ymin, self.doubleSpinBox_ymax,
                   self.spinBox_Nx, self.spinBox_Ny, self.doubleSpinBox_dx, self.doubleSpinBox_dy]:
            sb.blockSignals(False)

        # Default search radius = half the shortest side of the data bounding box
        search_r_default = min(x_max - x_min, y_max - y_min) / 2.0
        for sb in [self.doubleSpinBox_searchR_max, self.doubleSpinBox_searchR_min,
                   self.doubleSpinBox_search_azimuth]:
            sb.blockSignals(True)
        self.doubleSpinBox_searchR_max.setValue(search_r_default)
        self.doubleSpinBox_searchR_min.setValue(search_r_default)
        self.doubleSpinBox_search_azimuth.setValue(0.0)
        for sb in [self.doubleSpinBox_searchR_max, self.doubleSpinBox_searchR_min,
                   self.doubleSpinBox_search_azimuth]:
            sb.blockSignals(False)

        # Set the default name for the estimated output layer
        self.lineEdit_estimated_layer_name.setText(f"{layer.name()}")

    def on_bounds_changed(self):
        xmin, xmax, ymin, ymax = self.doubleSpinBox_xmin.value(), self.doubleSpinBox_xmax.value(), self.doubleSpinBox_ymin.value(), self.doubleSpinBox_ymax.value()
        Nx, Ny = self.spinBox_Nx.value(), self.spinBox_Ny.value()
        if Nx > 0:
            self.doubleSpinBox_dx.blockSignals(True)
            self.doubleSpinBox_dx.setValue((xmax - xmin) / float(Nx))
            self.doubleSpinBox_dx.blockSignals(False)
        if Ny > 0:
            self.doubleSpinBox_dy.blockSignals(True)
            self.doubleSpinBox_dy.setValue((ymax - ymin) / float(Ny))
            self.doubleSpinBox_dy.blockSignals(False)

    def on_grid_size_or_resolution_changed(self):
        xmin, ymin = self.doubleSpinBox_xmin.value(), self.doubleSpinBox_ymin.value()
        Nx, Ny = self.spinBox_Nx.value(), self.spinBox_Ny.value()
        dx, dy = self.doubleSpinBox_dx.value(), self.doubleSpinBox_dy.value()
        
        self.doubleSpinBox_xmax.blockSignals(True)
        self.doubleSpinBox_ymax.blockSignals(True)
        self.doubleSpinBox_xmax.setValue(xmin + Nx * dx)
        self.doubleSpinBox_ymax.setValue(ymin + Ny * dy)
        self.doubleSpinBox_xmax.blockSignals(False)
        self.doubleSpinBox_ymax.blockSignals(False)

    def update_angular_tolerance(self):
        num_dirs = self.spinBox_num_directions.value()
        if num_dirs > 0: self.doubleSpinBox_angular_tolerance.setValue(90.0 / num_dirs)

    def update_angular_tolerance_variogram_map(self):
        """The variogram map covers the full 360 degrees (unlike the standard
        directional variogram, which is symmetric over 180 degrees), so each
        of the N sectors spans 360/N degrees and the tolerance (half-sector)
        is 180/N degrees."""
        num_dirs = self.spinBox_num_directions_variogram_map.value()
        if num_dirs > 0:
            self.doubleSpinBox_angular_tolerance_variogram_map.setValue(180.0 / num_dirs)

    def update_fields(self):
        layer = self.mMapLayerComboBox.currentLayer()
        if layer:
            self.mFieldComboBox.setLayer(layer)
            extent = layer.extent()
            raw_max_dist = min((extent.xMaximum() - extent.xMinimum()) / 2.0, (extent.yMaximum() - extent.yMinimum()) / 2.0)
            auto_max_dist = self.ceil_to_nice_number(raw_max_dist)
            num_lags = self.spinBox_num_lags.value()
            
            for sb in [self.doubleSpinBox_max_distance, self.doubleSpinBox_lag, self.doubleSpinBox_lag_tolerance]:
                sb.blockSignals(True)
            self.doubleSpinBox_max_distance.setValue(auto_max_dist)
            if num_lags > 1:
                initial_lag = auto_max_dist / (num_lags - 1)
                self.doubleSpinBox_lag.setValue(initial_lag)
                self.doubleSpinBox_lag_tolerance.setValue(initial_lag / 2.0)
            for sb in [self.doubleSpinBox_max_distance, self.doubleSpinBox_lag, self.doubleSpinBox_lag_tolerance]:
                sb.blockSignals(False)

            # Same auto-defaults for the variogram map widgets.
            # GSLIB convention: MaxDistance = (num_lags - 1) * lag,
            # matching the standard Variogram tab (line above uses num_lags - 1).
            num_lags_map = self.spinBox_num_lags_variogram_map.value()
            for sb in [self.doubleSpinBox_max_distance_variogram_map,
                      self.doubleSpinBox_lag_variogram_map,
                      self.doubleSpinBox_lag_tolerance_variogram_map]:
                sb.blockSignals(True)
            self.doubleSpinBox_max_distance_variogram_map.setValue(auto_max_dist)
            if num_lags_map > 1:
                initial_lag_map = auto_max_dist / (num_lags_map - 1)
                self.doubleSpinBox_lag_variogram_map.setValue(initial_lag_map)
                self.doubleSpinBox_lag_tolerance_variogram_map.setValue(initial_lag_map / 2.0)
            elif num_lags_map == 1:
                self.doubleSpinBox_lag_variogram_map.setValue(auto_max_dist)
                self.doubleSpinBox_lag_tolerance_variogram_map.setValue(auto_max_dist / 2.0)
            for sb in [self.doubleSpinBox_max_distance_variogram_map,
                      self.doubleSpinBox_lag_variogram_map,
                      self.doubleSpinBox_lag_tolerance_variogram_map]:
                sb.blockSignals(False)

            self.update_kriging_grid_defaults()

            # -- Plausible defaults for cell declustering ------------------------
            # A reasonable starting cell size is the size that would contain,
            # on average, exactly one point if points were spread uniformly
            # over the layer's bounding box: cell_size ~= sqrt(area / n).
            # The min/max range to scan for the diagnostic curve follows the
            # common GSLIB rule of thumb of testing roughly half to a few
            # times that size.
            if hasattr(self, 'doubleSpinBox_cell_size'):
                area = (extent.xMaximum() - extent.xMinimum()) * (extent.yMaximum() - extent.yMinimum())
                n_points = layer.featureCount()
                if area > 0 and n_points > 0:
                    avg_cell_size = np.sqrt(area / n_points)
                    auto_cell_size = self.ceil_to_nice_number(avg_cell_size)

                    for sb in [self.doubleSpinBox_cell_size, self.doubleSpinBox_cell_size_min,
                              self.doubleSpinBox_cell_size_max]:
                        sb.blockSignals(True)
                    self.doubleSpinBox_cell_size.setValue(auto_cell_size)
                    self.doubleSpinBox_cell_size_min.setValue(max(auto_cell_size * 0.5, 1e-6))
                    self.doubleSpinBox_cell_size_max.setValue(auto_cell_size * 3.0)
                    for sb in [self.doubleSpinBox_cell_size, self.doubleSpinBox_cell_size_min,
                              self.doubleSpinBox_cell_size_max]:
                        sb.blockSignals(False)
                    if hasattr(self, 'spinBox_cell_size_steps') and self.spinBox_cell_size_steps.value() < 5:
                        self.spinBox_cell_size_steps.setValue(20)

    def on_max_distance_changed(self):
        max_dist = self.doubleSpinBox_max_distance.value()
        num_lags = self.spinBox_num_lags.value()
        # GSLIB/AutoVar bin convention: centers at h = 0, lag, 2*lag, ...,
        # (num_lags-1)*lag, so max_dist = (num_lags-1)*lag (not num_lags*lag).
        if num_lags > 1:
            lag = max_dist / (num_lags - 1)
            self.doubleSpinBox_lag.blockSignals(True)
            self.doubleSpinBox_lag_tolerance.blockSignals(True)
            self.doubleSpinBox_lag.setValue(lag)
            self.doubleSpinBox_lag_tolerance.setValue(lag / 2.0)
            self.doubleSpinBox_lag.blockSignals(False)
            self.doubleSpinBox_lag_tolerance.blockSignals(False)

    def on_num_lags_changed(self):
        num_lags = self.spinBox_num_lags.value()
        lag = self.doubleSpinBox_lag.value()
        self.doubleSpinBox_max_distance.blockSignals(True)
        self.doubleSpinBox_max_distance.setValue((num_lags - 1) * lag if num_lags > 1 else 0.0)
        self.doubleSpinBox_max_distance.blockSignals(False)

    def on_lag_changed(self):
        lag = self.doubleSpinBox_lag.value()
        num_lags = self.spinBox_num_lags.value()
        self.doubleSpinBox_lag_tolerance.blockSignals(True)
        self.doubleSpinBox_max_distance.blockSignals(True)
        self.doubleSpinBox_lag_tolerance.setValue(lag / 2.0)
        self.doubleSpinBox_max_distance.setValue((num_lags - 1) * lag if num_lags > 1 else 0.0)
        self.doubleSpinBox_lag_tolerance.blockSignals(False)
        self.doubleSpinBox_max_distance.blockSignals(False)

    def on_max_distance_changed_variogram_map(self):
        max_dist = self.doubleSpinBox_max_distance_variogram_map.value()
        num_lags = self.spinBox_num_lags_variogram_map.value()
        # GSLIB convention: MaxDistance = (num_lags - 1) * lag
        if num_lags > 1:
            lag = max_dist / (num_lags - 1)
        elif num_lags == 1:
            lag = max_dist
        else:
            return
        self.doubleSpinBox_lag_variogram_map.blockSignals(True)
        self.doubleSpinBox_lag_tolerance_variogram_map.blockSignals(True)
        self.doubleSpinBox_lag_variogram_map.setValue(lag)
        self.doubleSpinBox_lag_tolerance_variogram_map.setValue(lag / 2.0)
        self.doubleSpinBox_lag_variogram_map.blockSignals(False)
        self.doubleSpinBox_lag_tolerance_variogram_map.blockSignals(False)

    def on_num_lags_changed_variogram_map(self):
        num_lags = self.spinBox_num_lags_variogram_map.value()
        lag = self.doubleSpinBox_lag_variogram_map.value()
        # GSLIB convention: MaxDistance = (num_lags - 1) * lag
        self.doubleSpinBox_max_distance_variogram_map.blockSignals(True)
        self.doubleSpinBox_max_distance_variogram_map.setValue(max(num_lags - 1, 0) * lag)
        self.doubleSpinBox_max_distance_variogram_map.blockSignals(False)

    def on_lag_changed_variogram_map(self):
        lag = self.doubleSpinBox_lag_variogram_map.value()
        self.doubleSpinBox_lag_tolerance_variogram_map.blockSignals(True)
        self.doubleSpinBox_lag_tolerance_variogram_map.setValue(lag / 2.0)
        self.doubleSpinBox_lag_tolerance_variogram_map.blockSignals(False)

    def calculate_statistics(self):
        layer = self.mMapLayerComboBox.currentLayer()
        field_name = self.mFieldComboBox.currentField()
        if not layer or not field_name: return
        values = []
        for f in layer.getFeatures():
            val = f[field_name]
            if val != NULL and val is not None:
                try: values.append(float(val))
                except (ValueError, TypeError): continue
        if not values: return
        self.last_stats_values = values
        
        stats = {"Data Count": len(values), "Mean": np.mean(values), "Median": np.median(values), "Min": np.min(values), "Max": np.max(values), "Std Dev": np.std(values)}
        self.label_results.setText("\n".join([f"{k}: {v}" if isinstance(v, int) else f"{k}: {v:.4f}" for k, v in stats.items()]))
        self.plot_histogram(values)
        # Compute mean value
        mean_val = np.mean(values)
        # Update the SpinBox (using blockSignals to avoid unnecessary retriggers)
        self.doubleSpinBox_mean_sk.blockSignals(True)
        self.doubleSpinBox_mean_sk.setValue(mean_val)
        self.doubleSpinBox_mean_sk.blockSignals(False)
    def on_cum_hist_changed(self):
        if self.last_stats_values is not None: self.plot_histogram(self.last_stats_values)

    def plot_histogram(self, data):
        self.figure_histo.clear()
        ax = self.figure_histo.add_subplot(111)
        weights = np.ones(len(data)) / len(data) * 100
        ax.hist(data, bins=15, weights=weights, color='royalblue', alpha=0.7, edgecolor='white', label='Frequency')
        ax.set_title("Statistical Data Distribution")
        ax.set_xlabel("Value")
        ax.set_ylabel("Frequency (%)")
        ax.grid(True, linestyle=':', alpha=0.6)
        
        if hasattr(self, 'checkBox_cum_hist') and self.checkBox_cum_hist.isChecked():
            ax2 = ax.twinx()
            sorted_data = np.sort(data)
            cumulative_percentage = np.arange(1, len(sorted_data) + 1) / len(sorted_data) * 100
            ax2.plot(sorted_data, cumulative_percentage, color='firebrick', linewidth=2, label='Cumulative Frequency')
            ax2.set_ylabel("Cumulative Frequency (%)")
            ax2.set_ylim(0, 105)
            lines1, labels1 = ax.get_legend_handles_labels()
            lines2, labels2 = ax2.get_legend_handles_labels()
            ax.legend(lines1 + lines2, labels1 + labels2, loc='upper left')
        else:
            ax.legend(loc='upper left')
        self.figure_histo.tight_layout() 
        self.canvas_histo.draw()

    @staticmethod
    def _autovar_adaptive_lag(coords, n_neighbors=4, min_spacing=1.0):
        """Replicate the lag-spacing algorithm from the AutoVar Fortran
        project (subroutine datspac_horz in datspac_xy.f90):

        For each point, find its n_neighbors nearest *distinct* neighbors
        (duplicates closer than min_spacing apart are skipped, to avoid
        near-zero distances from coincident locations), and record the
        minimum, average, and maximum distance to those neighbors. Then
        average each of those three quantities across all points, giving
        three domain-wide spacing statistics:

            avg_min : average of each point's nearest-neighbor distance
            avg_avg : average of each point's mean distance to its
                      n_neighbors nearest neighbors (used as the
                      "default" lag size, matching AutoVar's primary
                      direction lag)
            avg_max : average of each point's farthest distance among its
                      n_neighbors nearest neighbors

        Returns (avg_min, avg_avg, avg_max).
        """
        n = len(coords)
        if n < 2:
            return 0.0, 0.0, 0.0

        k = min(n_neighbors, n - 1)
        dist_min = np.zeros(n)
        dist_avg = np.zeros(n)
        dist_max = np.zeros(n)

        for i in range(n):
            dx = coords[:, 0] - coords[i, 0]
            dy = coords[:, 1] - coords[i, 1]
            d = np.sqrt(dx**2 + dy**2)
            d = d[d >= min_spacing]  # drop self (d=0) and near-duplicate points
            if len(d) == 0:
                continue
            d_sorted = np.sort(d)[:k]
            dist_min[i] = d_sorted[0]
            dist_max[i] = d_sorted[-1]
            dist_avg[i] = np.mean(d_sorted)

        valid = dist_avg > 0
        if not np.any(valid):
            return 0.0, 0.0, 0.0

        avg_min = float(np.mean(dist_min[valid]))
        avg_avg = float(np.mean(dist_avg[valid]))
        avg_max = float(np.mean(dist_max[valid]))
        return avg_min, avg_avg, avg_max

    # ---------------------------------------------------------
    # AutoVar (automatic variogram in the two principal directions)
    # ---------------------------------------------------------
    def run_autovar(self):
        """Run the Python port of the AutoVar program (autovar_core.py) on the
        selected layer / field, then draw the experimental variogram of the two
        principal directions together with the model fitted by AutoVar."""
        layer = self.mMapLayerComboBox.currentLayer()
        field_name = self.mFieldComboBox.currentField()
        if not layer or not field_name:
            QtWidgets.QMessageBox.warning(self, "Warning", "Please select a valid layer and field.")
            return

        try:
            from . import autovar_core as av
        except ImportError:
            import autovar_core as av
        if getattr(av, 'AUTOVAR_CORE_VERSION', 1) < 2:
            QtWidgets.QMessageBox.critical(
                self, "AutoVar",
                "The file autovar_core.py in the plugin folder is an old version.\n"
                "Replace it with the latest autovar_core.py and restart QGIS "
                "(or reload the plugin).")
            return

        # -- data: same extraction rule used by the experimental variogram ---------------
        xs, ys, vs = [], [], []
        for f in layer.getFeatures():
            if not f.hasGeometry():
                continue
            val = f[field_name]
            if val == NULL or val is None:
                continue
            try:
                pt = f.geometry().asPoint()
                v = float(val)
                x, y = float(pt.x()), float(pt.y())
            except (ValueError, TypeError):
                continue
            if np.isfinite(x) and np.isfinite(y) and np.isfinite(v):
                xs.append(x)
                ys.append(y)
                vs.append(v)
        if len(vs) < 30:
            QtWidgets.QMessageBox.warning(
                self, "AutoVar", "AutoVar needs at least 30 valid data points (found %d)." % len(vs))
            return

        # -- progress dialog (the random-search fit takes about a minute) ----------------
        QApp = QtWidgets.QApplication
        dlg = QtWidgets.QProgressDialog("AutoVar: preparing...", "Cancel", 0, 100, self)
        dlg.setWindowTitle("AutoVar")
        dlg.setWindowModality(QtCore.Qt.WindowModal)
        dlg.setMinimumDuration(0)
        dlg.setValue(0)
        self.pushButton_runAutoVar.setEnabled(False)
        if hasattr(self, 'progressBar_autofit'):
            self.progressBar_autofit.setValue(0)

        def _log(msg):
            dlg.setLabelText("AutoVar: " + msg)
            QApp.processEvents()
            if dlg.wasCanceled():
                raise av.AutoVarCancelled()

        def _progress(it, total, obj):
            pct = int(100.0 * it / total)
            dlg.setLabelText("AutoVar: fitting the model (%d%%), objective = %.4f" % (pct, obj))
            dlg.setValue(min(pct, 99))
            if hasattr(self, 'progressBar_autofit'):
                self.progressBar_autofit.setValue(pct)
            QApp.processEvents()
            if dlg.wasCanceled():
                raise av.AutoVarCancelled()

        # checkBox_reproduce_autovar: run the algorithm as in the original Fortran program,
        # including its known bugs and its single-precision input (for comparison only).
        reproduce = (hasattr(self, 'checkBox_reproduce_autovar')
                     and self.checkBox_reproduce_autovar.isChecked())
        t0 = time.perf_counter()
        try:
            _log("computing the principal directions and the experimental variograms...")
            res = av.run_autovar(np.array(xs), np.array(ys), np.array(vs),
                                 progress=_progress, log=_log,
                                 legacy=reproduce, float32_input=reproduce)
        except av.AutoVarCancelled:
            dlg.close()
            self.pushButton_runAutoVar.setEnabled(True)
            return
        except av.AutoVarError as exc:
            dlg.close()
            self.pushButton_runAutoVar.setEnabled(True)
            QtWidgets.QMessageBox.warning(self, "AutoVar", str(exc))
            return
        except Exception as exc:                      # pragma: no cover
            dlg.close()
            self.pushButton_runAutoVar.setEnabled(True)
            QtWidgets.QMessageBox.critical(self, "AutoVar", "AutoVar failed:\n%s" % exc)
            return
        dlg.setValue(100)
        dlg.close()
        self.pushButton_runAutoVar.setEnabled(True)
        if hasattr(self, 'progressBar_autofit'):
            self.progressBar_autofit.setValue(100)

        self.last_autovar_result = res
        self.last_autovar_time_s = time.perf_counter() - t0
        # Show the run time in the label next to the AutoVar button (label present in the GUI)
        if hasattr(self, 'label_computing_time_autovar'):
            self.label_computing_time_autovar.setText(
                "Computing time: " + self._format_elapsed_time(self.last_autovar_time_s))
        self._plot_autovar(res, field_name)

        m = res['model']
        lines = ["AutoVar finished in %s." % self._format_elapsed_time(self.last_autovar_time_s),
                 "Mode: %s" % ("reproduction of the original Fortran program (with its bugs)" if reproduce
                               else "corrected algorithm"),
                 "",
                 "Data: %d   mean = %.4g   variance = %.4g" % (res['nd'], res['mean'], res['variance']),
                 "Major axis: azimuth %.2f\u00b0 (GSLIB azimuth %.2f\u00b0)   minor axis: %.2f\u00b0"
                 % (res['az_major'], res['angle_gslib'], res['az_minor']),
                 "Lag size (major / minor): %.1f / %.1f" % (res['lags']['major'], res['lags']['minor']),
                 "",
                 "Model for the standardised variable (nugget 0, total sill 1):"]
        for k in range(m['nst']):
            lines.append("  %d) Spherical  sill %.3f   a_major %.1f   a_minor %.1f"
                         % (k + 1, m['cc'][k], m['ahmax'][k], m['ahmin'][k]))
        lines.append("")
        lines.append("Objective: %.4f (start %.4f)" % (res['fit']['final_obj'], res['fit']['start_obj']))
        # -- model -> tableWidget_models (ready to be used for kriging) -----------------
        normalized = (hasattr(self, 'checkBox_Normalize_by_variance')
                      and self.checkBox_Normalize_by_variance.isChecked())
        scale = 1.0 if normalized else res['variance']
        self._autovar_model_to_table(res, scale)
        lines.append("Model copied to the structure table (sills %s)." %
                     ("kept standardised (total sill 1)" if normalized else
                      "multiplied by the sample variance %.6g" % scale))
        save_files = hasattr(self, 'checkBox_saveAutovar') and self.checkBox_saveAutovar.isChecked()
        box = QtWidgets.QMessageBox(self)
        box.setWindowTitle("AutoVar")
        box.setIcon(QtWidgets.QMessageBox.Information)
        box.setText("\n".join(lines))
        box.setStandardButtons(QtWidgets.QMessageBox.Ok)
        box.exec_()
        if save_files:
            self._save_autovar_outputs(res, layer.name(), field_name)

    def _autovar_model_to_table(self, res, scale=1.0):
        """Replace the rows of tableWidget_models with the AutoVar model (spherical
        structures, r1 = range along the major axis, r2 = along the minor axis,
        a1 = azimuth of the major axis)."""
        m = res['model']
        az = res['az_major'] % 180.0
        tw = self.tableWidget_models
        tw.blockSignals(True)
        tw.setRowCount(0)

        def sb(val, max_val=1e9):
            w = QtWidgets.QDoubleSpinBox()
            w.setDecimals(4)
            w.setMinimum(-360.0 if max_val == 360 else 0.0)
            w.setMaximum(max_val)
            w.setValue(val)
            w.setSingleStep(1.0 if max_val == 360 else 10.0)
            return w

        widgets = []
        for k in range(m['nst']):
            row = tw.rowCount()
            tw.insertRow(row)
            combo = QtWidgets.QComboBox()
            combo.addItems(["Nugget", "Spherical", "Exponential", "Gaussian", "Linear", "Cubic"])
            combo.setCurrentText("Spherical")
            tw.setCellWidget(row, 0, combo)
            ws = [sb(float(m['cc'][k]) * scale), sb(float(m['ahmax'][k])), sb(float(m['ahmin'][k])),
                  sb(0.0), sb(az, 360), sb(0.0, 360), sb(0.0, 360)]
            for col, w in enumerate(ws, start=1):
                tw.setCellWidget(row, col, w)
            widgets.append((combo, ws))
        # connect the change signals only now, so that filling the table does not
        # trigger a re-plot of the old experimental variogram over the AutoVar plot
        for combo, ws in widgets:
            combo.currentIndexChanged.connect(self.on_plot_options_changed)
            for w in ws:
                w.valueChanged.connect(self.on_plot_options_changed)
        tw.blockSignals(False)
        self.variogram_computed = True

    def _save_autovar_outputs(self, res, layer_name, field_name):
        """Write the three text files produced by the Fortran AutoVar program."""
        try:
            from . import autovar_core as av
        except ImportError:
            import autovar_core as av
        folder = QtWidgets.QFileDialog.getExistingDirectory(self, "Folder for the AutoVar output files")
        if not folder:
            return
        base = re.sub(r"[^A-Za-z0-9_.-]+", "_", "%s_%s" % (layer_name, field_name))
        files = {
            "autovar_%s.out" % base: av.format_experimental(res),
            "autovarmod_%s.out" % base: av.format_model_points(res),
            "varfit_%s.out" % base: av.format_gslib_model(res),
        }
        try:
            for name, text in files.items():
                with open(os.path.join(folder, name), "w") as fh:
                    fh.write(text)
        except OSError as exc:
            QtWidgets.QMessageBox.critical(self, "AutoVar", "Cannot write the files:\n%s" % exc)
            return
        QtWidgets.QMessageBox.information(
            self, "AutoVar", "Saved in %s:\n%s" % (folder, "\n".join(files.keys())))

    def _plot_autovar(self, res, field_name=""):
        """Experimental variogram (1 - pseudo-correlogram) in the two principal directions
        and the spherical model fitted by AutoVar, drawn on the variogram canvas."""
        try:
            from . import autovar_core as av
        except ImportError:
            import autovar_core as av
        self.figure_vario.clear()
        ax = self.figure_vario.add_subplot(111)
        m = res['model']
        show_counts = hasattr(self, 'checkBox_show_counts') and self.checkBox_show_counts.isChecked()
        specs = [('exp_major', m['ahmax'], 'firebrick', res['az_major'], 'major'),
                 ('exp_minor', m['ahmin'], 'navy', res['az_minor'], 'minor')]
        hmax = max(float(res[k]['dist'].max()) for k, _, _, _, _ in specs) * 1.05
        hfine = np.linspace(0.0, hmax, 400)
        for key, rng, color, az, name in specs:
            e = res[key]
            used = e['wt'] > 0
            ax.plot(e['dist'], e['val'], linestyle=':', color=color, alpha=0.6)
            ax.plot(e['dist'][used], e['val'][used], linestyle='none', marker='o',
                    color=color, alpha=0.85, label="Azimuth %.1f\u00b0 (%s, Exp)" % (az, name))
            if (~used).any():
                ax.plot(e['dist'][~used], e['val'][~used], linestyle='none', marker='o',
                        markerfacecolor='none', color=color, alpha=0.85,
                        label="Azimuth %.1f\u00b0 (%s, not used in the fit)" % (az, name))
            ax.plot(hfine, av.model_gamma(hfine, m['cc'], rng), linestyle='-', linewidth=2.0,
                    color=color, alpha=0.9, label="Azimuth %.1f\u00b0 (%s, AutoVar model)" % (az, name))
            if show_counts:
                for d, v, n in zip(e['dist'], e['val'], e['num']):
                    ax.annotate(str(int(n)), (d, v), textcoords="offset points", xytext=(0, 6),
                                ha='center', fontsize=6, color=color)
        ax.axhline(1.0, color='gray', linestyle='--', linewidth=0.8, alpha=0.6)
        txt = "\n".join("%d) Sph  c=%.2f  a=%.0f / %.0f" % (k + 1, m['cc'][k], m['ahmax'][k], m['ahmin'][k])
                        for k in range(m['nst']))
        ax.text(0.99, 0.03, "AutoVar model (nugget 0, sill 1)\n" + txt, transform=ax.transAxes,
                ha='right', va='bottom', fontsize=7, family='monospace',
                bbox=dict(boxstyle='round', facecolor='white', alpha=0.8, edgecolor='lightgray'))
        ax.set_title("AutoVar \u2013 %s" % field_name if field_name else "AutoVar")
        ax.set_xlabel("Lag distance h")
        ax.set_ylabel("1 \u2212 \u03c1(h)  (pseudo-correlogram)")
        ax.grid(True, linestyle=':', alpha=0.6)
        ax.set_xlim(0, hmax)
        ax.set_ylim(bottom=0)
        ax.legend(loc='upper left', fontsize=7)
        self.figure_vario.tight_layout()
        self.canvas_vario.draw()

    def calculate_variogram(self):
        layer = self.mMapLayerComboBox.currentLayer()
        field_name = self.mFieldComboBox.currentField()
        if not layer or not field_name: return
        
        # Start of the timed section (reported in Computing_vrg_time). It covers
        # reading the data, the adaptive lag search and the pair loop, and it
        # stops before any plotting. No modal dialog is shown in between.
        t_vario_start = time.perf_counter()

        max_dist = self.doubleSpinBox_max_distance.value()
        num_lags = self.spinBox_num_lags.value()
        lag_size = self.doubleSpinBox_lag.value()  
        lag_tol = self.doubleSpinBox_lag_tolerance.value()
        num_dirs = self.spinBox_num_directions.value()
        ang_tol = self.doubleSpinBox_angular_tolerance.value()
        bandwidth = self.doubleSpinBox_bandwidth.value()
        base_azimuth = self.doubleSpinBox_azimuth.value()

        coords, values = [], []
        for f in layer.getFeatures():
            if f.hasGeometry():
                val = f[field_name]
                if val != NULL and val is not None:
                    try:
                        pt = f.geometry().asPoint()
                        coords.append([pt.x(), pt.y()])
                        values.append(float(val))
                    except (ValueError, TypeError): continue

        coords, values = np.array(coords), np.array(values)
        num_points = len(values)
        if num_points < 2: return
        sample_variance = float(np.var(values))

        # -- Optional declustering weights ----------------------------------------
        # If the user enabled checkBox_use_decluster_weights and the layer has
        # a 'decluster_weight' field (written by run_declustering), each pair
        # (i, j) is weighted by w_i * w_j -- the standard GSLIB convention --
        # instead of every pair counting equally.
        use_decluster = (hasattr(self, 'checkBox_use_decluster_weights')
                         and self.checkBox_use_decluster_weights.isChecked()
                         and "decluster_weight" in {f.name() for f in layer.fields()})
        if use_decluster:
            point_weights = []
            for f in layer.getFeatures():
                if f.hasGeometry():
                    val = f[field_name]
                    if val != NULL and val is not None:
                        try:
                            float(val)
                            w = f["decluster_weight"]
                            point_weights.append(float(w) if w not in (None, NULL) else 1.0)
                        except (ValueError, TypeError):
                            continue
            point_weights = np.array(point_weights)
            if len(point_weights) != num_points:
                # Safety fallback: if collection got out of sync for any
                # reason, do not silently apply mismatched weights.
                use_decluster = False
                point_weights = np.ones(num_points)
        else:
            point_weights = np.ones(num_points)

        # -- AutoVar-style adaptive lag spacing -----------------------------------
        # When enabled, the lag size, tolerance, and number of lags are
        # derived from the actual nearest-neighbor spacing of the data
        # (replicating the datspac_horz algorithm from the AutoVar Fortran
        # project) instead of being read as fixed values from the spinboxes.
        if hasattr(self, 'radioButton_adaptive_lag') and self.radioButton_adaptive_lag.isChecked():
            avg_min, avg_avg, avg_max = self._autovar_adaptive_lag(coords)
            if avg_avg > 0:
                lag_size = avg_avg
                lag_tol  = lag_size / 2.0
                num_lags = max(1, int(max_dist / lag_size) + 1)
                # Reflect the computed values back into the spinboxes so the
                # user can see exactly what was used (and so the variogram
                # map / other tools that read these spinboxes stay in sync).
                self.doubleSpinBox_lag.blockSignals(True)
                self.doubleSpinBox_lag_tolerance.blockSignals(True)
                self.spinBox_num_lags.blockSignals(True)
                self.doubleSpinBox_lag.setValue(lag_size)
                self.doubleSpinBox_lag_tolerance.setValue(lag_tol)
                self.spinBox_num_lags.setValue(num_lags)
                self.doubleSpinBox_lag.blockSignals(False)
                self.doubleSpinBox_lag_tolerance.blockSignals(False)
                self.spinBox_num_lags.blockSignals(False)

        self.progressBar_vario.setValue(0)
        # GSLIB/AutoVar bin convention: centers at h = 0, lag, 2*lag, ...
        # (NOT lag/2, 3*lag/2, ... as a naive "midpoint of [0,lag]" reading
        # might suggest). Each bin k>=1 has tolerance lag_size/2 on either
        # side of k*lag_size; bin 0 only has the upper half (it cannot
        # extend to negative distances), so its effective tolerance is
        # lag_size/2 on the high side only. With num_lags=1, the only bin
        # is centered at h=0 -- to see a point further out, increase
        # num_lags so a bin centered at h=lag_size is also computed.
        lag_centers = np.arange(num_lags) * lag_size
        # Per-bin tolerance: lag_size/2 everywhere, except bin 0 which uses
        # lag_size/2 as well but is implicitly one-sided (handled by the
        # abs(dist - center) <= lag_tol check below, since dist >= 0 always
        # means the "lower half" of bin 0's nominal window is never reached).
        lag_tol = lag_size / 2.0
        # The tolerance is always derived from lag_size in this convention
        # (matching GSLIB/AutoVar's use of IDNINT for bin assignment, which
        # is mathematically equivalent to a +/- lag/2 window). Reflect that
        # back into the spinbox and disable manual editing, so the value
        # shown is never stale or misleading.
        self.doubleSpinBox_lag_tolerance.blockSignals(True)
        self.doubleSpinBox_lag_tolerance.setValue(lag_tol)
        self.doubleSpinBox_lag_tolerance.blockSignals(False)
        # Disable manual editing only in adaptive mode: lag_tol is always
        # lag/2 and is derived automatically. In fixed mode the user can
        # set any tolerance they like.
        is_adaptive = (hasattr(self, 'radioButton_adaptive_lag') and
                       self.radioButton_adaptive_lag.isChecked())
        self.doubleSpinBox_lag_tolerance.setEnabled(not is_adaptive)
        azimuths = [(base_azimuth + d * (180.0 / num_dirs)) % 180.0 for d in range(num_dirs)]

        # Largest separation that can still fall into a bin. The last bin is
        # centered at (num_lags - 1) * lag, which equals the MaxDistance spinbox,
        # and it accepts pairs up to centre + lag_tol. Cutting the pair search at
        # MaxDistance itself would keep only the lower half of that last bin
        # (about half of its pairs, and a biased gamma), unlike GSLIB/SGeMS.
        dist_limit = max(max_dist, lag_centers[-1] + lag_tol)

        # -- Optional behaviors -----------------------------------------------
        # checkBox_Normalize_by_variance: divide gamma(h) by the global
        # sample variance, so the sill tends to 1 (relative variogram),
        # useful for comparing variables/datasets on the same scale.
        normalize_by_variance = (hasattr(self, 'checkBox_Normalize_by_variance')
                                 and self.checkBox_Normalize_by_variance.isChecked())

        # use_effective_distance: AutoVar-style behavior -- plot/report each
        # bin at the actual mean distance of the pairs that fell into it,
        # rather than at the bin's theoretical center. This average can
        # legitimately differ from one direction to another, and between
        # bins, depending on how pairs are actually distributed in space.
        use_effective_distance = (hasattr(self, 'checkBox_effective_distance')
                                  and self.checkBox_effective_distance.isChecked())

        variogram_results = self._compute_directional_variogram(
            coords, values, point_weights, lag_centers, lag_tol, dist_limit,
            azimuths, ang_tol, bandwidth, normalize_by_variance, sample_variance,
            use_effective_distance, progress_cb=self.progressBar_vario.setValue)

        self.progressBar_vario.setValue(100)

        # End of the timed section: show the elapsed time to the user.
        self.last_variogram_time_s = time.perf_counter() - t_vario_start
        self.Computing_vrg_time.setText(
            "Computing time: " + self._format_elapsed_time(self.last_variogram_time_s))

        self.last_lags, self.last_results = lag_centers, variogram_results
        # Remember whether gamma(h) was divided by the sample variance: the autofit must
        # know the scale of the cached experimental values, whatever the state of the
        # checkbox is when the autofit is launched.
        self.last_variogram_normalized = bool(normalize_by_variance and sample_variance > 0)
        self.last_layer_id, self.last_field_name = layer.id(), field_name
        self.variogram_computed = True # Set flag to true as experimental calculation succeeded
        
        self.plot_multi_variogram(lag_centers, variogram_results)
        self.update_fit_error()

    def _compute_directional_variogram(self, coords, values, point_weights, lag_centers,
                                       lag_tol, dist_limit, azimuths, ang_tol, bandwidth,
                                       normalize_by_variance, sample_variance,
                                       use_effective_distance, progress_cb=None):
        """Pair search and estimator of the directional experimental variogram.

        This is the computational core of calculate_variogram(), kept separate
        so that the benchmark of the Benchmark tab runs exactly the same code.
        It does not read or write any widget: progress_cb(percent), if given,
        is called while the pairs are scanned.

        Returns {azimuth: (gamma, pair_counts, gamma_values, h_effective, pair_dists)}.
        """
        num_dirs = len(azimuths)
        num_points = len(values)
        num_lags = len(lag_centers)
        ang_tol_rad = np.radians(ang_tol)
        variogram_results = {}
        total_steps = num_dirs * num_points
        step_count = 0

        for az in azimuths:
            gamma_values = [[] for _ in range(num_lags)]
            pair_weights = [[] for _ in range(num_lags)]
            pair_dists   = [[] for _ in range(num_lags)]
            azimuth_rad = np.radians(90.0 - az)
            u_x, u_y = np.cos(azimuth_rad), np.sin(azimuth_rad)

            for i in range(num_points):
                step_count += 1
                if i % 10 == 0:
                    if progress_cb is not None:
                        progress_cb(int((step_count / total_steps) * 100))
                    QtWidgets.QApplication.processEvents()

                for j in range(i + 1, num_points):
                    dx, dy = coords[j][0] - coords[i][0], coords[j][1] - coords[i][1]
                    dist = np.sqrt(dx**2 + dy**2)
                    if dist > dist_limit or dist == 0: continue

                    cos_alpha = np.clip((dx * u_x + dy * u_y) / dist, -1.0, 1.0)
                    alpha = np.arccos(np.abs(cos_alpha))
                    if alpha > ang_tol_rad: continue
                    if bandwidth > 0 and dist * np.sin(alpha) > bandwidth: continue

                    for k, center in enumerate(lag_centers):
                        if np.abs(dist - center) <= lag_tol:
                            gamma_values[k].append(0.5 * ((values[i] - values[j]) ** 2))
                            # GSLIB convention: pair weight = w_i * w_j. With
                            # no declustering, point_weights are all 1, so
                            # this is equivalent to an unweighted pair.
                            pair_weights[k].append(point_weights[i] * point_weights[j])
                            pair_dists[k].append(dist)

            experimental_gamma = np.zeros(num_lags)
            pair_counts = np.zeros(num_lags)
            # Effective mean distance per bin (AutoVar-style): the actual
            # average separation of the pairs that fell into this lag bin,
            # rather than the bin's theoretical center. With lag=1000 and
            # tolerance=500, a bin nominally spanning 0-1000 (center h=500)
            # may in practice contain pairs averaging closer to, say, 420 or
            # 480, depending on the real spatial distribution -- and this
            # average can differ from one direction to another, since each
            # direction's pairs are not evenly spread across the bin either.
            h_effective = np.copy(lag_centers)
            for k in range(num_lags):
                vals = gamma_values[k]
                wts = pair_weights[k]
                dists = pair_dists[k]
                pair_counts[k] = len(vals)  # raw pair count, used for plotting/coloring
                if len(vals) > 0:
                    wts_arr = np.array(wts)
                    w_sum = np.sum(wts_arr)
                    experimental_gamma[k] = (np.sum(wts_arr * np.array(vals)) / w_sum
                                            if w_sum > 0 else np.mean(vals))
                    if use_effective_distance:
                        h_effective[k] = np.mean(dists)
                else:
                    experimental_gamma[k] = np.nan

            # Optional normalization by the global sample variance (sill =
            # 1 convention), so different variables/datasets can be
            # compared on the same relative vertical scale.
            if normalize_by_variance and sample_variance > 0:
                experimental_gamma = experimental_gamma / sample_variance

            variogram_results[az] = (experimental_gamma, pair_counts, gamma_values, h_effective, pair_dists)
        return variogram_results

    # =========================================================================
    # Benchmark tab: computing time of the experimental variogram vs. layer size
    # =========================================================================

    _BENCH_VRG_DIRECTIONS = (1, 2, 4)   # numbers of directions that are timed
    _BENCH_VRG_NUM_LAGS = 11            # lags 0, h, ..., 10 h with 10 h = field size

    def _update_hardware_info(self, *_):
        """Write in plainTextEdit_hardware the description of the machine."""
        try:
            text = hardware_description()
        except Exception as e:
            text = 'Hardware description not available (%s).' % e
        self.plainTextEdit_hardware.setPlainText(text)

    def _setup_benchmark_vrg_table(self):
        """Create the model of tableBenchmarkresults_vrg and write its header."""
        self._bench_vrg_model = QtGui.QStandardItemModel(0, 5, self)
        self._bench_vrg_model.setHorizontalHeaderLabels([
            "Layer", "N. points", "Time 1 dir (s)", "Time 2 dir (s)", "Time 4 dir (s)"])
        self._bench_krig_model = QtGui.QStandardItemModel(0, 5, self)
        self._bench_krig_model.setHorizontalHeaderLabels([
            "Test", "nx", "ny", "N. nodes (nx x ny)", "Time (s)"])
        self._bench_opt_model = QtGui.QStandardItemModel(0, 5, self)
        self._bench_opt_model.setHorizontalHeaderLabels([
            "Starting points", "Min SSE", "Max SSE", "Mean SSE", "Valid runs"])
        self.tableBenchmarkresults_vrg.horizontalHeader().setStretchLastSection(True)
        self._set_bench_mode('vrg')

    def _set_bench_mode(self, mode):
        """Show the variogram ('vrg'), kriging ('krig') or neighbourhood optimisation ('opt')
        benchmark in the shared table."""
        self._bench_mode = mode
        self.tableBenchmarkresults_vrg.setModel(
            {'krig': self._bench_krig_model,
             'opt': self._bench_opt_model}.get(mode, self._bench_vrg_model))

    def _benchmark_vrg_add_row(self, name, n_points, times):
        items = [QtGui.QStandardItem(name), QtGui.QStandardItem(str(n_points))]
        items += [QtGui.QStandardItem("%.3f" % t) for t in times]
        for it in items:
            it.setEditable(False)
        self._bench_vrg_model.appendRow(items)
        self.tableBenchmarkresults_vrg.resizeColumnsToContents()
        self.tableBenchmarkresults_vrg.scrollToBottom()

    def _create_benchmark_layer(self, name, n_points, field_size, seed):
        """Memory point layer with n_points random points in [0, field_size]^2 and a
        random field z_rnd in [0, 1]. The seed is fixed, so that the layers (and the
        variograms) can be reproduced."""
        rng = np.random.default_rng(seed)
        xs = rng.uniform(0.0, field_size, n_points)
        ys = rng.uniform(0.0, field_size, n_points)
        zs = rng.uniform(0.0, 1.0, n_points)

        layer = QgsVectorLayer("Point?crs=EPSG:3857", name, "memory")
        pr = layer.dataProvider()
        pr.addAttributes([QgsField("z_rnd", QVariant.Double)])
        layer.updateFields()
        feats = []
        for x, y, z in zip(xs, ys, zs):
            f = QgsFeature(layer.fields())
            f.setGeometry(QgsGeometry.fromPointXY(QgsPointXY(float(x), float(y))))
            f.setAttributes([float(z)])
            feats.append(f)
        pr.addFeatures(feats)
        layer.updateExtents()
        QgsProject.instance().addMapLayer(layer)
        return layer

    def run_benchmark_variogram(self):
        """Computing time of the experimental variogram as a function of the number of points.

        For k = 1 ... Exponent (SpinBox_exponent) a memory layer benchmark_kk is created, with
        Base**k random points (x, y uniform in [0, Field size], z_rnd uniform in
        [0, 1]). On every layer the experimental variogram is computed with 11 lags
        (centres 0, h, ..., 10 h, with 10 h = Field size), for 1, 2 and 4 directions,
        by the same routine used by the Variogram tab (_compute_directional_variogram).
        The other parameters are fixed: first azimuth 0, angular tolerance
        90/number_of_directions, no bandwidth, no weights, no normalisation, h not
        corrected. The time is that of the pair search and of the estimator; the
        reading of the points of the layer (linear in N) and the plotting are not included.
        If checkBox_removelayers is checked, every layer is removed from the project as
        soon as its three variograms have been computed.
        """
        field_size = self.doubleSpinBox_fieldsize.value()
        base = self.doubleSpinBox_base.value()
        n_layers = int(self.SpinBox_exponent.value())
        if n_layers < 1 or base < 1.0 or field_size <= 0:
            QtWidgets.QMessageBox.warning(
                self, "Benchmark", "Please check Field size, Base and Exponent.")
            return
        sizes = [max(2, int(round(base ** k))) for k in range(1, n_layers + 1)]

        num_lags = self._BENCH_VRG_NUM_LAGS
        lag_size = field_size / (num_lags - 1)
        lag_tol = lag_size / 2.0
        lag_centers = np.arange(num_lags) * lag_size
        # same rule as calculate_variogram: the last lag is complete
        dist_limit = max(field_size, lag_centers[-1] + lag_tol)

        # new run: clear the previous results
        self._set_bench_mode('vrg')
        self.last_benchmark_vrg = []
        self._bench_vrg_model.removeRows(0, self._bench_vrg_model.rowCount())
        self.progressBar_bench_vrg.setValue(0)
        self.pushButtonBenchVrg.setEnabled(False)
        total_runs = len(sizes) * len(self._BENCH_VRG_DIRECTIONS)
        run_index = 0

        try:
            for k, n_points in enumerate(sizes, start=1):
                name = self._unique_layer_name("benchmark_%02d" % k)
                layer = self._create_benchmark_layer(name, n_points, field_size, seed=1000 + k)

                # read the points back from the layer, as calculate_variogram does
                coords, values = [], []
                for f in layer.getFeatures():
                    pt = f.geometry().asPoint()
                    coords.append([pt.x(), pt.y()])
                    values.append(float(f["z_rnd"]))
                coords, values = np.array(coords), np.array(values)
                point_weights = np.ones(len(values))
                sample_variance = float(np.var(values))

                times = []
                for nd in self._BENCH_VRG_DIRECTIONS:
                    azimuths = [(0.0 + d * (180.0 / nd)) % 180.0 for d in range(nd)]
                    ang_tol = 90.0 / nd

                    def progress(pct, _r=run_index):
                        self.progressBar_bench_vrg.setValue(
                            int(100.0 * (_r + pct / 100.0) / total_runs))

                    t0 = time.perf_counter()
                    self._compute_directional_variogram(
                        coords, values, point_weights, lag_centers, lag_tol, dist_limit,
                        azimuths, ang_tol, 0.0, False, sample_variance, False,
                        progress_cb=progress)
                    times.append(time.perf_counter() - t0)
                    run_index += 1
                    self.progressBar_bench_vrg.setValue(int(100.0 * run_index / total_runs))

                self.last_benchmark_vrg.append((name, len(values), times[0], times[1], times[2]))
                self._benchmark_vrg_add_row(name, len(values), times)
                self._plot_benchmark_variogram()
                if self.checkBox_removelayers.isChecked():
                    QgsProject.instance().removeMapLayer(layer.id())
                QtWidgets.QApplication.processEvents()
        finally:
            self.pushButtonBenchVrg.setEnabled(True)

        self.progressBar_bench_vrg.setValue(100)

    def _plot_benchmark_variogram(self):
        """Computing time (y) vs number of points (x), one series per number of directions.
        Both axes are logarithmic, since N grows geometrically and the time as ~N^2."""
        self.figure_bench_vrg.clear()
        ax = self.figure_bench_vrg.add_subplot(111)
        rows = self.last_benchmark_vrg
        if rows:
            n = [r[1] for r in rows]
            for col, label, color in ((2, "1 direction", "firebrick"),
                                      (3, "2 directions", "navy"),
                                      (4, "4 directions", "forestgreen")):
                ax.plot(n, [r[col] for r in rows], marker='o', label=label, color=color)
            ax.set_xscale('log')
            ax.set_yscale('log')
            ax.legend()
        ax.set_xlabel("Number of points")
        ax.set_ylabel("Computing time (s)")
        ax.set_title("Experimental variogram: computing time (11 lags)")
        ax.grid(True, which='both', alpha=0.3)
        self.figure_bench_vrg.tight_layout()
        self.canvas_bench_vrg.draw()

    def export_benchmark_vrg_to_csv(self):
        """Export the table of the Benchmark tab (variogram, kriging or optimisation, whichever is shown)."""
        mode = self._bench_mode
        rows = {'krig': self.last_benchmark_krig,
                'opt': self.last_benchmark_opt}.get(mode, self.last_benchmark_vrg)
        kind = {'krig': 'kriging', 'opt': 'neighbourhood_optimisation'}.get(mode, 'variogram')
        if not rows:
            QtWidgets.QMessageBox.warning(
                self, "Export benchmark",
                "No benchmark results yet.\nPlease run the benchmark first.")
            return
        import datetime
        timestamp = datetime.datetime.now().strftime('%Y_%m_%d_%H_%M_%S')
        settings = QSettings()
        last_dir = settings.value('GeostatisticsLab/export_dir', os.path.expanduser('~'))
        file_path, _ = QtWidgets.QFileDialog.getSaveFileName(
            self, "Export benchmark to CSV",
            os.path.join(last_dir, "%s_benchmark_%s.csv" % (timestamp, kind)),
            "CSV files (*.csv);;All files (*.*)")
        if not file_path:
            return
        if not file_path.lower().endswith('.csv'):
            file_path += '.csv'
        settings.setValue('GeostatisticsLab/export_dir', os.path.dirname(file_path))
        try:
            with open(file_path, 'w', newline='', encoding='utf-8') as fh:
                writer = csv.writer(fh)
                if mode == 'opt':
                    writer.writerow(['starting_points', 'min_sse', 'max_sse', 'mean_sse',
                                     'valid_runs', 'runs'])
                    for n_start, s_min, s_max, s_mean, n_valid, n_runs in rows:
                        writer.writerow([n_start, '%.10g' % s_min, '%.10g' % s_max,
                                         '%.10g' % s_mean, n_valid, n_runs])
                else:
                    if mode == 'krig':
                        writer.writerow(['test', 'nx', 'ny', 'num_nodes', 'time_s'])
                    else:
                        writer.writerow(['layer', 'num_points', 'time_1_direction_s',
                                         'time_2_directions_s', 'time_4_directions_s'])
                    for row in rows:
                        if mode == 'krig':
                            # row = (test, n_nodes, time_s, nx, ny)
                            writer.writerow([row[0], row[3], row[4], row[1], '%.6f' % row[2]])
                        else:
                            writer.writerow([row[0], row[1]] + ['%.6f' % x for x in row[2:]])
            QtWidgets.QMessageBox.information(
                self, "Export benchmark",
                "Benchmark exported successfully:\n%s\n(%d rows)"
                % (file_path, len(rows)))
        except Exception as e:
            QtWidgets.QMessageBox.critical(
                self, "Export benchmark", "Failed to save the CSV file:\n%s" % str(e))

    def export_benchmark_vrg_to_png(self):
        """Export the plot of the Benchmark tab to a PNG file."""
        mode = self._bench_mode
        kind = {'krig': 'kriging', 'opt': 'neighbourhood_optimisation'}.get(mode, 'variogram')
        if not {'krig': self.last_benchmark_krig,
                'opt': self.last_benchmark_opt}.get(mode, self.last_benchmark_vrg):
            QtWidgets.QMessageBox.warning(
                self, "Export benchmark",
                "No benchmark results yet.\nPlease run the benchmark first.")
            return
        dpi, ok = QtWidgets.QInputDialog.getInt(
            self, "Export resolution", "Output resolution (DPI):",
            value=300, min=72, max=1200, step=50)
        if not ok:
            return
        import datetime
        timestamp = datetime.datetime.now().strftime('%Y_%m_%d_%H_%M_%S')
        settings = QSettings()
        last_dir = settings.value('GeostatisticsLab/export_dir', os.path.expanduser('~'))
        file_path, _ = QtWidgets.QFileDialog.getSaveFileName(
            self, "Export benchmark plot to PNG",
            os.path.join(last_dir, "%s_benchmark_%s.png" % (timestamp, kind)),
            "PNG images (*.png);;All files (*.*)")
        if not file_path:
            return
        if not file_path.lower().endswith('.png'):
            file_path += '.png'
        settings.setValue('GeostatisticsLab/export_dir', os.path.dirname(file_path))
        try:
            # The canvas is usually wide and low: export with a normal figure shape
            # (the on-screen size is restored afterwards).
            fig = self.figure_bench_vrg
            old_size = fig.get_size_inches().copy()
            try:
                fig.set_size_inches(6.5, 4.0)
                fig.tight_layout()
                fig.savefig(file_path, dpi=dpi, bbox_inches='tight',
                            facecolor=fig.get_facecolor())
            finally:
                fig.set_size_inches(old_size)
                fig.tight_layout()
                self.canvas_bench_vrg.draw()
            QtWidgets.QMessageBox.information(
                self, "Export benchmark",
                "Plot exported successfully:\n%s\n(DPI: %d)" % (file_path, dpi))
        except Exception as e:
            QtWidgets.QMessageBox.critical(
                self, "Export benchmark", "Failed to save the image:\n%s" % str(e))

    # -------------------------------------------------------------------------
    # Benchmark tab: computing time of the kriging vs. number of estimation nodes
    # -------------------------------------------------------------------------

    def _benchmark_krig_add_row(self, name, n_nodes, seconds, nx, ny):
        items = [QtGui.QStandardItem(name), QtGui.QStandardItem(str(nx)),
                 QtGui.QStandardItem(str(ny)), QtGui.QStandardItem(str(n_nodes)),
                 QtGui.QStandardItem("%.3f" % seconds)]
        for it in items:
            it.setEditable(False)
        self._bench_krig_model.appendRow(items)
        self.tableBenchmarkresults_vrg.resizeColumnsToContents()
        self.tableBenchmarkresults_vrg.scrollToBottom()

    def _plot_benchmark_kriging(self, label=""):
        """Computing time (y) vs number of estimated nodes (x), log-log."""
        self.figure_bench_vrg.clear()
        ax = self.figure_bench_vrg.add_subplot(111)
        rows = self.last_benchmark_krig
        if rows:
            ax.plot([r[1] for r in rows], [r[2] for r in rows], marker='o',
                    color='firebrick', label=label or "kriging")
            ax.set_xscale('log')
            ax.set_yscale('log')
            # plain-text tick labels also when the range is shorter than a decade
            from matplotlib.ticker import LogFormatter
            for axis in (ax.xaxis, ax.yaxis):
                axis.set_major_formatter(LogFormatter())
                axis.set_minor_formatter(LogFormatter())
            ax.legend()
        ax.set_xlabel("Number of estimated nodes (nx x ny)")
        ax.set_ylabel("Computing time (s)")
        ax.set_title("Kriging: computing time")
        ax.grid(True, which='both', alpha=0.3)
        self.figure_bench_vrg.tight_layout()
        self.canvas_bench_vrg.draw()

    @staticmethod
    def _add_vsimem_raster(name, array, xmin, ymin, Nx, Ny, dx, dy, crs_wkt, tag):
        """Add a float32 array to the project as a raster layer that lives only in
        memory (GDAL /vsimem/ GeoTIFF, nothing is written to disk). Returns
        (layer or None, vsimem path)."""
        from osgeo import gdal, osr
        path = "/vsimem/geostatlab_bench_%s.tif" % tag
        ds = gdal.GetDriverByName('GTiff').Create(path, Nx, Ny, 1, gdal.GDT_Float32)
        ds.SetGeoTransform((xmin, dx, 0.0, ymin + Ny * dy, 0.0, -dy))
        if crs_wkt:
            srs = osr.SpatialReference()
            srs.ImportFromWkt(crs_wkt)
            ds.SetProjection(srs.ExportToWkt())
        band = ds.GetRasterBand(1)
        band.WriteArray(array)
        band.FlushCache()
        ds = None
        layer = QgsRasterLayer(path, name)
        if layer.isValid():
            QgsProject.instance().addMapLayer(layer)
            return layer, path
        return None, path

    def run_kriging_benchmark(self):
        """Computing time of the kriging as a function of the number of estimated nodes.

        Uses the data layer/field, the kriging type, the search neighbourhood and
        the variogram model currently set in the GUI. The grid of the Kriging tab is
        the reference (test 1). In test k the extent is the same, while Nx and Ny are
        multiplied by k (dx, dy divided by k), so the number of nodes grows as k^2.
        The number of tests is spinBox_n_krigin_tests. The timed section is the
        estimation of the grid (the same code as the Calculate button, _krige_grid);
        building the raster layers is not included. Rasters kriging_kk and
        kriging_kk_var are added to the project as in-memory GDAL rasters (no file);
        if remove_layers_krige_bm is checked they are all removed at the end.
        """
        # 1. variogram model must exist
        structures = self.get_models_from_table()
        if not structures or not self.variogram_computed:
            QtWidgets.QMessageBox.warning(
                self, "Kriging benchmark",
                "No variogram model is defined.\n"
                "Compute the experimental variogram and fit (or enter) a model in the "
                "Variogram tab, then run the benchmark again.")
            self.tabWidget.setCurrentIndex(1)
            return
        try:
            from osgeo import gdal  # noqa: F401
        except ImportError:
            QtWidgets.QMessageBox.critical(
                self, "Kriging benchmark", "GDAL library not available in QGIS environment.")
            return

        # 2. data
        layer = self.mMapLayerComboBox.currentLayer()
        field_name = self.mFieldComboBox.currentField()
        if not layer or not field_name:
            QtWidgets.QMessageBox.critical(self, "Kriging benchmark",
                                           "Invalid point layer or field chosen.")
            return
        coords, values = [], []
        for f in layer.getFeatures():
            if f.hasGeometry():
                val = f[field_name]
                if val != NULL and val is not None:
                    try:
                        pt = f.geometry().asPoint()
                        coords.append([pt.x(), pt.y()])
                        values.append(float(val))
                    except (ValueError, TypeError):
                        continue
        coords, values = np.array(coords), np.array(values)
        if len(values) >= 1:
            # duplicated locations make the kriging matrix singular: keep the first one
            _, first_idx = np.unique(np.round(coords, decimals=6), axis=0, return_index=True)
            first_idx = np.sort(first_idx)
            coords, values = coords[first_idx], values[first_idx]
        if len(values) < 3:
            QtWidgets.QMessageBox.critical(self, "Kriging benchmark",
                                           "Kriging requires at least 3 points.")
            return
        X_known, Y_known = coords[:, 0], coords[:, 1]

        # 3. parameters from the GUI
        xmin, ymin = self.doubleSpinBox_xmin.value(), self.doubleSpinBox_ymin.value()
        Nx, Ny = self.spinBox_Nx.value(), self.spinBox_Ny.value()
        dx, dy = self.doubleSpinBox_dx.value(), self.doubleSpinBox_dy.value()
        if Nx < 1 or Ny < 1 or dx <= 0 or dy <= 0:
            QtWidgets.QMessageBox.warning(
                self, "Kriging benchmark", "Please check the estimation grid (Nx, Ny, dx, dy).")
            return
        search_r_max = self.doubleSpinBox_searchR_max.value()
        search_r_min = self.doubleSpinBox_searchR_min.value()
        search_azimuth = self.doubleSpinBox_search_azimuth.value()
        if search_r_max <= 0:
            QtWidgets.QMessageBox.warning(
                self, "Kriging benchmark",
                "Range max of the search neighbourhood must be greater than zero.")
            return
        use_octants = self.checkBox_octant_search.isChecked()
        min_per_octant = self.spinBox_min_point_per_octant.value()
        pts_min = self.spinBox_kriging_num_points_min.value()
        pts_max = self.spinBox_kriging_num_points_max.value()
        NO_VALUE = (float(self.doubleSpinBox_nodata_value.value())
                    if hasattr(self, "doubleSpinBox_nodata_value") else -9999.0)
        is_ok = self.radioButton_OrdinaryKriging.isChecked()
        is_uk = self.radioButton_UniversalKriging.isChecked()
        type_name = "Ordinary" if is_ok else ("Universal" if is_uk else "Simple")
        mean_value = self.doubleSpinBox_mean_sk.value()
        n_tests = int(self.spinBox_n_krigin_tests.value())
        crs_wkt = layer.crs().toWkt() if layer.crs().isValid() else None

        # new run: clear the previous kriging results
        self._set_bench_mode('krig')
        self.last_benchmark_krig = []
        self._bench_krig_model.removeRows(0, self._bench_krig_model.rowCount())
        self.progressBar_krige_test.setValue(0)
        self.pushButtonKriginBenchmark.setEnabled(False)
        created = []        # (layer or None, vsimem path)
        failed_layers = 0
        plot_label = "%s kriging, %d data" % (type_name, len(values))

        try:
            import uuid
            for k in range(1, n_tests + 1):
                Nx_k, Ny_k = Nx * k, Ny * k
                dx_k, dy_k = dx / k, dy / k

                def progress(pct, _k=k):
                    self.progressBar_krige_test.setValue(
                        int(100.0 * (_k - 1 + pct / 100.0) / n_tests))

                t0 = time.perf_counter()
                raster, variance = self._krige_grid(
                    X_known, Y_known, values, structures, xmin, ymin, Nx_k, Ny_k, dx_k, dy_k,
                    is_ok, is_uk, search_r_max, search_r_min, search_azimuth,
                    use_octants, min_per_octant, pts_min, pts_max,
                    mean_value, NO_VALUE, progress)
                elapsed = time.perf_counter() - t0

                name = "kriging_%02d" % k
                n_nodes = Nx_k * Ny_k
                self.last_benchmark_krig.append((name, n_nodes, elapsed, Nx_k, Ny_k))
                self._benchmark_krig_add_row(name, n_nodes, elapsed, Nx_k, Ny_k)
                self._plot_benchmark_kriging(plot_label)

                # rasters in memory (outside the timed section)
                for suffix, arr in (("", raster), ("_var", variance)):
                    lyr, path = self._add_vsimem_raster(
                        self._unique_layer_name(name + suffix), arr, xmin, ymin,
                        Nx_k, Ny_k, dx_k, dy_k, crs_wkt, uuid.uuid4().hex)
                    created.append((lyr, path))
                    if lyr is None:
                        failed_layers += 1
                self.progressBar_krige_test.setValue(int(100.0 * k / n_tests))
                QtWidgets.QApplication.processEvents()
        finally:
            self.pushButtonKriginBenchmark.setEnabled(True)
            if self.remove_layers_krige_bm.isChecked():
                from osgeo import gdal
                for lyr, path in created:
                    if lyr is not None:
                        QgsProject.instance().removeMapLayer(lyr.id())
                    gdal.Unlink(path)
            self._populate_raster_combo()

        self.progressBar_krige_test.setValue(100)
        if failed_layers:
            QtWidgets.QMessageBox.warning(
                self, "Kriging benchmark",
                "%d raster(s) could not be loaded in QGIS. The timings are not affected."
                % failed_layers)


    # -------------------------------------------------------------------------
    # Benchmark tab: neighbourhood optimisation vs number of starting points
    # -------------------------------------------------------------------------

    def _plot_benchmark_opt(self):
        """Min, mean and max over the repeated runs of the cross-validation SSE of the
        best solution, as a function of the number of starting points."""
        self.figure_bench_vrg.clear()
        ax = self.figure_bench_vrg.add_subplot(111)
        rows = [r for r in self.last_benchmark_opt if r[4] > 0]
        from matplotlib.ticker import FuncFormatter, NullFormatter
        exp10, scale = 0, 1.0
        if rows:
            top = max(abs(v) for r in rows for v in (r[1], r[2], r[3]) if v == v)
            if top > 0:
                exp10 = int(np.floor(np.log10(top)))
                scale = 10.0 ** exp10
            x = [r[0] for r in rows]
            mn = [r[1] for r in rows]       # SSE min / max / mean over the runs
            mx = [r[2] for r in rows]
            mean = [r[3] for r in rows]
            ax.fill_between(x, mn, mx, color='0.5', alpha=0.15, linewidth=0)
            ax.plot(x, mx, color='firebrick', marker='o', ms=3, label='max')
            ax.plot(x, mean, color='navy', marker='o', ms=3, label='mean')
            ax.plot(x, mn, color='forestgreen', marker='o', ms=3, label='min')
            if x[-1] / max(x[0], 1) >= 20:
                ax.set_xscale('log')
                ax.xaxis.set_major_formatter(FuncFormatter(lambda v, _: "%g" % v))
                ax.xaxis.set_minor_formatter(NullFormatter())
            ax.legend(loc='upper right', ncol=3, fontsize='small', frameon=False)
            # SSE in units of a power of ten (shown in the axis label) instead of the
            # matplotlib offset text, which ends up on top of the title
            ax.yaxis.set_major_formatter(FuncFormatter(lambda v, _: "%g" % (v / scale)))
        ax.set_xlabel("Starting points")
        ax.set_ylabel("CV SSE (\u00d710$^{%d}$)" % exp10 if rows else "CV SSE")
        ax.set_title("Search optimisation (%d runs)" % self._opt_bench_runs, fontsize='medium')
        ax.grid(True, which='both', alpha=0.3)
        self.figure_bench_vrg.tight_layout()
        self.canvas_bench_vrg.draw()

    def _benchmark_opt_add_row(self, n_start, sse_min, sse_max, sse_mean, n_valid, n_runs):
        def f(v):
            return "n/a" if v != v else "%.6g" % v
        items = [QtGui.QStandardItem(str(n_start)),
                 QtGui.QStandardItem(f(sse_min)), QtGui.QStandardItem(f(sse_max)),
                 QtGui.QStandardItem(f(sse_mean)),
                 QtGui.QStandardItem("%d/%d" % (n_valid, n_runs))]
        for it in items:
            it.setEditable(False)
        self._bench_opt_model.appendRow(items)
        self.tableBenchmarkresults_vrg.resizeColumnsToContents()
        self.tableBenchmarkresults_vrg.scrollToBottom()

    def run_opt_benchmark(self):
        """How many starting points does the neighbourhood optimisation need?

        For n = spinBoxmin_iter, spinBoxmin_iter + spinBox_step, ... up to
        spinBox_optimiz_starting_point (n = 1, 2, ... if the two spin boxes are 1) the
        Latin Hypercube search of
        run_ck_neighborhood_optimization (same parameters, same bounds, same kriging
        type and variogram model, set in the GUI) is repeated spinBox_n_tentative
        times with n starting points. Every run gives the cross-validation SSE (sum of the
        squared leave-one-out errors) of its best solution; the minimum, the maximum and
        the mean of the SSE over the runs are written in the table and plotted against n.
        A run whose
        trials all leave some point unestimated has no valid solution and is not counted
        (column "Valid runs").
        The seed of run r with n starting points is derived from lineEdit_seed_opt, n
        and r, so the whole benchmark is repeatable and independent of the range of n.
        The warm start (current parameters) is not used, so that only the Latin Hypercube
        sample is evaluated; the GUI parameters are never modified. While the benchmark is
        running the button becomes "Stop": the rows already computed are kept.
        """
        import random
        if self._opt_bench_running:
            self._opt_bench_stop = True
            self.pushButton_opt_bench.setText("Stopping...")
            return

        # variogram model must exist
        if not self.get_models_from_table() or not self.variogram_computed:
            QtWidgets.QMessageBox.warning(
                self, "Optimisation benchmark",
                "No variogram model is defined.\n"
                "Compute the experimental variogram and fit (or enter) a model in the "
                "Variogram tab, then run the benchmark again.")
            self.tabWidget.setCurrentIndex(1)
            return
        max_start = int(self.spinBox_optimiz_starting_point.value())
        min_start = int(self.spinBoxmin_iter.value()) if hasattr(self, "spinBoxmin_iter") else 1
        step = int(self.spinBox_step.value()) if hasattr(self, "spinBox_step") else 1
        n_runs = int(self.spinBox_n_tentative.value())
        if max_start < 1 or n_runs < 1 or min_start < 1 or step < 1:
            QtWidgets.QMessageBox.warning(
                self, "Optimisation benchmark",
                "Please check the minimum and the maximum number of starting points, the "
                "step and the number of tentatives (all must be at least 1).")
            return
        if min_start > max_start:
            QtWidgets.QMessageBox.warning(
                self, "Optimisation benchmark",
                "The minimum number of starting points (%d) is larger than the maximum (%d)."
                % (min_start, max_start))
            return
        start_values = list(range(min_start, max_start + 1, step))
        ok, base_seed = self._read_seed_field(self.lineEdit_seed_opt, "Seed (benchmark)")
        if not ok:
            return
        setup = self._ck_opt_read_setup(warn_default_model=False)
        if setup is None:
            return
        if not setup['active_params']:
            QtWidgets.QMessageBox.warning(
                self, "Optimisation benchmark",
                "No parameter is selected in the optimisation table (column Use).")
            return

        # new run: clear the previous results
        self._set_bench_mode('opt')
        self.last_benchmark_opt = []
        self._opt_bench_runs = n_runs
        self._bench_opt_model.removeRows(0, self._bench_opt_model.rowCount())
        self.progressBar_opt_bench.setValue(0)
        self.computingtimebenchparam_neigh.setText("computing time:")
        button_text = self.pushButton_opt_bench.text()
        self.pushButton_opt_bench.setText("Stop")
        self._opt_bench_running = True
        self._opt_bench_stop = False
        total_trials = n_runs * sum(start_values)
        done = [0]
        t0 = time.perf_counter()
        n_failed = 0
        stopped = False

        def stop_cb():
            return self._opt_bench_stop

        try:
            for n_start in start_values:
                sses = []
                incomplete = False
                for r in range(n_runs):
                    rng = random.Random("%d-%d-%d" % (base_seed, n_start, r))

                    def progress(it, _n, _d=done[0]):
                        self.progressBar_opt_bench.setValue(
                            int(100.0 * (_d + it) / total_trials))
                        QtWidgets.QApplication.processEvents()

                    res = self._ck_opt_search(
                        setup, n_start, rng, progress_cb=progress,
                        include_warm_start=False, stop_cb=stop_cb, process_events=False)
                    if not res['completed']:
                        incomplete = True
                        break
                    done[0] += n_start
                    if res['best_params'] is not None:
                        sses.append(res['best_sse'])
                    else:
                        n_failed += 1       # no trial estimated all the points
                    QtWidgets.QApplication.processEvents()
                if incomplete:
                    # stopped in the middle of this point: it is not reported
                    stopped = True
                    break
                arr = np.array(sses, dtype=float)       # SSE of the best solution of each run
                if len(arr):
                    sse_min, sse_max, sse_mean = float(arr.min()), float(arr.max()), float(arr.mean())
                else:
                    sse_min = sse_max = sse_mean = float('nan')
                self.last_benchmark_opt.append(
                    (n_start, sse_min, sse_max, sse_mean, len(arr), n_runs))
                self._benchmark_opt_add_row(n_start, sse_min, sse_max, sse_mean,
                                            len(arr), n_runs)
                self._plot_benchmark_opt()
                self.computingtimebenchparam_neigh.setText(
                    "computing time: " + self._format_elapsed_time(time.perf_counter() - t0))
                QtWidgets.QApplication.processEvents()
                if self._opt_bench_stop:
                    stopped = True
                    break
        finally:
            self._opt_bench_running = False
            self._opt_bench_stop = False
            self.pushButton_opt_bench.setText(button_text)

        elapsed = time.perf_counter() - t0
        text = "computing time: " + self._format_elapsed_time(elapsed)
        if stopped:
            text += " (stopped)"
        if n_failed:
            text += " [%d runs without a valid solution]" % n_failed
        self.computingtimebenchparam_neigh.setText(text)
        if not stopped:
            self.progressBar_opt_bench.setValue(100)

    def calculate_variogram_map(self):
        """Compute a circular variogram map: the experimental semivariance
        binned into (radius ring x angular sector) cells covering the full
        360 degrees around each point pair, then displayed as a polar
        color-coded plot in plotWidgetVariogram_map.

        Unlike the standard directional variogram (symmetric over 180
        degrees), the variogram map distinguishes direction over the full
        circle, so every ordered pair contributes once at the angle from i
        to j (not just the unordered pair at one azimuth class).
        """
        layer = self.mMapLayerComboBox.currentLayer()
        field_name = self.mFieldComboBox.currentField()
        if not layer or not field_name:
            return

        max_dist  = self.doubleSpinBox_max_distance_variogram_map.value()
        num_lags  = self.spinBox_num_lags_variogram_map.value()
        lag_size  = self.doubleSpinBox_lag_variogram_map.value()
        lag_tol   = self.doubleSpinBox_lag_tolerance_variogram_map.value()
        num_dirs  = self.spinBox_num_directions_variogram_map.value()
        ang_tol   = self.doubleSpinBox_angular_tolerance_variogram_map.value()
        bandwidth = self.doubleSpinBox_bandwidth_variogram_map.value()
        base_azimuth = self.doubleSpinBox_azimuth_variogram_map.value()

        if num_lags <= 0 or num_dirs <= 0:
            return

        coords, values = [], []
        for f in layer.getFeatures():
            if f.hasGeometry():
                val = f[field_name]
                if val != NULL and val is not None:
                    try:
                        pt = f.geometry().asPoint()
                        coords.append([pt.x(), pt.y()])
                        values.append(float(val))
                    except (ValueError, TypeError):
                        continue

        coords, values = np.array(coords), np.array(values)
        num_points = len(values)
        if num_points < 2:
            return

        # -- Optional declustering weights (separate checkbox from the
        # standard directional variogram, since the two tools are used
        # independently) --------------------------------------------------
        use_decluster = (hasattr(self, 'checkBox_use_decluster_weights_variogram_map')
                         and self.checkBox_use_decluster_weights_variogram_map.isChecked()
                         and "decluster_weight" in {f.name() for f in layer.fields()})
        if use_decluster:
            point_weights = []
            for f in layer.getFeatures():
                if f.hasGeometry():
                    val = f[field_name]
                    if val != NULL and val is not None:
                        try:
                            float(val)
                            w = f["decluster_weight"]
                            point_weights.append(float(w) if w not in (None, NULL) else 1.0)
                        except (ValueError, TypeError):
                            continue
            point_weights = np.array(point_weights)
            if len(point_weights) != num_points:
                use_decluster = False
                point_weights = np.ones(num_points)
        else:
            point_weights = np.ones(num_points)

        self.progressBar_vario_variogram_map.setValue(0)

        # Ring (radius) bin centers following the GSLIB/AutoVar convention:
        # centers at h = 0, lag, 2*lag, ..., (num_lags-1)*lag, so that
        # MaxDistance = (num_lags - 1) * lag_size.
        # The first bin (h = 0) fills the central disc and eliminates the
        # empty circle that would otherwise appear at the centre of the map.
        lag_centers = np.arange(num_lags) * lag_size

        # Largest separation that can still fall into a ring: the last ring is
        # centered at (num_lags - 1) * lag and accepts pairs up to centre + lag_tol
        # (cutting at MaxDistance would keep only half of it, as in the variogram).
        dist_limit = max(max_dist, lag_centers[-1] + lag_tol)

        # Sector centers covering the full circle (0..360), offset by the
        # base azimuth, each sector lasting 360/num_dirs degrees
        sector_width = 360.0 / num_dirs
        sector_centers = [(base_azimuth + d * sector_width) % 360.0 for d in range(num_dirs)]

        # Accumulators: rows = lags (rings), columns = sectors (angles)
        gamma_sum    = np.zeros((num_lags, num_dirs))
        weight_sum   = np.zeros((num_lags, num_dirs))
        pair_count   = np.zeros((num_lags, num_dirs))

        total_steps = num_points
        for i in range(num_points):
            if i % 10 == 0:
                self.progressBar_vario_variogram_map.setValue(int((i + 1) / total_steps * 100))
                QtWidgets.QApplication.processEvents()

            # Consider every ordered pair (i, j) with j != i: the direction
            # from i to j spans the full 360 degrees, unlike the standard
            # variogram which only needs the unordered pair (symmetric over
            # 180 degrees).
            dx = coords[:, 0] - coords[i, 0]
            dy = coords[:, 1] - coords[i, 1]
            dist = np.sqrt(dx**2 + dy**2)

            valid = (dist > 0) & (dist <= dist_limit)
            valid[i] = False
            if not np.any(valid):
                continue

            dx_v, dy_v, dist_v = dx[valid], dy[valid], dist[valid]
            # Angle of each pair, geographic convention (0 deg = North,
            # clockwise), consistent with the standard variogram's azimuth
            # convention used elsewhere in this file.
            angle_deg = (90.0 - np.degrees(np.arctan2(dy_v, dx_v))) % 360.0
            gamma_pair = 0.5 * (values[i] - values[valid]) ** 2
            # GSLIB convention: pair weight = w_i * w_j. With no
            # declustering, point_weights are all 1, so this is equivalent
            # to an unweighted pair (weight_sum == pair_count numerically).
            weight_pair = point_weights[i] * point_weights[valid]

            for k, r_center in enumerate(lag_centers):
                in_ring = np.abs(dist_v - r_center) <= lag_tol
                if not np.any(in_ring):
                    continue
                for s, a_center in enumerate(sector_centers):
                    # Smallest angular distance on a circle (handles wrap-around at 0/360)
                    diff = np.abs((angle_deg - a_center + 180.0) % 360.0 - 180.0)
                    in_sector = in_ring & (diff <= ang_tol)
                    if bandwidth > 0:
                        # Perpendicular (cross-radial) distance, used to cap
                        # the sector width at large radii, same role as the
                        # bandwidth parameter in the standard variogram.
                        perp_dist = dist_v * np.sin(np.radians(diff))
                        in_sector = in_sector & (np.abs(perp_dist) <= bandwidth)
                    n_in = np.count_nonzero(in_sector)
                    if n_in > 0:
                        gamma_sum[k, s]  += np.sum(gamma_pair[in_sector])
                        weight_sum[k, s] += np.sum(weight_pair[in_sector])
                        pair_count[k, s] += n_in

        self.progressBar_vario_variogram_map.setValue(100)

        with np.errstate(invalid='ignore', divide='ignore'):
            gamma_map = np.where(pair_count > 0, gamma_sum / weight_sum, np.nan)

        self.last_vario_map_data = {
            'lag_centers': lag_centers,
            'sector_centers': np.array(sector_centers),
            'sector_width': sector_width,
            'gamma_map': gamma_map,
            'pair_count': pair_count,
            'lag_size': lag_size,
            'max_dist': max_dist,
            'lag_tol': lag_tol,
        }
        self._plot_variogram_map()
        self._plot_variogram_map_3d()

    def _plot_variogram_map(self):
        """Render the circular variogram map stored in self.last_vario_map_data
        as a polar heat-map: each (ring x sector) cell is colored by its
        semivariance value; cells with zero pairs are left white. The plot
        uses equal X/Y scale so the circle is never stretched."""
        data = getattr(self, 'last_vario_map_data', None)
        if data is None:
            return

        lag_centers    = data['lag_centers']
        sector_centers = data['sector_centers']
        sector_width   = data['sector_width']
        gamma_map      = data['gamma_map']
        pair_count     = data['pair_count']
        lag_size       = data['lag_size']
        max_dist       = data['max_dist']
        lag_tol        = data['lag_tol']

        num_lags = len(lag_centers)
        num_dirs = len(sector_centers)

        # Ring edges: each ring spans +/- lag_size/2 around its center,
        # except the outermost ring, whose outer edge reflects the actual
        # tolerance used when binning pairs into that ring: pairs up to
        # last centre + lag_tol were included, so the plotted outer radius
        # must extend that far too (not just to max_dist, and not to the
        # inter-center gap, both of which under/over-stated the true extent).
        inner_edge = max(lag_centers[0] - lag_size / 2.0, 0.0)
        outer_edge = max(max_dist, lag_centers[-1] + lag_tol)
        ring_edges = np.concatenate(([inner_edge], (lag_centers[:-1] + lag_centers[1:]) / 2.0,
                                     [outer_edge]))

        # Sector edges: each sector spans +/- half its width around its center
        half_w = sector_width / 2.0
        sector_edges = np.array([c - half_w for c in sector_centers] + [sector_centers[-1] + half_w])

        self.figure_vario_map.clear()
        ax = self.figure_vario_map.add_subplot(111)

        valid_gamma = gamma_map[np.isfinite(gamma_map)]
        if valid_gamma.size > 0:
            vmin, vmax = float(np.min(valid_gamma)), float(np.max(valid_gamma))
        else:
            vmin, vmax = 0.0, 1.0
        if vmin == vmax:
            vmax = vmin + 1.0
        cmap = plt.get_cmap('viridis')
        norm = plt.Normalize(vmin=vmin, vmax=vmax)

        for k in range(num_lags):
            r_in, r_out = ring_edges[k], ring_edges[k + 1]
            for s in range(num_dirs):
                a_in_deg, a_out_deg = sector_edges[s], sector_edges[s + 1]
                # Convert geographic angle (0=N, clockwise) to math angle
                # (0=East, counter-clockwise) for plotting with matplotlib wedges.
                theta1 = 90.0 - a_out_deg
                theta2 = 90.0 - a_in_deg

                n_pairs = pair_count[k, s]
                if n_pairs <= 0 or not np.isfinite(gamma_map[k, s]):
                    face_color = 'white'
                else:
                    face_color = cmap(norm(gamma_map[k, s]))

                wedge = patches.Wedge((0, 0), r_out, theta1, theta2,
                                      width=(r_out - r_in),
                                      facecolor=face_color,
                                      edgecolor='#888888', linewidth=0.3)
                ax.add_patch(wedge)

        max_r = ring_edges[-1]

        # -- Main anisotropy directions via the inertia tensor ------------------
        # The arrows and their labels are drawn OUTSIDE the circle of the map, so the
        # limits of the axes are widened only when they are shown.
        lim = max_r
        major_angle_deg = minor_angle_deg = None
        if self.checkBox_compute_main_directions_variogram_map.isChecked():
            major_angle_deg, minor_angle_deg = self._compute_variogram_map_main_directions(
                lag_centers, sector_centers, gamma_map, pair_count
            )
            if major_angle_deg is not None:
                self._draw_main_direction_arrows(ax, major_angle_deg, minor_angle_deg, max_r)
                lim = max_r * self._MAIN_DIR_AXIS_LIMIT
        self._update_main_direction_labels(major_angle_deg, minor_angle_deg)

        ax.set_xlim(-lim, lim)
        ax.set_ylim(-lim, lim)
        ax.set_aspect('equal', adjustable='box')  # equal X/Y scale, no stretching

        ax.set_xlabel('X distance', fontsize=8)
        ax.set_ylabel('Y distance', fontsize=8)
        ax.set_title('Variogram Map', fontsize=10)
        ax.grid(True, linestyle=':', linewidth=0.4, alpha=0.5)
        ax.tick_params(axis='both', labelsize=7)

        sm = plt.cm.ScalarMappable(cmap=cmap, norm=norm)
        sm.set_array([])
        cbar = self.figure_vario_map.colorbar(sm, ax=ax, fraction=0.035, pad=0.04)
        cbar.set_label('Semivariance', fontsize=8)
        cbar.ax.tick_params(labelsize=7)

        self.figure_vario_map.tight_layout()
        self.canvas_vario_map.draw()

    def _compute_variogram_map_main_directions(self, lag_centers, sector_centers,
                                               gamma_map, pair_count):
        """Find the principal anisotropy directions of the variogram map using
        a 2D inertia-tensor analysis.

        Each valid cell (ring k, sector s) is treated as a point mass located
        at its (x, y) position on the map, weighted by 1/gamma (cells with
        low semivariance -- i.e. high spatial continuity -- get more weight,
        so the "mass" of the map is concentrated along directions of greater
        continuity). The eigenvectors of the resulting 2x2 inertia tensor
        give the major axis (direction of maximum continuity / minimum
        semivariance growth) and the minor axis (direction of minimum
        continuity), which are exactly perpendicular.

        Returns (major_angle_deg, minor_angle_deg) in the same geographic
        convention used elsewhere (0 deg = North, clockwise), or
        (None, None) if there isn't enough valid data.
        """
        valid = (pair_count > 0) & np.isfinite(gamma_map) & (gamma_map > 0)
        if not np.any(valid):
            return None, None

        # Cell centers in cartesian coordinates (geographic angle -> math angle)
        rr, aa = np.meshgrid(lag_centers, sector_centers, indexing='ij')
        theta_rad = np.radians(90.0 - aa)
        xs = rr * np.cos(theta_rad)
        ys = rr * np.sin(theta_rad)

        # Weight: inverse of semivariance, so low-variance (high continuity)
        # cells dominate the inertia tensor and define the major axis.
        weights = np.zeros_like(gamma_map)
        weights[valid] = 1.0 / gamma_map[valid]

        xs_v, ys_v, w_v = xs[valid], ys[valid], weights[valid]
        w_sum = np.sum(w_v)
        if w_sum <= 0:
            return None, None

        # 2x2 weighted inertia (second-moment) tensor about the origin
        Ixx = np.sum(w_v * xs_v**2) / w_sum
        Iyy = np.sum(w_v * ys_v**2) / w_sum
        Ixy = np.sum(w_v * xs_v * ys_v) / w_sum
        inertia_tensor = np.array([[Ixx, Ixy], [Ixy, Iyy]])

        eigvals, eigvecs = np.linalg.eigh(inertia_tensor)
        # eigh returns eigenvalues in ascending order; the LARGEST eigenvalue's
        # eigenvector points along the direction of greatest spread of mass,
        # i.e. the major (max continuity) axis.
        major_vec = eigvecs[:, np.argmax(eigvals)]
        minor_vec = eigvecs[:, np.argmin(eigvals)]

        def vec_to_geographic_angle(vec):
            # vec = (x, y) in map/cartesian coordinates -> geographic angle
            # (0 deg = North/+Y, clockwise), matching the convention used
            # for sector_centers throughout this feature.
            math_angle = np.degrees(np.arctan2(vec[1], vec[0]))
            return (90.0 - math_angle) % 180.0  # axis, not a vector: fold to 0-180

        major_angle_deg = vec_to_geographic_angle(major_vec)
        minor_angle_deg = vec_to_geographic_angle(minor_vec)

        return major_angle_deg, minor_angle_deg

    # The arrows go beyond the circle of the map (ARROW factor times its radius) and the
    # labels with the angles sit just after the tips of the arrows, so they never overlap
    # the map; the axes are widened (AXIS_LIMIT times the radius) to make room for them.
    _MAIN_DIR_ARROW_LENGTH = 1.18
    _MAIN_DIR_LABEL_OFFSET = 1.03
    _MAIN_DIR_AXIS_LIMIT = 1.50

    def _update_main_direction_labels(self, major_angle_deg, minor_angle_deg):
        """Write the principal directions (geographic azimuth, degrees) in
        label_major_dir_vario and label_minor_dir_vario ("n/a" when they are not
        available, e.g. if the option is off)."""
        def text(name, angle):
            return "%s direction: %s" % (
                name, "n/a" if angle is None else "%.1f\u00b0" % angle)
        if hasattr(self, 'label_major_dir_vario'):
            self.label_major_dir_vario.setText(text("Major", major_angle_deg))
        if hasattr(self, 'label_minor_dir_vario'):
            self.label_minor_dir_vario.setText(text("Minor", minor_angle_deg))

    def _draw_main_direction_arrows(self, ax, major_angle_deg, minor_angle_deg, max_r):
        """Draw the two principal anisotropy directions as double-headed
        arrows (lines through the origin) on the variogram map axes. The arrows are
        longer than the radius of the map, and the label of each one (its azimuth) is
        placed beyond its tip, outside the circle."""
        def angle_to_xy_unit(angle_deg):
            math_angle_rad = np.radians(90.0 - angle_deg)
            return np.cos(math_angle_rad), np.sin(math_angle_rad)

        arrow_len = max_r * self._MAIN_DIR_ARROW_LENGTH
        label_r = arrow_len * self._MAIN_DIR_LABEL_OFFSET

        def draw(angle_deg, color, name):
            ux, uy = angle_to_xy_unit(angle_deg)
            ax.annotate('', xy=(ux * arrow_len, uy * arrow_len),
                        xytext=(-ux * arrow_len, -uy * arrow_len),
                        arrowprops=dict(arrowstyle='<->', color=color, linewidth=2.0),
                        zorder=5)
            # the label is aligned away from the tip, so the text never goes back
            # towards the circle
            ha = 'left' if ux > 0.3 else ('right' if ux < -0.3 else 'center')
            va = 'bottom' if uy > 0.3 else ('top' if uy < -0.3 else 'center')
            ax.text(ux * label_r, uy * label_r, '%s (%.1f\u00b0)' % (name, angle_deg),
                    color=color, fontsize=7, fontweight='bold',
                    ha=ha, va=va, zorder=6,
                    bbox=dict(facecolor='white', edgecolor='none', alpha=0.8, pad=1.0))

        draw(major_angle_deg, 'red', 'Major')
        draw(minor_angle_deg, 'blue', 'Minor')

    def _plot_variogram_map_3d(self):
        """Render the variogram map as a 3D surface (X, Y, semivariance) in
        plotWidgetVariogram_map_3D. Cells with no pairs are left as gaps
        (NaN) in the surface, matching the 2D map's "blank" convention.

        If checkBox_3D_Variogram_model is checked, the theoretical model
        surface (from the fitted structures in tableWidget_models) is drawn
        on top with transparency, so both surfaces remain visible at once.
        """
        data = getattr(self, 'last_vario_map_data', None)
        if data is None:
            return

        lag_centers    = data['lag_centers']
        sector_centers = data['sector_centers']
        gamma_map      = data['gamma_map']        # shape (num_lags, num_dirs), NaN = no pairs
        pair_count     = data['pair_count']

        # Cell-center cartesian coordinates, same convention as the 2D map
        # (geographic angle, 0 deg = North, clockwise).
        rr, aa = np.meshgrid(lag_centers, sector_centers, indexing='ij')
        rr = np.hstack((rr, rr[:, :1]))
        aa = np.hstack((aa, aa[:, :1] + 360.0))
        theta_rad = np.radians(90.0 - aa)
        xs = rr * np.cos(theta_rad)
        ys = rr * np.sin(theta_rad)

        # Gaps where there are no pairs: NaN values create holes in the
        # plotted surface (matplotlib's plot_surface skips NaN vertices).
        zs_exp = np.where(pair_count > 0, gamma_map, np.nan)
        zs_exp = np.hstack((zs_exp, zs_exp[:, :1]))
        self.figure_vario_map_3d.clear()
        ax = self.figure_vario_map_3d.add_subplot(111, projection='3d')

        show_model = self.checkBox_3D_Variogram_model.isChecked()

        # Determine a shared color scale across both surfaces (experimental
        # and, if shown, theoretical) so colors are comparable.
        finite_vals = [zs_exp[np.isfinite(zs_exp)]]
        zs_model = None
        if show_model:
            structures = self.get_models_from_table()
            if structures:
                rr_model, aa_model = np.meshgrid(
                    lag_centers,
                    sector_centers,
                    indexing='ij'
                )
                
                n_lags = len(lag_centers)
                n_dirs = len(sector_centers)
                h_flat = rr_model.ravel()
                az_flat = aa_model.ravel()

                gamma_flat = self.calculate_theoretical_semivariance(
                    h_flat,
                    az_flat,
                    structures
                )

                zs_model = gamma_flat.reshape((n_lags, n_dirs))
                # chiusura 360 degrees -> 0 degrees
                zs_model = np.hstack((zs_model, zs_model[:, :1]))
                finite_vals.append(zs_model[np.isfinite(zs_model)])

        all_finite = np.concatenate([v for v in finite_vals if v.size > 0]) \
            if any(v.size > 0 for v in finite_vals) else np.array([0.0, 1.0])
        vmin, vmax = float(np.min(all_finite)), float(np.max(all_finite))
        if vmin == vmax:
            vmax = vmin + 1.0

        cmap_exp = plt.get_cmap('viridis')
        norm = plt.Normalize(vmin=vmin, vmax=vmax)

        # Experimental surface: semi-transparent so the model surface (if
        # shown) remains visible through it, and vice versa.
        exp_alpha = 0.65 if (show_model and zs_model is not None) else 0.95
        zs_exp[:, -1] = zs_exp[:, 0]
        surf_exp = ax.plot_surface(
            xs, ys, zs_exp, facecolors=cmap_exp(norm(zs_exp)),
            rstride=1, cstride=1, linewidth=0.15, edgecolor='#555555',
            alpha=exp_alpha, shade=False, antialiased=True
        )

        if show_model and zs_model is not None:
            # Theoretical model surface: a contrasting colormap so the two
            # surfaces are visually distinguishable even where they overlap,
            # drawn as a translucent wireframe-like surface on top.
            cmap_model = plt.get_cmap('autumn')
            zs_model[:, -1] = zs_model[:, 0]
            ax.plot_surface(
                xs, ys, zs_model, facecolors=cmap_model(norm(zs_model)),
                rstride=1, cstride=1, linewidth=0.2, edgecolor='#aa0000',
                alpha=0.40, shade=False, antialiased=True
            )
        elif show_model and not structures:
            ax.text2D(0.5, 0.5, 'No theoretical model defined',
                     transform=ax.transAxes, ha='center', va='center',
                     fontsize=9, color='gray')

        ax.set_xlabel('X distance', fontsize=8)
        ax.set_ylabel('Y distance', fontsize=8)
        ax.set_zlabel('Semivariance', fontsize=8)
        ax.set_title('Variogram Map (3D)', fontsize=10)
        ax.tick_params(axis='both', labelsize=7)

        # The Z values (semivariance) are typically orders of magnitude
        # smaller than the X/Y distances (e.g. meters vs a small variance
        # value), so a box_aspect proportional to the real data range makes
        # the surface look almost perfectly flat. Instead, give Z its own
        # full-height visual scale -- same physical size as X and Y -- by
        # using an equal box_aspect (1, 1, 1) and letting matplotlib stretch
        # the Z *axis scale* (not the data) to fill that height. This is the
        # standard way to plot dimensionally-different axes (distance vs.
        # semivariance) so the surface is actually visible.
        try:
            ax.set_box_aspect((1, 1, 1))
        except AttributeError:
            pass  # older matplotlib without set_box_aspect: skip, still functional

        max_r = float(np.nanmax(rr))
        ax.set_xlim(-max_r, max_r)
        ax.set_ylim(-max_r, max_r)
        ax.set_zlim(vmin, vmax)

        sm = plt.cm.ScalarMappable(cmap=cmap_exp, norm=norm)
        sm.set_array([])
        cbar = self.figure_vario_map_3d.colorbar(sm, ax=ax, fraction=0.035, pad=0.08)
        cbar.set_label('Semivariance (experimental)', fontsize=8)
        cbar.ax.tick_params(labelsize=7)

        self.canvas_vario_map_3d.draw()

    def plot_multi_variogram(self, lags, results):
        self.figure_vario.clear()
        ax = self.figure_vario.add_subplot(111)
        colors = ['firebrick', 'navy', 'forestgreen', 'darkorange', 'purple', 'teal']

        show_counts   = self.checkBox_show_counts.isChecked()
        show_boxplot  = self.checkBox_boxplot.isChecked()
        show_h_box    = self.checkBox_h_boxplot.isChecked()
        show_model    = (hasattr(self, 'checkBox_theoretical_model') and
                         self.checkBox_theoretical_model.isChecked())

        model_structures = self.get_models_from_table()
        step          = (lags[1] - lags[0]) if len(lags) > 1 else lags[0]
        max_plot_dist = np.max(lags) * 1.05
        h_fine        = np.linspace(0, max_plot_dist, 300)

        # Accumulate h box-plot data for all directions so we can draw them
        # after the main loop (we need the final y limits first).
        # Each entry: (color, list-of-bxp-stat-dicts, list-of-y-positions)
        h_bxp_per_dir = []

        has_data = False
        for idx, (az, (gamma, counts, gamma_values, h_eff, pair_dists)) in enumerate(results.items()):
            valid_idx = ~np.isnan(gamma)
            if not np.any(valid_idx):
                continue
            has_data  = True
            color     = colors[idx % len(colors)]

            # -- Gamma (Y) box plots -------------------------------------------
            if show_boxplot:
                dir_data, dir_positions, dir_widths = [], [], []
                for k in range(len(lags)):
                    if len(gamma_values[k]) > 0:
                        dir_data.append(gamma_values[k])
                        dir_positions.append(h_eff[k])
                        if show_h_box and len(pair_dists[k]) >= 4:
                            # Width of the gamma box = IQR of the actual pair
                            # distances in this bin, so the user can read both
                            # uncertainties simultaneously.
                            q1_h = np.percentile(pair_dists[k], 25)
                            q3_h = np.percentile(pair_dists[k], 75)
                            iqr_h = max(q3_h - q1_h, step * 0.05)
                            dir_widths.append(iqr_h)
                        else:
                            dir_widths.append(step * 0.25)

                if dir_data:
                    bp = ax.boxplot(
                        dir_data,
                        positions=dir_positions,
                        widths=dir_widths,
                        patch_artist=True,
                        manage_ticks=False,
                        showfliers=False,
                    )
                    for patch in bp['boxes']:
                        patch.set_facecolor(color)
                        patch.set_alpha(0.18)
                        patch.set_edgecolor(color)
                    for element in ('whiskers', 'caps', 'medians'):
                        for line in bp[element]:
                            line.set_color(color)
                            line.set_alpha(0.6)

            # -- Mean variogram curve ------------------------------------------
            ax.plot(
                h_eff[valid_idx], gamma[valid_idx],
                linestyle=':', marker='o', color=color, alpha=0.8,
                label=f"Azimuth {az:.1f}\u00b0 (Exp)",
            )

            # -- Theoretical model curve ---------------------------------------
            if model_structures and show_model:
                ax.plot(
                    h_fine,
                    self.calculate_theoretical_semivariance(h_fine, az, model_structures),
                    linestyle='-', linewidth=2.0, color=color, alpha=0.9,
                    label=f"Azimuth {az:.1f}\u00b0 (Model)",
                )

            # -- Pair count annotations ----------------------------------------
            if show_counts:
                for i, txt in enumerate(counts):
                    if valid_idx[i]:
                        ax.annotate(
                            f"N={int(txt)}", (h_eff[i], gamma[i]),
                            textcoords="offset points", xytext=(0, 8),
                            ha='center', fontsize=7, color=color,
                        )

            # -- Collect h box-plot stats for this direction -------------------
            if show_h_box:
                stats_list = []
                for k in range(len(lags)):
                    d = pair_dists[k]
                    if len(d) < 4:
                        continue
                    d_arr = np.array(d)
                    stats_list.append({
                        'med':     float(np.median(d_arr)),
                        'q1':      float(np.percentile(d_arr, 25)),
                        'q3':      float(np.percentile(d_arr, 75)),
                        'whislo':  float(np.percentile(d_arr,  5)),
                        'whishi':  float(np.percentile(d_arr, 95)),
                        'fliers':  [],
                        'label':   '',
                    })
                if stats_list:
                    h_bxp_per_dir.append((color, stats_list))

        # -- Draw horizontal h box plots below y = 0 ---------------------------
        if show_h_box and h_bxp_per_dir:
            # Determine the height of the gamma region and allocate a strip
            # below y = 0 for each direction's h distribution.
            y_top = ax.get_ylim()[1]
            strip_h   = 0.06 * y_top   # height of one strip in data coords
            strip_gap = 0.01 * y_top   # gap between strips

            for d_idx, (color, stats_list) in enumerate(h_bxp_per_dir):
                # y centre of this direction's strip (negative, below the axis)
                y_center = -(d_idx + 0.5) * (strip_h + strip_gap)
                positions = [y_center] * len(stats_list)

                bp_h = ax.bxp(
                    stats_list,
                    positions=positions,
                    vert=False,               # horizontal box plots
                    widths=strip_h * 0.7,
                    patch_artist=True,
                    manage_ticks=False,
                    showfliers=False,
                )
                for patch in bp_h['boxes']:
                    patch.set_facecolor(color)
                    patch.set_alpha(0.25)
                    patch.set_edgecolor(color)
                for element in ('whiskers', 'caps', 'medians'):
                    for line in bp_h[element]:
                        line.set_color(color)
                        line.set_alpha(0.7)

            # Expand y axis to reveal the h strips and add a separator line.
            total_h_space = len(h_bxp_per_dir) * (strip_h + strip_gap) + strip_gap
            ax.set_ylim(-total_h_space, y_top)
            ax.axhline(0, color='black', linewidth=0.8, linestyle='--', alpha=0.4)

            # Label the h-distribution zone on the right side
            ax.text(
                max_plot_dist * 0.99,
                -total_h_space * 0.5,
                "h distribution",
                ha='right', va='center', fontsize=7,
                color='dimgray', style='italic',
            )

        ax.set_title("Multi-Directional Experimental vs Theoretical Variogram")
        ax.set_xlabel("Lag distance h")
        ax.set_ylabel("Semivariance \u03b3(h)")
        ax.grid(True, linestyle=':', alpha=0.6)
        ax.set_xlim(0, max_plot_dist)
        ax.legend(loc='best', fontsize=8)
        self.figure_vario.tight_layout()
        self.canvas_vario.draw()

    # ---------------------------------------------------------
    # TAB 3: Advanced Kriging Estimation Engine & Raster Builder
    # ---------------------------------------------------------
    # =========================================================================
    # Estimation target: grid vs. existing point layer
    # =========================================================================

    def _on_estim_target_toggled(self, *args):
        """Enable/disable the grid-output widgets vs the point-output widgets
        depending on which radio button (grid / points) is selected."""
        use_points = self.radioButton_estim_points.isChecked()

        # Point-target widgets
        self.comboBox_estim_points.setEnabled(use_points)
        self.lineEdit_estim_vect_name.setEnabled(use_points)

        # Grid-target widgets (existing raster output controls)
        for name in ('lineEdit_estimated_layer_name', 'doubleSpinBox_xmin',
                    'doubleSpinBox_ymin', 'spinBox_Nx', 'spinBox_Ny',
                    'doubleSpinBox_dx', 'doubleSpinBox_dy'):
            if hasattr(self, name):
                getattr(self, name).setEnabled(not use_points)

        if use_points:
            self._suggest_estim_vect_name()

    def _populate_estim_points_combo(self, *args):
        """Populate comboBox_estim_points with all point vector layers in the project."""
        combo = self.comboBox_estim_points
        current_id = combo.currentData()
        combo.blockSignals(True)
        combo.clear()
        for lyr in QgsProject.instance().mapLayers().values():
            if isinstance(lyr, QgsVectorLayer) and lyr.isValid():
                combo.addItem(lyr.name(), lyr.id())
        idx = combo.findData(current_id)
        combo.setCurrentIndex(idx if idx >= 0 else 0)
        combo.blockSignals(False)
        self._suggest_estim_vect_name()

    @staticmethod
    def _unique_layer_name(base_name):
        """Return base_name if no project layer already uses it, else base_name_1,
        base_name_2, ... ."""
        existing = {l.name() for l in QgsProject.instance().mapLayers().values()}
        if base_name not in existing:
            return base_name
        i = 1
        while True:
            candidate = "%s_%d" % (base_name, i)
            if candidate not in existing:
                return candidate
            i += 1

    def _suggest_estim_vect_name(self, *args):
        """Pre-fill lineEdit_estim_vect_name with
        '<comboBox_estim_points layer name>_<selected variable>', adding a
        numeric suffix if that name is already used by a project layer."""
        points_layer_name = self.comboBox_estim_points.currentText().strip()
        field_name = self.mFieldComboBox.currentField()
        if not points_layer_name or not field_name:
            return
        base = "%s_%s" % (points_layer_name, field_name)
        self.lineEdit_estim_vect_name.setText(self._unique_layer_name(base))

    def _run_kriging_on_point_layer(self, layer, field_name, structures,
                                    X_known, Y_known, values,
                                    is_ok, is_sk, is_uk,
                                    search_r_max, search_r_min, search_azimuth,
                                    use_octants, min_per_octant, pts_min, pts_max,
                                    mean_value, sample_variance, NO_VALUE):
        """Estimate at the locations of comboBox_estim_points's layer and create
        a new in-memory point layer with two attributes:
            <field_name>_estimated  (Double) - kriging estimate
            <field_name>_est_var    (Double) - kriging variance
        The new layer is added to the QGIS project in memory only (never
        written to disk)."""
        target_layer_id = self.comboBox_estim_points.currentData()
        target_layer = QgsProject.instance().mapLayer(target_layer_id) if target_layer_id else None
        if target_layer is None:
            QtWidgets.QMessageBox.critical(self, "Error",
                "Could not resolve the selected point layer for estimation.")
            return None

        out_name = self.lineEdit_estim_vect_name.text().strip()
        if not out_name:
            out_name = self._unique_layer_name(
                "%s_%s" % (target_layer.name(), field_name))
        else:
            out_name = self._unique_layer_name(out_name)

        est_field_name = field_name + "_estimated"
        var_field_name = field_name + "_est_var"

        crs_str = target_layer.crs().authid() or target_layer.crs().toWkt()
        out_layer = QgsVectorLayer("Point?crs=%s" % crs_str, out_name, "memory")
        pr = out_layer.dataProvider()
        pr.addAttributes([
            QgsField(est_field_name, QVariant.Double),
            QgsField(var_field_name, QVariant.Double),
        ])
        out_layer.updateFields()
        out_fields = out_layer.fields()
        idx_est = out_fields.indexOf(est_field_name)
        idx_var = out_fields.indexOf(var_field_name)

        target_features = list(target_layer.getFeatures())
        total = len(target_features)
        if total == 0:
            QtWidgets.QMessageBox.warning(self, "No Points",
                "The selected point layer for estimation has no features.")
            return None

        new_features = []
        self.progressBar_kriging.setValue(0)
        for i, feat in enumerate(target_features):
            geom = feat.geometry()
            if geom is None or geom.isNull():
                continue
            pt = geom.asPoint()
            est_val, krig_var = self._estimate_single_point(
                pt.x(), pt.y(), X_known, Y_known, values,
                is_ok, is_sk, is_uk, structures,
                search_r_max, search_r_min, search_azimuth,
                use_octants, min_per_octant, pts_min, pts_max,
                mean_value, sample_variance, NO_VALUE
            )
            new_feat = QgsFeature(out_fields)
            new_feat.setGeometry(QgsGeometry.fromPointXY(pt))
            new_feat.setAttribute(idx_est, None if est_val == NO_VALUE else float(est_val))
            new_feat.setAttribute(idx_var, None if krig_var == NO_VALUE else float(krig_var))
            new_features.append(new_feat)

            if i % 50 == 0:
                self.progressBar_kriging.setValue(int((i + 1) / total * 100))
                QtWidgets.QApplication.processEvents()

        self.progressBar_kriging.setValue(100)

        ok, _ = pr.addFeatures(new_features)
        if not ok:
            QtWidgets.QMessageBox.critical(self, "Error",
                "Failed to add estimated features to the output layer.")
            return None

        out_layer.updateExtents()
        QgsProject.instance().addMapLayer(out_layer)
        return out_layer

    def run_kriging_interpolation(self):
        """Validates parameters, runs the selected 2D Kriging system, and creates an output raster."""
        # 1. Preliminary check: has the user computed or adjusted the variogram model?
        if not self.variogram_computed:
            reply = QtWidgets.QMessageBox.warning(
                self, "Warning: Default Variogram",
                "You haven't computed or adjusted the variogram model for this layer yet.\n"
                "Using the default model parameters will likely produce incorrect estimations.\n\n"
                "Do you want to continue anyway?",
                QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
                QtWidgets.QMessageBox.No
            )
            if reply == QtWidgets.QMessageBox.No:
                # Switch directly to the Variogram tab (index 1)
                self.tabWidget.setCurrentIndex(1)
                return
        estim_on_points = self.radioButton_estim_points.isChecked()

        if not estim_on_points:
            output_path = self.lineEdit_estimated_layer_name.text()
            if not output_path or not os.path.exists(os.path.dirname(output_path)):
                output_path = self.prompt_save_path()
                if not output_path: return  # User cancelled the dialog

        # 2. Extract input point layer and geometry
        layer = self.mMapLayerComboBox.currentLayer()
        field_name = self.mFieldComboBox.currentField()
        if not layer or not field_name:
            QtWidgets.QMessageBox.critical(self, "Error", "Invalid point layer or field chosen.")
            return

        coords, values = [], []
        for f in layer.getFeatures():
            if f.hasGeometry():
                val = f[field_name]
                if val != NULL and val is not None:
                    try:
                        pt = f.geometry().asPoint()
                        coords.append([pt.x(), pt.y()])
                        values.append(float(val))
                    except (ValueError, TypeError): continue
        
        coords, values = np.array(coords), np.array(values)
        num_points = len(values)
        if num_points < 3:
            QtWidgets.QMessageBox.critical(self, "Error", "Kriging requires at least 3 points to build a spatial matrix.")
            return

        # 2b. Check for duplicate XY coordinates
        rounded = np.round(coords, decimals=6)
        unique_coords, inv_idx, counts = np.unique(
            rounded, axis=0, return_inverse=True, return_counts=True
        )
        dup_mask = counts[inv_idx] > 1
        num_dups = int(dup_mask.sum())
        if num_dups > 0:
            dup_xy = np.unique(rounded[dup_mask], axis=0)
            dup_list = "\n".join(f"  ({p[0]:.4f}, {p[1]:.4f})" for p in dup_xy[:10])
            if len(dup_xy) > 10:
                dup_list += f"\n  ... and {len(dup_xy)-10} more"
            reply = QtWidgets.QMessageBox.warning(
                self, "Duplicate Coordinates Detected",
                f"Found {num_dups} point(s) sharing the same XY location:\n{dup_list}\n\n"
                "Duplicate locations cause a singular matrix.\n"
                "Only the first occurrence of each duplicate will be kept.\n\n"
                "Do you want to continue?",
                QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
                QtWidgets.QMessageBox.No
            )
            if reply == QtWidgets.QMessageBox.No:
                return
            # Keep only the first occurrence of each duplicated location
            _, first_idx = np.unique(rounded, axis=0, return_index=True)
            first_idx = np.sort(first_idx)
            coords = coords[first_idx]
            values = values[first_idx]
            num_points = len(values)

        # 3. Grid parameters from Tab 3
        xmin = self.doubleSpinBox_xmin.value()
        ymin = self.doubleSpinBox_ymin.value()
        Nx = self.spinBox_Nx.value()
        Ny = self.spinBox_Ny.value()
        dx = self.doubleSpinBox_dx.value()
        dy = self.doubleSpinBox_dy.value()
        # 3b. Search ellipse parameters and point filter settings
        search_r_max   = self.doubleSpinBox_searchR_max.value()
        search_r_min   = self.doubleSpinBox_searchR_min.value()
        search_azimuth = self.doubleSpinBox_search_azimuth.value()  # gradi geografici
        use_octants    = self.checkBox_octant_search.isChecked()
        min_per_octant = self.spinBox_min_point_per_octant.value()
        pts_min        = self.spinBox_kriging_num_points_min.value()
        pts_max        = self.spinBox_kriging_num_points_max.value()
        NO_VALUE       = float(self.doubleSpinBox_nodata_value.value()) if hasattr(self, "doubleSpinBox_nodata_value") else -9999.0

        # Set up the kriging type
        is_uk = self.radioButton_UniversalKriging.isChecked()
        is_sk = self.radioButton_SimpleKriging.isChecked()
        is_ok = self.radioButton_OrdinaryKriging.isChecked()
        if is_ok:
            string_name_type="ok"
        elif is_uk:
            string_name_type="uk"
        else:
            string_name_type="sk"
        # 4. Output raster filename management (grid mode only)
        if not estim_on_points:
            base_dir = os.path.dirname(layer.source()) if os.path.exists(layer.source()) else QgsProject.instance().homePath()
            if not os.path.isdir(base_dir):
                base_dir = QtCore.QDir.tempPath()

            requested_name = self.lineEdit_estimated_layer_name.text().strip()
            if not requested_name:
                requested_name = f"{field_name}_{string_name_type}"

            output_filename = f"{requested_name}.tif"
            output_path = os.path.join(base_dir, output_filename)

            # Check for existing file conflicts on disk
            if os.path.exists(output_path):
                reply = QtWidgets.QMessageBox.question(
                    self, "File Existing",
                    f"The file '{output_filename}' already exists in the project path.\n"
                    "Do you want to overwrite it?\n\n(Click 'No' to create a new unique indexed copy)",
                    QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No
                )
                if reply == QtWidgets.QMessageBox.No:
                    counter = 1
                    while True:
                        output_filename = f"{requested_name}_{counter}.tif"
                        output_path = os.path.join(base_dir, output_filename)
                        if not os.path.exists(output_path):
                            break
                        counter += 1
                    # Update the UI with the auto-incremented filename
                    self.lineEdit_estimated_layer_name.setText(output_filename.replace(".tif", ""))

        # Start of the timed section (reported in Computing_krig_time). All the
        # modal dialogs (default variogram warning, duplicates, overwrite
        # question) have already been answered, so the user's reaction time is
        # not counted. It covers the model/matrix set-up and the estimation.
        t_krig_start = time.perf_counter()

        # 5. Build the theoretical semivariance model
        structures = self.get_models_from_table()
        
        # Compute sample variance for Simple Kriging (prior variance)
        sample_variance = float(np.var(values))
        
        # get_cov_or_semi: local wrapper delegating to calculate_theoretical_semivariance.
        # Coordinates are passed as a tuple so the per-pair azimuth is computed automatically.
        def get_cov_or_semi(h_dists, x_from, y_from, x_to, y_to):
            return self.calculate_theoretical_semivariance(
                h_dists, (x_from, y_from, x_to, y_to), structures
            )

        # 6. Build the known-points matrix (A)
        # Compute pairwise distances between all known points
        X_known = coords[:, 0]
        Y_known = coords[:, 1]
        
        # Geometric distances between point pairs
        dists_pts = np.sqrt((X_known[:, None] - X_known[None, :])**2 + (Y_known[:, None] - Y_known[None, :])**2)
        # Gamma_A: true azimuth computed for each pair (i,j) of sampled points
        Gamma_A = get_cov_or_semi(
            dists_pts,
            X_known[:, None], Y_known[:, None],  # "from" coordinates (row i)
            X_known[None, :], Y_known[None, :]   # "to"   coordinates (column j)
        )

        
            
        # mean_value: global mean used by Simple Kriging
        mean_value = self.doubleSpinBox_mean_sk.value()
        # Note: matrix A and vector B are now built locally for each estimation node,
        # using only the points selected by the search ellipse.
        # The global Gamma_A (computed above) is kept for potential future use
        # (e.g. diagnostics) but is no longer inverted globally.

        # -- Estimation target: existing point layer instead of a grid --------
        if estim_on_points:
            out_layer = self._run_kriging_on_point_layer(
                layer, field_name, structures,
                X_known, Y_known, values,
                is_ok, is_sk, is_uk,
                search_r_max, search_r_min, search_azimuth,
                use_octants, min_per_octant, pts_min, pts_max,
                mean_value, sample_variance, NO_VALUE
            )
            if out_layer is not None:
                # End of the timed section; update the label BEFORE the modal
                # "Done" message box so that the time is visible behind it.
                self._report_kriging_time(time.perf_counter() - t_krig_start)
                QtWidgets.QMessageBox.information(
                    self, "Done",
                    "Point-based kriging complete.\n"
                    "New layer '%s' added to the project (in memory).\n"
                    "  %s_estimated : kriging estimate\n"
                    "  %s_est_var   : kriging variance" % (
                        out_layer.name(), field_name, field_name)
                )
            return

        # 7. Estimation loop over all grid nodes (final raster matrix)
        # Initialise raster matrices. Rows = Ny, Columns = Nx.
        # Note: GIS rasters originate from the top-left corner (Y max, X min)
        self.progressBar_kriging.setValue(0)
        raster_data, variance_data = self._krige_grid(
            X_known, Y_known, values, structures, xmin, ymin, Nx, Ny, dx, dy,
            is_ok, is_uk, search_r_max, search_r_min, search_azimuth,
            use_octants, min_per_octant, pts_min, pts_max,
            mean_value, NO_VALUE, self.progressBar_kriging.setValue)
        self.progressBar_kriging.setValue(100)

        # End of the timed section: the estimation over all grid nodes is done.
        # Writing the GeoTIFF files and loading them in QGIS (steps 8-9) is disk
        # I/O and is deliberately not included in the reported time.
        self._report_kriging_time(time.perf_counter() - t_krig_start)

        # 8. Scrittura fisica del file raster GeoTIFF tramite la libreria standard GDAL
        try:
            from osgeo import gdal, osr
        except ImportError:
            QtWidgets.QMessageBox.critical(self, "GDAL Error", "GDAL library not available in QGIS environment.")
            return

        driver = gdal.GetDriverByName('GTiff')
        # Create the raster dataset: File, Columns (Nx), Rows (Ny), Bands (1), Data type (Float32)
        dataset = driver.Create(output_path, Nx, Ny, 1, gdal.GDT_Float32)
        
        # Set raster GeoTransformation
        # [X_min, X_resolution, X_rotation, Y_max, Y_rotation, -Y_resolution]
        # Negative dy because the raster origin is at the top-left corner
        geotransform = (xmin, dx, 0.0, ymin + Ny * dy, 0.0, -dy)
        dataset.SetGeoTransform(geotransform)
        
        # Assign the same CRS as the input point vector layer
        if layer.crs().isValid():
            srs = osr.SpatialReference()
            srs.ImportFromWkt(layer.crs().toWkt())
            dataset.SetProjection(srs.ExportToWkt())
            
        band = dataset.GetRasterBand(1)
        band.WriteArray(raster_data)
        band.FlushCache()
        dataset = None # Chiude e salva fisicamente il file sul disco
        # Prepara il percorso
        var_path = output_path.replace(".tif", "_var.tif")
        
        # Create the variance dataset
        dataset_var = driver.Create(var_path, Nx, Ny, 1, gdal.GDT_Float32)
        dataset_var.SetGeoTransform(geotransform)
        if layer.crs().isValid():
            dataset_var.SetProjection(srs.ExportToWkt())
            
        band_var = dataset_var.GetRasterBand(1)
        band_var.WriteArray(variance_data)
        band_var.FlushCache()
        dataset_var = None
        # 9. Automatically load the computed raster into QGIS
        for path in [output_path, var_path]:
            file_info = QtCore.QFileInfo(path)
            raster_layer = QgsRasterLayer(path, file_info.completeBaseName())
            if raster_layer.isValid():
                QgsProject.instance().addMapLayer(raster_layer)
            else:
                QtWidgets.QMessageBox.critical(self, "Error", "Failed to load the generated raster: %s" % path)

        # Update comboBox_raster so the new kriging rasters are available
        self._populate_raster_combo()
        QtWidgets.QMessageBox.information(self, "Done", "Kriging complete. Rasters loaded.")

    def _krige_grid(self, X_known, Y_known, values, structures, xmin, ymin, Nx, Ny, dx, dy,
                    is_ok, is_uk, search_r_max, search_r_min, search_azimuth,
                    use_octants, min_per_octant, pts_min, pts_max,
                    mean_value, NO_VALUE, progress_cb):
        """Estimate all the nodes of a regular grid (cell centres) by local kriging.

        Returns (raster_data, variance_data), two float32 arrays of shape (Ny, Nx)
        whose first row is the top one (GIS convention). Nodes that cannot be
        estimated are set to NO_VALUE. progress_cb(percent) is called every 500
        nodes. Kriging type: Ordinary if is_ok, Universal (linear drift) if is_uk,
        Simple otherwise. This is the loop formerly inside run_kriging_interpolation.
        """
        def get_cov_or_semi(h_dists, x_from, y_from, x_to, y_to):
            return self.calculate_theoretical_semivariance(
                h_dists, (x_from, y_from, x_to, y_to), structures
            )

        raster_data = np.zeros((Ny, Nx), dtype=np.float32)
        variance_data = np.zeros((Ny, Nx), dtype=np.float32) # NUOVA MATRICE
        
        total_pixels = Ny * Nx
        pixel_count = 0

        # Cell-by-cell estimation loop
        for r in range(Ny):
            # Y coordinate of the raster node centre (top to bottom)
            y_node = (ymin + (Ny - 1 - r) * dy) + (dy / 2.0)
            
            for c in range(Nx):
                # X coordinate of the raster node centre (left to right)
                x_node = (xmin + c * dx) + (dx / 2.0)
                
                # -- Select points inside the search ellipse ----------------------
                dx_pts = X_known - x_node
                dy_pts = Y_known - y_node
                dists_to_node = np.sqrt(dx_pts**2 + dy_pts**2)

                # Rotate into the ellipse coordinate system (azimuth = major-axis direction)
                az_rad = np.radians(search_azimuth)
                dx_rot =  dx_pts * np.cos(az_rad) + dy_pts * np.sin(az_rad)
                dy_rot = -dx_pts * np.sin(az_rad) + dy_pts * np.cos(az_rad)
                r_min_safe = search_r_min if search_r_min > 0 else search_r_max
                in_ellipse = ((dx_rot / search_r_max)**2 + (dy_rot / r_min_safe)**2) <= 1.0
                sel_idx = np.where(in_ellipse)[0]

                # -- Octant search (optional) --------------------------------------
                if use_octants and len(sel_idx) > 0:
                    angles = np.degrees(np.arctan2(dy_pts[sel_idx], dx_pts[sel_idx])) % 360.0
                    octant_ids = (angles // 45).astype(int)  # 0..7
                    kept = []
                    for oct_id in range(8):
                        oct_mask = octant_ids == oct_id
                        oct_pts  = sel_idx[oct_mask]
                        if len(oct_pts) < min_per_octant:
                            continue  # ottante con troppo pochi punti: scartato
                        # Sort by increasing distance and keep the closest
                        oct_sorted = oct_pts[np.argsort(dists_to_node[oct_pts])]
                        kept.append(oct_sorted)
                    sel_idx = np.concatenate(kept) if kept else np.array([], dtype=int)

                # -- Min / max point filter ----------------------------------------
                n_sel = len(sel_idx)
                if n_sel < pts_min:
                    # Too few points: node cannot be estimated
                    raster_data[r, c]   = NO_VALUE
                    variance_data[r, c] = NO_VALUE
                    pixel_count += 1
                    if pixel_count % 500 == 0:
                        progress_cb(int((pixel_count / total_pixels) * 100))
                        QtWidgets.QApplication.processEvents()
                    continue

                if n_sel > pts_max:
                    # Too many points: keep the pts_max closest ones
                    closest = np.argsort(dists_to_node[sel_idx])[:pts_max]
                    sel_idx = sel_idx[closest]
                    n_sel   = pts_max

                # -- Subset dati locali --------------------------------------------
                X_loc  = X_known[sel_idx]
                Y_loc  = Y_known[sel_idx]
                V_loc  = values[sel_idx]
                D_loc  = dists_to_node[sel_idx]

                # Local matrix A (rebuilt using the selected points only)
                dists_loc = np.sqrt((X_loc[:, None]-X_loc[None,:])**2 +
                                    (Y_loc[:, None]-Y_loc[None,:])**2)
                Gamma_A_loc = get_cov_or_semi(
                    dists_loc,
                    X_loc[:, None], Y_loc[:, None],
                    X_loc[None, :], Y_loc[None, :]
                )
                Gamma_B = get_cov_or_semi(
                    D_loc,
                    X_loc, Y_loc,
                    x_node, y_node
                )

                if is_ok:
                    A_loc = np.zeros((n_sel + 1, n_sel + 1))
                    A_loc[:n_sel, :n_sel] = Gamma_A_loc
                    A_loc[n_sel, :n_sel]  = 1.0
                    A_loc[:n_sel, n_sel]  = 1.0
                    B_vec = np.zeros(n_sel + 1)
                    B_vec[:n_sel] = Gamma_B
                    B_vec[n_sel]  = 1.0
                    try:
                        sol = np.linalg.solve(A_loc, B_vec)
                    except np.linalg.LinAlgError:
                        raster_data[r, c] = NO_VALUE; variance_data[r, c] = NO_VALUE
                        pixel_count += 1; continue
                    weights     = sol[:n_sel]
                    lagrange_mu = sol[n_sel]
                    estimated_val = np.sum(weights * V_loc)
                    kriging_var   = np.sum(weights * Gamma_B) + lagrange_mu
                elif is_uk:
                    # Universal Kriging with linear trend (3 constraints: 1 + X + Y)
                    # Matrix size: n_sel + 3  (NOT +4 - there is no 4th constraint)
                    nc = n_sel + 3
                    A_loc = np.zeros((nc, nc))
                    A_loc[:n_sel, :n_sel]   = Gamma_A_loc
                    # Constraint rows/cols: [n_sel]=unity, [n_sel+1]=X, [n_sel+2]=Y
                    A_loc[n_sel,   :n_sel]  = 1.0
                    A_loc[:n_sel,  n_sel]   = 1.0
                    A_loc[n_sel+1, :n_sel]  = X_loc
                    A_loc[:n_sel,  n_sel+1] = X_loc
                    A_loc[n_sel+2, :n_sel]  = Y_loc
                    A_loc[:n_sel,  n_sel+2] = Y_loc
                    B_vec = np.zeros(nc)
                    B_vec[:n_sel]   = Gamma_B
                    B_vec[n_sel]    = 1.0
                    B_vec[n_sel+1]  = x_node
                    B_vec[n_sel+2]  = y_node
                    try:
                        sol = np.linalg.solve(A_loc, B_vec)
                    except np.linalg.LinAlgError:
                        raster_data[r, c] = NO_VALUE; variance_data[r, c] = NO_VALUE
                        pixel_count += 1; continue
                    weights       = sol[:n_sel]
                    lagrange_mu   = sol[n_sel]      # Lagrange multiplier (unity constraint)
                    estimated_val = np.sum(weights * V_loc)
                    # Kriging variance: w^T * gamma_B + mu0 (unity Lagrange multiplier)
                    kriging_var   = np.sum(weights * Gamma_B) + lagrange_mu
                else:
                    # Simple Kriging: use the local covariance matrix
                    C_loc = self.get_covariance(dists_loc, 0.0, structures)
                    cov_B = self.get_covariance(D_loc, 0.0, structures)
                    try:
                        weights = np.linalg.solve(C_loc, cov_B)
                    except np.linalg.LinAlgError:
                        raster_data[r, c] = NO_VALUE; variance_data[r, c] = NO_VALUE
                        pixel_count += 1; continue
                    estimated_val = mean_value + np.sum(weights * (V_loc - mean_value))
                    kriging_var   = self.get_total_sill(structures) - np.sum(weights * cov_B)

                raster_data[r, c]   = estimated_val
                variance_data[r, c] = max(0.0, kriging_var)
                
                pixel_count += 1
                if pixel_count % 500 == 0:
                    progress_cb(int((pixel_count / total_pixels) * 100))
                    QtWidgets.QApplication.processEvents()

        return raster_data, variance_data

    def _estimate_single_point(self, x_node, y_node, X_known, Y_known, values,
                                   is_ok, is_sk, is_uk, structures,
                                   search_r_max, search_r_min, search_azimuth,
                                   use_octants, min_per_octant, pts_min, pts_max,
                                   mean_value, sample_variance, NO_VALUE,
                                   exclude_index=None, return_details=False):
        """Estimate the value at (x_node, y_node) using the surrounding known points.

        If exclude_index is set, that point is removed from the candidate set
        before any search/filter step (used for leave-one-out cross-validation).

        Returns (estimated_value, kriging_variance) by default.
        If return_details=True, returns a third element: a dict with
            'neighbor_idx'  : original indices (into X_known/Y_known/values)
                              of the points actually used in the estimation
            'neighbor_x'    : their X coordinates
            'neighbor_y'    : their Y coordinates
            'weights'       : kriging weights assigned to each neighbor
            'candidate_idx' : original indices of ALL points inside the search
                              ellipse (used or not, e.g. discarded by octant/
                              max-points filtering)
        or None if the point could not be estimated.
        """
        structures = structures  # already resolved by caller

        # Build a local wrapper for the semivariance (identical to the one in run_kriging)
        def get_cov_or_semi(h_dists, x_from, y_from, x_to, y_to):
            return self.calculate_theoretical_semivariance(
                h_dists, (x_from, y_from, x_to, y_to), structures
            )

        # -- Pool of candidate points (optionally excluding one) ---------------
        n_all = len(values)
        all_idx = np.arange(n_all)
        if exclude_index is not None:
            all_idx = all_idx[all_idx != exclude_index]

        X_pool = X_known[all_idx]
        Y_pool = Y_known[all_idx]
        V_pool = values[all_idx]

        # -- Search ellipse ----------------------------------------------------
        dx_pts = X_pool - x_node
        dy_pts = Y_pool - y_node
        dists  = np.sqrt(dx_pts**2 + dy_pts**2)

        az_rad     = np.radians(search_azimuth)
        dx_rot     =  dx_pts * np.cos(az_rad) + dy_pts * np.sin(az_rad)
        dy_rot     = -dx_pts * np.sin(az_rad) + dy_pts * np.cos(az_rad)
        r_min_safe = search_r_min if search_r_min > 0 else search_r_max
        in_ellipse = ((dx_rot / search_r_max)**2 + (dy_rot / r_min_safe)**2) <= 1.0
        sel        = np.where(in_ellipse)[0]
        candidate_idx = all_idx[sel]  # all points inside the ellipse, pre-filtering

        # -- Octant search -----------------------------------------------------
        if use_octants and len(sel) > 0:
            angles     = np.degrees(np.arctan2(dy_pts[sel], dx_pts[sel])) % 360.0
            oct_ids    = (angles // 45).astype(int)
            kept       = []
            for oct_id in range(8):
                oct_pts = sel[oct_ids == oct_id]
                if len(oct_pts) < min_per_octant:
                    continue
                kept.append(oct_pts[np.argsort(dists[oct_pts])])
            sel = np.concatenate(kept) if kept else np.array([], dtype=int)

        # -- Min / max filter --------------------------------------------------
        n_sel = len(sel)
        if n_sel < pts_min:
            return (NO_VALUE, NO_VALUE, None) if return_details else (NO_VALUE, NO_VALUE)

        if n_sel > pts_max:
            sel   = sel[np.argsort(dists[sel])[:pts_max]]
            n_sel = pts_max

        # -- Local subset ------------------------------------------------------
        X_loc = X_pool[sel]
        Y_loc = Y_pool[sel]
        V_loc = V_pool[sel]
        D_loc = dists[sel]

        dists_loc   = np.sqrt((X_loc[:, None]-X_loc[None,:])**2 +
                              (Y_loc[:, None]-Y_loc[None,:])**2)
        Gamma_A_loc = get_cov_or_semi(
            dists_loc,
            X_loc[:, None], Y_loc[:, None],
            X_loc[None, :], Y_loc[None, :]
        )
        Gamma_B = get_cov_or_semi(D_loc, X_loc, Y_loc, x_node, y_node)

        # -- Solve the kriging system ------------------------------------------
        try:
            if is_ok:
                nc    = n_sel + 1
                A_loc = np.zeros((nc, nc))
                A_loc[:n_sel, :n_sel] = Gamma_A_loc
                A_loc[n_sel,  :n_sel] = 1.0
                A_loc[:n_sel,  n_sel] = 1.0
                B_vec = np.zeros(nc)
                B_vec[:n_sel] = Gamma_B
                B_vec[n_sel]  = 1.0
                sol           = np.linalg.solve(A_loc, B_vec)
                weights       = sol[:n_sel]
                lagrange_mu   = sol[n_sel]
                est_val       = np.sum(weights * V_loc)
                krig_var      = np.sum(weights * Gamma_B) + lagrange_mu

            elif is_uk:
                nc    = n_sel + 3
                A_loc = np.zeros((nc, nc))
                A_loc[:n_sel, :n_sel]   = Gamma_A_loc
                A_loc[n_sel,   :n_sel]  = 1.0
                A_loc[:n_sel,   n_sel]  = 1.0
                A_loc[n_sel+1, :n_sel]  = X_loc
                A_loc[:n_sel,  n_sel+1] = X_loc
                A_loc[n_sel+2, :n_sel]  = Y_loc
                A_loc[:n_sel,  n_sel+2] = Y_loc
                B_vec = np.zeros(nc)
                B_vec[:n_sel]  = Gamma_B
                B_vec[n_sel]   = 1.0
                B_vec[n_sel+1] = x_node
                B_vec[n_sel+2] = y_node
                sol            = np.linalg.solve(A_loc, B_vec)
                weights        = sol[:n_sel]
                lagrange_mu    = sol[n_sel]
                est_val        = np.sum(weights * V_loc)
                krig_var       = np.sum(weights * Gamma_B) + lagrange_mu

            else:  # Simple Kriging
                C_loc   = self.get_covariance(dists_loc, 0.0, structures)
                cov_B   = self.get_covariance(D_loc,     0.0, structures)
                weights = np.linalg.solve(C_loc, cov_B)
                est_val = mean_value + np.sum(weights * (V_loc - mean_value))
                krig_var = self.get_total_sill(structures) - np.sum(weights * cov_B)

        except np.linalg.LinAlgError:
            return (NO_VALUE, NO_VALUE, None) if return_details else (NO_VALUE, NO_VALUE)

        if return_details:
            details = {
                'neighbor_idx':   all_idx[sel],
                'neighbor_x':     X_loc,
                'neighbor_y':     Y_loc,
                'weights':        weights,
                'candidate_idx':  candidate_idx,
            }
            return float(est_val), float(max(0.0, krig_var)), details

        return float(est_val), float(max(0.0, krig_var))


    # =========================================================================
    # Cross-validation neighbourhood optimization
    # =========================================================================

    # Definition of the seven optimizable parameters: widget name, display
    # label, type ('int', 'float', 'bool') and automatic bounds.
    # Auto bounds for the two search radii are computed at run-time from the
    # data extent; all other auto bounds are hard-coded here.
    _CK_OPT_PARAMS = [
        {'label': 'Min points',     'widget': 'spinBox_kriging_num_points_min',  'type': 'int',   'auto_min': 2,   'auto_max': 10},
        {'label': 'Max points',     'widget': 'spinBox_kriging_num_points_max',  'type': 'int',   'auto_min': 4,   'auto_max': 25},
        {'label': 'Search R max',   'widget': 'doubleSpinBox_searchR_max',       'type': 'float', 'auto_min': None,'auto_max': None},
        {'label': 'Search R min',   'widget': 'doubleSpinBox_searchR_min',       'type': 'float', 'auto_min': None,'auto_max': None},
        {'label': 'Azimuth',        'widget': 'doubleSpinBox_search_azimuth',    'type': 'float', 'auto_min': 0,   'auto_max': 180},
        {'label': 'Octant search',  'widget': 'checkBox_octant_search',          'type': 'bool',  'auto_min': 0,   'auto_max': 1},
        {'label': 'Min pts/octant', 'widget': 'spinBox_min_point_per_octant',    'type': 'int',   'auto_min': 1,   'auto_max': 4},
    ]
    _CK_OPT_COLS = ['Parameter', 'Current value', 'Use', 'Auto', 'Min', 'Max']
    # Column indices
    _COL_NAME, _COL_CUR, _COL_USE, _COL_AUTO, _COL_MIN, _COL_MAX = 0, 1, 2, 3, 4, 5

    def _setup_ck_optimization_table(self):
        """Populate tableView_cross_kriging_neigh_optimization with one row per
        optimizable neighbourhood parameter.

        Columns:
          0 - Parameter name (read-only)
          1 - Current value  (read-only, refreshed at optimization time)
          2 - Use  (QCheckBox, checked = include in search, default ON)
          3 - Auto (QCheckBox, checked = plugin chooses bounds automatically)
          4 - Min  (editable QTableWidgetItem, enabled only when Auto is OFF)
          5 - Max  (editable QTableWidgetItem, enabled only when Auto is OFF)
        """
        tw = self.tableView_cross_kriging_neigh_optimization
        # tableView_cross_kriging_neigh_optimization must actually be a
        # QTableWidget (not a QTableView) to support setCellWidget.
        # If the designer placed a QTableView, swap it here at run-time.
        if isinstance(tw, QtWidgets.QTableView) and not isinstance(tw, QtWidgets.QTableWidget):
            parent  = tw.parentWidget()
            geom    = tw.geometry()
            new_tw  = QtWidgets.QTableWidget(parent)
            new_tw.setGeometry(geom)
            new_tw.setObjectName('tableView_cross_kriging_neigh_optimization')
            new_tw.show()
            tw.hide()
            self.tableView_cross_kriging_neigh_optimization = new_tw
            tw = new_tw

        n_rows = len(self._CK_OPT_PARAMS)
        tw.setRowCount(n_rows)
        tw.setColumnCount(len(self._CK_OPT_COLS))
        tw.setHorizontalHeaderLabels(self._CK_OPT_COLS)
        tw.horizontalHeader().setStretchLastSection(True)
        tw.verticalHeader().setVisible(False)
        tw.setEditTriggers(QtWidgets.QAbstractItemView.AllEditTriggers)

        for row, param in enumerate(self._CK_OPT_PARAMS):
            # -- Col 0: parameter name ----------------------------------------
            name_item = QtWidgets.QTableWidgetItem(param['label'])
            name_item.setFlags(QtCore.Qt.ItemIsEnabled)
            tw.setItem(row, self._COL_NAME, name_item)

            # -- Col 1: current value -----------------------------------------
            widget_obj = getattr(self, param['widget'], None)
            cur_val    = self._ck_read_widget(widget_obj, param['type'])
            cur_item   = QtWidgets.QTableWidgetItem(str(cur_val))
            cur_item.setFlags(QtCore.Qt.ItemIsEnabled)
            tw.setItem(row, self._COL_CUR, cur_item)

            # -- Col 2: Use checkbox ------------------------------------------
            chk_use = QtWidgets.QCheckBox()
            chk_use.setChecked(True)
            chk_use.setToolTip("Include this parameter in the optimization search")
            use_cell = QtWidgets.QWidget()
            use_lay  = QtWidgets.QHBoxLayout(use_cell)
            use_lay.addWidget(chk_use); use_lay.setAlignment(QtCore.Qt.AlignCenter)
            use_lay.setContentsMargins(0, 0, 0, 0)
            tw.setCellWidget(row, self._COL_USE, use_cell)

            # -- Col 3: Auto checkbox -----------------------------------------
            chk_auto = QtWidgets.QCheckBox()
            chk_auto.setChecked(True)
            chk_auto.setToolTip("Let the plugin set the search bounds automatically")
            auto_cell = QtWidgets.QWidget()
            auto_lay  = QtWidgets.QHBoxLayout(auto_cell)
            auto_lay.addWidget(chk_auto); auto_lay.setAlignment(QtCore.Qt.AlignCenter)
            auto_lay.setContentsMargins(0, 0, 0, 0)
            tw.setCellWidget(row, self._COL_AUTO, auto_cell)

            # -- Col 4 & 5: Min / Max -----------------------------------------
            for col in (self._COL_MIN, self._COL_MAX):
                item = QtWidgets.QTableWidgetItem("")
                # Grayed out until Auto is unchecked
                item.setFlags(QtCore.Qt.ItemIsEnabled)
                item.setForeground(QtGui.QBrush(QtGui.QColor(180, 180, 180)))
                tw.setItem(row, col, item)

            # Wire Auto toggle to enable/disable Min & Max cells
            def _make_toggle(r, chk_a, chk_u):
                def _toggle(_=None):
                    locked = chk_a.isChecked() or not chk_u.isChecked()
                    for c in (self._COL_MIN, self._COL_MAX):
                        it = self.tableView_cross_kriging_neigh_optimization.item(r, c)
                        if it is None:
                            continue
                        if locked:
                            it.setFlags(QtCore.Qt.ItemIsEnabled)
                            it.setForeground(QtGui.QBrush(QtGui.QColor(180, 180, 180)))
                        else:
                            it.setFlags(QtCore.Qt.ItemIsEnabled | QtCore.Qt.ItemIsEditable |
                                        QtCore.Qt.ItemIsSelectable)
                            it.setForeground(QtGui.QBrush(QtGui.QColor(0, 0, 0)))
                return _toggle
            _fn = _make_toggle(row, chk_auto, chk_use)
            chk_auto.stateChanged.connect(_fn)
            chk_use.stateChanged.connect(_fn)

        tw.resizeColumnsToContents()

    @staticmethod
    def _ck_read_widget(widget, ptype):
        """Read the current value of a GUI widget as the correct Python type."""
        if widget is None:
            return 0
        if ptype == 'bool':
            return bool(widget.isChecked())
        elif ptype == 'int':
            return int(widget.value())
        else:
            return float(widget.value())

    @staticmethod
    def _ck_sample(ptype, lo, hi):
        """Draw one random sample within [lo, hi] with the correct type."""
        import random
        if ptype == 'bool':
            return bool(random.random() < 0.5)
        elif ptype == 'int':
            return random.randint(int(lo), int(hi))
        else:
            return lo + random.random() * (hi - lo)

    def _run_cv_sse(self, coords, values, structures,
                    is_ok, is_sk, is_uk,
                    search_r_max, search_r_min, search_azimuth,
                    use_octants, min_per_octant, pts_min, pts_max,
                    mean_value, sample_variance, NO_VALUE=-9999.0):
        """Leave-one-out cross-validation; returns (SSE, n_valid).

        If any point cannot be estimated (returns NO_VALUE), the function
        immediately returns (inf, n_valid_so_far) so that configurations
        which skip points are never selected as best during optimization.
        This prevents a spurious SSE improvement caused by fewer pairs
        rather than a genuinely better neighbourhood geometry.
        """
        n = len(values)
        X = coords[:, 0]
        Y = coords[:, 1]
        sse, n_valid = 0.0, 0
        for i in range(n):
            est, _var = self._estimate_single_point(
                float(X[i]), float(Y[i]), X, Y, values,
                is_ok, is_sk, is_uk, structures,
                search_r_max, search_r_min, search_azimuth,
                use_octants, min_per_octant, pts_min, pts_max,
                mean_value, sample_variance, NO_VALUE,
                exclude_index=i, return_details=False,
            )
            if est == NO_VALUE:
                # At least one point could not be estimated: penalise heavily
                # so this candidate is never chosen as the optimum.
                return float('inf'), n_valid
            sse    += (float(values[i]) - est) ** 2
            n_valid += 1
        return sse, n_valid

    def _read_seed_field(self, line_edit, label):
        """Read an integer seed from a QLineEdit. Returns (ok, seed).
        An empty field gets a random seed, which is written back in the field so that
        the run can be repeated exactly."""
        txt = line_edit.text().strip()
        if not txt:
            import random
            seed = random.SystemRandom().randrange(1, 2 ** 31)
            line_edit.setText(str(seed))
            return True, seed
        try:
            return True, int(txt)
        except ValueError:
            QtWidgets.QMessageBox.warning(
                self, "Seed", "%s must be an integer number." % label)
            return False, None

    def _ck_opt_read_setup(self, warn_default_model=True):
        """Read from the GUI everything the neighbourhood optimisation needs: the data,
        the kriging type, the variogram model and the bounds of the parameters to search.
        Returns a dict, or None (after showing a message) if something is missing."""
        # -- 1. Check prerequisites -------------------------------------------
        layer      = self.mMapLayerComboBox.currentLayer()
        field_name = self.mFieldComboBox.currentField()
        if not layer or not field_name:
            QtWidgets.QMessageBox.critical(self, "Error",
                "Please select a valid point layer and field first.")
            return None
        if warn_default_model and not self.variogram_computed:
            QtWidgets.QMessageBox.warning(self, "Warning",
                "No variogram model computed. The optimization will use the current "
                "(possibly default) model parameters.")

        # -- 2. Load data -----------------------------------------------------
        coords, values = [], []
        for f in layer.getFeatures():
            if not f.hasGeometry():
                continue
            val = f[field_name]
            if val == NULL or val is None:
                continue
            try:
                pt = f.geometry().asPoint()
                coords.append([pt.x(), pt.y()])
                values.append(float(val))
            except (ValueError, TypeError):
                continue

        if len(values) < 3:
            QtWidgets.QMessageBox.critical(self, "Error",
                "At least 3 valid points are required.")
            return None

        coords  = np.array(coords)
        values  = np.array(values)

        # Kriging type and fixed parameters
        structures      = self.get_models_from_table()
        sample_variance = float(np.var(values))
        mean_value      = self.doubleSpinBox_mean_sk.value()
        is_uk = self.radioButton_UniversalKriging.isChecked()
        is_sk = self.radioButton_SimpleKriging.isChecked()
        is_ok = self.radioButton_OrdinaryKriging.isChecked()

        # -- 3. Read optimization table settings ------------------------------
        tw = self.tableView_cross_kriging_neigh_optimization

        # Compute automatic bounds for the two radii from the data extent
        x_extent = float(np.max(coords[:, 0]) - np.min(coords[:, 0]))
        y_extent = float(np.max(coords[:, 1]) - np.min(coords[:, 1]))
        diag     = float(np.sqrt(x_extent**2 + y_extent**2))
        r_auto_min = diag * 0.05
        r_auto_max = diag * 0.50

        # Fill auto bounds for radius rows
        for param in self._CK_OPT_PARAMS:
            if param['widget'] == 'doubleSpinBox_searchR_max':
                param['auto_min'] = r_auto_min
                param['auto_max'] = r_auto_max
            elif param['widget'] == 'doubleSpinBox_searchR_min':
                param['auto_min'] = r_auto_min * 0.1
                param['auto_max'] = r_auto_max

        # Read current fixed values (used when Use=OFF)
        fixed = {}
        for param in self._CK_OPT_PARAMS:
            w = getattr(self, param['widget'], None)
            fixed[param['widget']] = self._ck_read_widget(w, param['type'])

        # Build per-parameter config: {widget_name: {'use', 'lo', 'hi', 'type'}}
        param_cfg = {}
        for row, param in enumerate(self._CK_OPT_PARAMS):
            wname = param['widget']
            ptype = param['type']

            # Read Use checkbox
            use_cell = tw.cellWidget(row, self._COL_USE)
            chk_use  = use_cell.findChild(QtWidgets.QCheckBox) if use_cell else None
            use      = chk_use.isChecked() if chk_use else False

            if not use:
                param_cfg[wname] = {'use': False, 'type': ptype}
                continue

            # Read Auto checkbox
            auto_cell = tw.cellWidget(row, self._COL_AUTO)
            chk_auto  = auto_cell.findChild(QtWidgets.QCheckBox) if auto_cell else None
            auto      = chk_auto.isChecked() if chk_auto else True

            if auto:
                lo = param['auto_min']
                hi = param['auto_max']
            else:
                try:
                    lo = float(tw.item(row, self._COL_MIN).text())
                    hi = float(tw.item(row, self._COL_MAX).text())
                except (ValueError, AttributeError):
                    lo = param['auto_min']
                    hi = param['auto_max']

            if lo is None or hi is None:
                lo, hi = r_auto_min, r_auto_max
            if hi < lo:
                lo, hi = hi, lo

            param_cfg[wname] = {'use': True, 'lo': lo, 'hi': hi, 'type': ptype}

        # Active parameters, in a stable order
        active_params = [(wname, cfg) for wname, cfg in param_cfg.items() if cfg['use']]
        return {
            'coords': coords, 'values': values, 'structures': structures,
            'sample_variance': sample_variance, 'mean_value': mean_value,
            'is_ok': is_ok, 'is_sk': is_sk, 'is_uk': is_uk,
            'fixed': fixed, 'param_cfg': param_cfg, 'active_params': active_params,
            'NO_VAL': -9999.0, 'tw': tw,
        }

    def _ck_opt_search(self, setup, n_trials, rng, progress_cb=None,
                       include_warm_start=True, stop_cb=None, process_events=True):
        """Latin Hypercube search of the neighbourhood parameters (n_trials trials).

        The [lo, hi] interval of every active parameter is divided into n_trials equal
        strata and one sample is drawn from each; the columns are then shuffled
        independently. rng is a random.Random instance (the seed makes the search
        repeatable). Candidate 0 is the current set of parameters (warm start), which
        is skipped if include_warm_start is False. Every candidate is evaluated by the
        leave-one-out SSE (_run_cv_sse). Returns a dict with the best solution among
        those that estimate all the points (best_*), and the fallback (fallback_*) used
        when none does; 'completed' is False if stop_cb() interrupted the search.
        progress_cb(iteration, n_trials) is called after every candidate.
        """
        coords, values = setup['coords'], setup['values']
        fixed, active_params = setup['fixed'], setup['active_params']

        # Build LHS strata for each active parameter
        strata = []
        for _wname, cfg in active_params:
            lo, hi, ptype = cfg['lo'], cfg['hi'], cfg['type']
            col = []
            for k in range(n_trials):
                # sample uniformly within stratum k
                u = (k + rng.random()) / n_trials
                v = lo + u * (hi - lo)
                if ptype == 'int':
                    v = int(round(lo + u * (hi - lo)))
                    v = max(int(lo), min(int(hi), v))
                elif ptype == 'bool':
                    v = bool(u > 0.5)
                col.append(v)
            rng.shuffle(col)
            strata.append(col)

        best_sse      = float('inf')
        best_params   = None
        fallback_valid  = -1
        fallback_sse    = float('inf')
        fallback_params = None
        completed = True

        for iteration in range(0 if include_warm_start else 1, n_trials + 1):
            if stop_cb is not None and stop_cb():
                completed = False
                break
            candidate = dict(fixed)

            if iteration == 0:
                # Warm-start: test the current widget values as-is
                pass
            else:
                # Apply the LHS sample for this iteration (0-indexed into strata)
                idx = iteration - 1
                for p_idx, (wname, _cfg) in enumerate(active_params):
                    candidate[wname] = strata[p_idx][idx]

            # Enforce logical constraints
            pmin = candidate['spinBox_kriging_num_points_min']
            pmax = candidate['spinBox_kriging_num_points_max']
            if pmin > pmax:
                pmin, pmax = pmax, pmin
            candidate['spinBox_kriging_num_points_min'] = pmin
            candidate['spinBox_kriging_num_points_max'] = pmax

            rmax = candidate['doubleSpinBox_searchR_max']
            rmin = candidate['doubleSpinBox_searchR_min']
            if rmin > rmax:
                rmin, rmax = rmax, rmin
            candidate['doubleSpinBox_searchR_max'] = rmax
            candidate['doubleSpinBox_searchR_min'] = rmin

            use_oct = bool(candidate['checkBox_octant_search'])
            mpo     = candidate['spinBox_min_point_per_octant']

            sse, n_valid = self._run_cv_sse(
                coords, values, setup['structures'],
                setup['is_ok'], setup['is_sk'], setup['is_uk'],
                float(rmax), float(rmin),
                float(candidate['doubleSpinBox_search_azimuth']),
                use_oct, int(mpo),
                int(pmin), int(pmax),
                setup['mean_value'], setup['sample_variance'], setup['NO_VAL'],
            )

            # Level-1: all n points estimated
            if sse < float('inf') and sse < best_sse:
                best_sse    = sse
                best_params = dict(candidate)

            # Level-2 fallback: most points estimated, then lowest SSE
            if n_valid > fallback_valid or (
                    n_valid == fallback_valid and sse < fallback_sse):
                fallback_valid  = n_valid
                fallback_sse    = sse
                fallback_params = dict(candidate)

            if progress_cb is not None:
                progress_cb(iteration, n_trials)
            if process_events and iteration % 5 == 0:
                QtWidgets.QApplication.processEvents()

        return {'best_sse': best_sse, 'best_params': best_params,
                'fallback_valid': fallback_valid, 'fallback_sse': fallback_sse,
                'fallback_params': fallback_params, 'completed': completed}

    def run_ck_neighborhood_optimization(self):
        """Random-search optimization of the kriging neighbourhood parameters
        by minimizing the leave-one-out cross-validation SSE.

        Only configurations where ALL data points can be estimated are
        considered valid. Any candidate that leaves at least one point
        unestimated receives a penalty of inf and is discarded, preventing
        a spurious SSE reduction caused by skipping difficult points.

        Algorithm
        ---------
        1. Read which parameters to optimize and their bounds from the
           optimization table.
        2. Run N_ITER random trials, each with a random combination of the
           active parameters sampled within their bounds.
        3. For each trial evaluate the LOO-CV SSE via _run_cv_sse().
        4. Write the best parameter set back to the neighbourhood widgets.
        """
        import random

        # Number of Latin Hypercube trials ("starting points"), chosen by the user
        # in spinBoxstarting_points (the GUI default is 80). Guard against 0.
        N_ITER = max(1, int(self.spinBoxstarting_points.value()))

        # Seed of the Latin Hypercube sample plan (lineEdit_seed): the same seed
        # gives the same trials, so the result can be repeated. Empty = random seed,
        # which is written in the field.
        ok, seed = self._read_seed_field(self.lineEdit_seed, "Seed")
        if not ok:
            return

        # -- 1-3. Prerequisites, data, kriging type and parameter bounds -------
        setup = self._ck_opt_read_setup(warn_default_model=True)
        if setup is None:
            return
        coords = setup['coords']
        values = setup['values']
        tw     = setup['tw']
        fixed  = setup['fixed']

        # -- 4. Update "Current value" column before starting -----------------
        for row, param in enumerate(self._CK_OPT_PARAMS):
            cur_item = tw.item(row, self._COL_CUR)
            if cur_item is not None:
                cur_item.setText(str(fixed[param['widget']]))

        # -- 5-6. Latin Hypercube sample plan and optimisation loop -----------
        pb = self.progressBar_CK_opt if hasattr(self, 'progressBar_CK_opt') else None
        if pb:
            pb.setValue(0)

        def _progress(iteration, total):
            if pb:
                pb.setValue(int(iteration / total * 100))

        res = self._ck_opt_search(setup, N_ITER, random.Random(seed),
                                  progress_cb=_progress, include_warm_start=True)
        best_sse        = res['best_sse']
        best_params     = res['best_params']
        fallback_valid  = res['fallback_valid']
        fallback_sse    = res['fallback_sse']
        fallback_params = res['fallback_params']

        if pb:
            pb.setValue(100)

        # -- 6. Select the solution to apply ----------------------------------
        if best_params is not None:
            chosen       = best_params
            chosen_sse   = best_sse
            chosen_valid = len(values)
            level_msg    = "All points were estimated."
        elif fallback_params is not None:
            chosen       = fallback_params
            chosen_sse   = fallback_sse
            chosen_valid = fallback_valid
            level_msg    = (
                f"Warning: no configuration estimated all {len(values)} points.\n"
                f"Best result: {chosen_valid}/{len(values)} points estimated.\n"
                "Consider enlarging the search radius bounds or reducing\n"
                "Min points in the optimization table."
            )
        else:
            QtWidgets.QMessageBox.warning(self, "Optimization",
                "No valid cross-validation result was obtained.\n"
                "Check the variogram model and the parameter bounds.")
            return

        # -- 7. Write best parameters back to the GUI widgets -----------------
        # Temporarily expand spinbox limits so values are never silently
        # clamped: a clamped value would differ from what was tested and
        # could produce unestimated points in the subsequent cross-validation.
        def _set_spinbox(sb, value):
            """Set value on a QSpinBox or QDoubleSpinBox, expanding limits."""
            lo = sb.minimum()
            hi = sb.maximum()
            if value < lo:
                sb.setMinimum(value if isinstance(value, int)
                              else value - abs(value) * 0.01)
            if value > hi:
                sb.setMaximum(value if isinstance(value, int)
                              else value + abs(value) * 0.01)
            sb.setValue(value)

        spinbox_map = {
            'spinBox_kriging_num_points_min':
                (self.spinBox_kriging_num_points_min, int),
            'spinBox_kriging_num_points_max':
                (self.spinBox_kriging_num_points_max, int),
            'doubleSpinBox_searchR_max':
                (self.doubleSpinBox_searchR_max, float),
            'doubleSpinBox_searchR_min':
                (self.doubleSpinBox_searchR_min, float),
            'doubleSpinBox_search_azimuth':
                (self.doubleSpinBox_search_azimuth, float),
            'spinBox_min_point_per_octant':
                (self.spinBox_min_point_per_octant, int),
        }
        for wname, (sb, cast) in spinbox_map.items():
            if wname in chosen:
                try:
                    _set_spinbox(sb, cast(chosen[wname]))
                except Exception:
                    pass

        # Checkbox does not have limits to worry about
        if 'checkBox_octant_search' in chosen:
            try:
                self.checkBox_octant_search.setChecked(
                    bool(chosen['checkBox_octant_search']))
            except Exception:
                pass

        # Update "Current value" column with the winning values
        for row, param in enumerate(self._CK_OPT_PARAMS):
            cur_item = tw.item(row, self._COL_CUR)
            if cur_item is not None:
                cur_item.setText(str(chosen.get(param['widget'], '')))

        QtWidgets.QMessageBox.information(
            self, "Optimization complete",
            f"{level_msg}\n\n"
            f"Cross-validation SSE: "
            f"{'N/A' if chosen_sse == float('inf') else f'{chosen_sse:.6f}'}\n"
            f"Points estimated: {chosen_valid}/{len(values)}\n"
            f"({N_ITER} Latin Hypercube trials + 1 warm-start, seed {seed})\n\n"
            "The kriging neighbourhood widgets have been updated.\n"
            "Run cross-validation again to confirm the result."
        )

    def export_cross_kriging_to_csv(self):
        """Export the leave-one-out cross-kriging table to a CSV file.

        The rows are exactly those shown in tableView_cross_kriging (one per
        input point, in the same order), at full numerical precision instead of
        the 6 decimals used for display. Columns:

            x, y                 - coordinates of the point
            true_value           - observed value
            estimated            - leave-one-out kriging estimate
            krig_variance        - kriging variance
            error                - true_value - estimated
            error2               - error squared
            error2_over_variance - error2 / krig_variance (the table colours a
                                   row green when this is <= 1, red otherwise)

        Points that could not be estimated (shown as "N/A" in the table) are
        written with empty cells. Delimiter: comma; decimal separator: dot.
        """
        results = getattr(self, '_cross_val_results', None)
        if not results:
            QtWidgets.QMessageBox.warning(
                self, "Export cross-kriging",
                "No cross-kriging results are available yet.\n"
                "Please run Calculate first.")
            return

        # -- 1. Build suggested filename (same convention as the other exports) --
        import datetime, re
        timestamp = datetime.datetime.now().strftime('%Y_%m_%d_%H_%M_%S')

        # Layer / field / kriging type of the LAST cross-validation run, not the
        # current combo box selection, which the user may have changed since.
        layer_name = getattr(self, '_cross_val_layer_name', 'layer')
        field_name = getattr(self, '_cross_val_field_name', 'variable')
        ktype      = getattr(self, '_cross_val_ktype', 'krig')

        def safe(s):
            return re.sub(r'[\\/:*?"<>|]', '_', s)

        suggested_name = (
            f"{timestamp}_{safe(layer_name)}_{safe(field_name)}_cross_kriging_{ktype}.csv"
        )

        settings  = QSettings()
        last_dir  = settings.value('GeostatisticsLab/export_dir',
                                   os.path.expanduser('~'))
        suggested = os.path.join(last_dir, suggested_name)

        # -- 2. Save dialog ------------------------------------------------------
        file_path, _ = QtWidgets.QFileDialog.getSaveFileName(
            self,
            "Export cross-kriging table to CSV",
            suggested,
            "CSV files (*.csv);;All files (*.*)"
        )
        if not file_path:
            return
        if not file_path.lower().endswith('.csv'):
            file_path += '.csv'
        settings.setValue('GeostatisticsLab/export_dir',
                          os.path.dirname(file_path))

        # -- 3. Write the file ---------------------------------------------------
        no_value = getattr(self, '_cross_val_NO_VALUE', -9999.0)

        def fmt(value):
            """Full-precision number, or an empty cell for NO_VALUE / NaN."""
            if value is None or value == no_value or not np.isfinite(value):
                return ''
            return '%.12g' % value

        try:
            # newline='' lets the csv module control line endings (no blank
            # lines on Windows); UTF-8 is used although the content is ASCII.
            with open(file_path, 'w', newline='', encoding='utf-8') as fh:
                writer = csv.writer(fh)
                writer.writerow(['x', 'y', 'true_value', 'estimated',
                                 'krig_variance', 'error', 'error2',
                                 'error2_over_variance'])
                for r in results:
                    writer.writerow([fmt(r['x']), fmt(r['y']), fmt(r['true']),
                                     fmt(r['estimated']), fmt(r['variance']),
                                     fmt(r['error']), fmt(r['error2']),
                                     fmt(r['ratio'])])
            QtWidgets.QMessageBox.information(
                self, "Export cross-kriging",
                f"Cross-kriging table exported successfully:\n{file_path}\n"
                f"({len(results)} rows)")
        except Exception as e:
            QtWidgets.QMessageBox.critical(
                self, "Export cross-kriging",
                f"Failed to save the CSV file:\n{str(e)}")

    def run_cross_validation(self):
        """Leave-one-out cross-validation: estimate each input point excluding itself,
        then populate tableView_cross_kriging, update label_cross_kriging_mean_error,
        and add a vector layer with the results to the QGIS project.
        """
        # 1. Preliminary check: has the user computed or adjusted the variogram model?
        if not self.variogram_computed:
            reply = QtWidgets.QMessageBox.warning(
                self, "Warning: Default Variogram",
                "You haven't computed or adjusted the variogram model for this layer yet.\n"
                "Using the default model parameters will likely produce incorrect estimations.\n\n"
                "Do you want to continue anyway?",
                QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
                QtWidgets.QMessageBox.No
            )
            if reply == QtWidgets.QMessageBox.No:
                self.tabWidget.setCurrentIndex(1)
                return

        # -- 2. Read input layer and field ------------------------------------
        layer      = self.mMapLayerComboBox.currentLayer()
        field_name = self.mFieldComboBox.currentField()
        if not layer or not field_name:
            QtWidgets.QMessageBox.critical(self, "Error", "Invalid point layer or field.")
            return

        coords, values, fids = [], [], []
        for f in layer.getFeatures():
            if f.hasGeometry():
                val = f[field_name]
                if val != NULL and val is not None:
                    try:
                        pt = f.geometry().asPoint()
                        coords.append([pt.x(), pt.y()])
                        values.append(float(val))
                        fids.append(f.id())
                    except (ValueError, TypeError):
                        continue

        coords = np.array(coords)
        values = np.array(values)
        n      = len(values)
        if n < 3:
            QtWidgets.QMessageBox.critical(self, "Error",
                "Cross-validation requires at least 3 points.")
            return

        X_known = coords[:, 0]
        Y_known = coords[:, 1]

        # -- 2. Read GUI parameters (same as run_kriging_interpolation) -------
        structures     = self.get_models_from_table()
        sample_variance = float(np.var(values))
        mean_value     = self.doubleSpinBox_mean_sk.value()
        is_uk          = self.radioButton_UniversalKriging.isChecked()
        is_sk          = self.radioButton_SimpleKriging.isChecked()
        is_ok          = self.radioButton_OrdinaryKriging.isChecked()
        search_r_max   = self.doubleSpinBox_searchR_max.value()
        search_r_min   = self.doubleSpinBox_searchR_min.value()
        search_azimuth = self.doubleSpinBox_search_azimuth.value()
        use_octants    = self.checkBox_octant_search.isChecked()
        min_per_octant = self.spinBox_min_point_per_octant.value()
        pts_min        = self.spinBox_kriging_num_points_min.value()
        pts_max        = self.spinBox_kriging_num_points_max.value()
        NO_VALUE       = -9999.0

        if is_ok:
            ktype = "ok"
        elif is_uk:
            ktype = "uk"
        else:
            ktype = "sk"

        # -- 3. Leave-one-out loop ---------------------------------------------
        results = []  # list of dicts, one per point
        self._cross_val_details = []  # list of detail-dicts (or None), one per point
        self.progressBarCrossKriging.setValue(0)

        # Start of the timed section (reported in CrossKriginComputingTime): the
        # leave-one-out estimation of all n points. The preliminary warning dialog
        # has already been answered, and no dialog is shown inside the loop.
        t_cv_start = time.perf_counter()
        for i in range(n):
            x_i, y_i, z_i = float(X_known[i]), float(Y_known[i]), float(values[i])
            est, var, details = self._estimate_single_point(
                x_i, y_i, X_known, Y_known, values,
                is_ok, is_sk, is_uk, structures,
                search_r_max, search_r_min, search_azimuth,
                use_octants, min_per_octant, pts_min, pts_max,
                mean_value, sample_variance, NO_VALUE,
                exclude_index=i, return_details=True
            )
            self._cross_val_details.append(details)
            if est == NO_VALUE:
                error = NO_VALUE
                error2 = NO_VALUE
                ratio  = NO_VALUE
            else:
                error  = z_i - est
                error2 = error ** 2
                ratio  = (error2 / var) if var > 0 else NO_VALUE
            results.append({
                'x': x_i, 'y': y_i,
                'true': z_i, 'estimated': est, 'variance': var,
                'error': error, 'error2': error2, 'ratio': ratio,
                'fid': fids[i]
            })
            self.progressBarCrossKriging.setValue(int((i + 1) / n * 100))
            if i % 10 == 0:
                QtWidgets.QApplication.processEvents()

        self.progressBarCrossKriging.setValue(100)

        # End of the timed section: show the elapsed time. This happens before the
        # table/vector-layer steps below, which may open a modal question dialog.
        self.last_cross_kriging_time_s = time.perf_counter() - t_cv_start
        self.CrossKriginComputingTime.setText(
            "Computing time: " + self._format_elapsed_time(self.last_cross_kriging_time_s))

        # Store data needed by the neighbor map / weights table navigation
        # (and by export_cross_kriging_to_csv)
        self._cross_val_layer_name = layer.name()
        self._cross_val_field_name = field_name
        self._cross_val_ktype      = ktype
        self._cross_val_results  = results
        self._cross_val_X        = X_known
        self._cross_val_Y        = Y_known
        self._cross_val_values   = values
        self._cross_val_NO_VALUE = NO_VALUE
        self._cross_val_current_idx = 0


        # -- 4. Populate tableView_cross_kriging -------------------------------
        headers = ['X', 'Y', 'True Value', 'Estimated', 'Krig. Variance',
                   'Error', 'Error2', 'Error2/Variance']
        model = QtGui.QStandardItemModel(n, len(headers))
        model.setHorizontalHeaderLabels(headers)

        valid_errors = [r['error'] for r in results if r['error'] != NO_VALUE]
        color_green = QtGui.QColor(198, 239, 206)  # light green
        color_red   = QtGui.QColor(255, 199, 206)  # light red

        for row, r in enumerate(results):
            # Determine row colour based on Error2/Variance (last column)
            ratio_val = r['ratio']
            if ratio_val != NO_VALUE:
                row_color = color_green if ratio_val <= 1.0 else color_red
            else:
                row_color = None

            for col, key in enumerate(['x', 'y', 'true', 'estimated',
                                       'variance', 'error', 'error2', 'ratio']):
                val = r[key]
                txt = f"{val:.6f}" if val != NO_VALUE else "N/A"
                item = QtGui.QStandardItem(txt)
                item.setEditable(False)
                if row_color is not None:
                    item.setBackground(QtGui.QBrush(row_color))
                model.setItem(row, col, item)

        self.tableView_cross_kriging.setModel(model)
        self.tableView_cross_kriging.resizeColumnsToContents()

        # -- 5. Summary labels -------------------------------------------------
        if valid_errors:
            mean_err = sum(valid_errors) / len(valid_errors)
            min_err  = min(valid_errors)
            max_err  = max(valid_errors)
            sse      = sum(e ** 2 for e in valid_errors)
            self.label_cross_kriging_mean_error.setText(
                f"Mean error: {mean_err:.6f}  (n={len(valid_errors)}/{n})"
            )
            self.label_min_max_error.setText(
                f"Min error: {min_err:.6f}    Max error: {max_err:.6f}    SSE: {sse:.6f}"
            )
        else:
            self.label_cross_kriging_mean_error.setText("Mean error: N/A (no valid estimates)")
            self.label_min_max_error.setText("Min error: N/A    Max error: N/A    SSE: N/A")

        # -- 6. Add / update vector layer in QGIS project ---------------------
        # Only proceed if the user wants the vector layer created
        if self.checkBox_create_vector_cross_kriging.isChecked():
            base_name   = f"{field_name}_cross_kriging_{ktype}"
            crs_wkt     = layer.crs().toWkt()
            target_name = base_name

            # Check if a layer with this name already exists
            existing = [l for l in QgsProject.instance().mapLayers().values()
                        if l.name() == target_name]
            if existing:
                reply = QtWidgets.QMessageBox.question(
                    self, "Layer Already Exists",
                    f"A layer named '{target_name}' already exists in the project.\n\n"
                    "Overwrite it, or create a new numbered copy?",
                    QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No | QtWidgets.QMessageBox.Cancel,
                    QtWidgets.QMessageBox.Cancel
                )
                if reply == QtWidgets.QMessageBox.Cancel:
                    return
                elif reply == QtWidgets.QMessageBox.Yes:
                    QgsProject.instance().removeMapLayer(existing[0].id())
                else:
                    # Auto-increment name
                    counter = 1
                    while any(l.name() == f"{base_name}_{counter}"
                              for l in QgsProject.instance().mapLayers().values()):
                        counter += 1
                    target_name = f"{base_name}_{counter}"

            # Create memory vector layer
            crs_wkt = layer.crs().toWkt()
            vl = QgsVectorLayer(f"Point?crs={crs_wkt}", target_name, "memory")
            pr = vl.dataProvider()
            pr.addAttributes([
                QgsField("x",          QVariant.Double),
                QgsField("y",          QVariant.Double),
                QgsField("true_val",   QVariant.Double),
                QgsField("estimated",  QVariant.Double),
                QgsField("krig_var",   QVariant.Double),
                QgsField("error",      QVariant.Double),
                QgsField("error2",     QVariant.Double),
                QgsField("err2_var",   QVariant.Double),
            ])
            vl.updateFields()

            feats = []
            for r in results:
                feat = QgsFeature()
                feat.setGeometry(QgsGeometry.fromPointXY(QgsPointXY(r['x'], r['y'])))
                def _v(k):
                    v = r[k]
                    return None if v == NO_VALUE else v
                feat.setAttributes([
                    r['x'], r['y'],
                    _v('true'), _v('estimated'), _v('variance'),
                    _v('error'), _v('error2'), _v('ratio')
                ])
                feats.append(feat)

            pr.addFeatures(feats)
            vl.updateExtents()
            QgsProject.instance().addMapLayer(vl)

            # -- Apply Turbo graduated colour ramp on the "error" field ------
            from qgis.core import (QgsGraduatedSymbolRenderer, QgsRendererRange,
                                   QgsSymbol, QgsGradientColorRamp,
                                   QgsGradientStop, QgsClassificationEqualInterval)
            from qgis.PyQt.QtGui import QColor

            # Turbo colour ramp (Google / Matplotlib) - 8 anchor stops
            turbo_stops = [
                (0.000, QColor(  48,  18,  59)),
                (0.143, QColor(  75, 120, 168)),
                (0.286, QColor(  35, 196, 186)),
                (0.429, QColor(  98, 230,  81)),
                (0.571, QColor( 218, 220,  24)),
                (0.714, QColor( 253, 141,  33)),
                (0.857, QColor( 220,  57,  20)),
                (1.000, QColor( 122,   4,   3)),
            ]
            gradient_stops = [QgsGradientStop(pos, col)
                              for pos, col in turbo_stops[1:-1]]
            ramp = QgsGradientColorRamp(
                turbo_stops[0][1],   # color1 (start)
                turbo_stops[-1][1],  # color2 (end)
                False,
                gradient_stops
            )

            # Compute min/max of the error field from features
            err_vals = [r['error'] for r in results if r['error'] != NO_VALUE]
            if err_vals:
                err_min, err_max = min(err_vals), max(err_vals)
                n_classes = 10
                step = (err_max - err_min) / n_classes if err_max != err_min else 1.0

                ranges = []
                for k in range(n_classes):
                    lo  = err_min + k * step
                    hi  = err_min + (k + 1) * step
                    t   = k / (n_classes - 1) if n_classes > 1 else 0.5
                    col = ramp.color(t)
                    sym = QgsSymbol.defaultSymbol(vl.geometryType())
                    sym.setColor(col)
                    sym.setSize(3.0)
                    ranges.append(QgsRendererRange(lo, hi,
                                                   sym, f"{lo:.3f} - {hi:.3f}"))

                renderer = QgsGraduatedSymbolRenderer("error", ranges)
                renderer.setSourceColorRamp(ramp)
                vl.setRenderer(renderer)
                vl.triggerRepaint()

            layer_msg = f"Layer '{target_name}' added to the project.\n"
        else:
            layer_msg = "Vector layer not added (checkbox unchecked).\n"

        # -- 7. Scatter plot: True vs Estimated -------------------------------
        self._plot_cross_validation_scatter(results, NO_VALUE)
        self._plot_cross_validation_map(results, NO_VALUE)

        # -- 7b. Weights table + neighbor map (first point selected by default)
        self._cross_val_field_name = field_name
        self._show_cross_val_point(0)

        QtWidgets.QMessageBox.information(
            self, "Cross-Validation Complete",
            f"Cross-validation finished.\n"
            f"{layer_msg}"
            f"Valid estimates: {len(valid_errors)}/{n}"
        )

    def _plot_cross_validation_scatter(self, results, NO_VALUE):
        """Draw a True vs Estimated scatter plot on the cross-validation canvas.

        Points above the 1:1 line (estimated > true) are red (overestimated).
        Points below the 1:1 line (estimated < true) are blue (underestimated).
        Both axes share the same range so the y = x line is always at 45 degrees.
        """
        # Collect valid pairs
        true_vals = []
        est_vals  = []
        for r in results:
            if r['true'] != NO_VALUE and r['estimated'] != NO_VALUE:
                true_vals.append(r['true'])
                est_vals.append(r['estimated'])

        self.figure_cross.clear()
        ax = self.figure_cross.add_subplot(111)

        if not true_vals:
            ax.set_title("No valid estimates to plot")
            self.canvas_cross.draw()
            return

        true_arr = np.array(true_vals)
        est_arr  = np.array(est_vals)

        # Equal axis limits with a small margin
        all_vals = np.concatenate([true_arr, est_arr])
        v_min, v_max = all_vals.min(), all_vals.max()
        margin = (v_max - v_min) * 0.05 if v_max != v_min else 1.0
        lim_lo = v_min - margin
        lim_hi = v_max + margin

        # Colour each point: red if estimated > true (above line), blue otherwise
        colors = np.where(est_arr > true_arr, '#d62728', '#1f77b4')

        ax.scatter(true_arr, est_arr, c=colors, s=30, alpha=0.75,
                   edgecolors='none', zorder=3)

        # 1:1 reference line (y = x) - always at 45 degrees because axes are equal
        ax.plot([lim_lo, lim_hi], [lim_lo, lim_hi],
                color='black', linewidth=1.2, linestyle='--',
                label='y = x', zorder=2)

        # Equal, square axes so the line is visually 45 degrees
        ax.set_xlim(lim_lo, lim_hi)
        ax.set_ylim(lim_lo, lim_hi)
        ax.set_aspect('equal', adjustable='box')

        ax.set_xlabel('True value', fontsize=9)
        ax.set_ylabel('Estimated value', fontsize=9)
        ax.set_title('Cross-Validation: True vs Estimated', fontsize=10)
        ax.legend(fontsize=8)
        ax.grid(True, linestyle=':', linewidth=0.5, alpha=0.6)

        # Compact layout
        self.figure_cross.tight_layout()
        self.canvas_cross.draw()

    def _plot_cross_validation_map(self, results, NO_VALUE):
        """Draw a spatial map of cross-validation results on canvas_cross_map.

        Each point is drawn as a circle where:
          - Fill colour  : diverging colormap on the error value
                           (blue = underestimated, white = 0, red = overestimated)
          - Edge colour  : green  if error^2 / variance <= 1  (good estimate)
                           red    if error^2 / variance >  1  (poor estimate)
          - Edge width   : 2 pt so the border is clearly visible
        Both spatial axes share the same scale (equal aspect) so the map is
        never stretched in either direction.
        """
        valid = [r for r in results if r['error'] != NO_VALUE]

        self.figure_cross_map.clear()
        ax = self.figure_cross_map.add_subplot(111)

        if not valid:
            ax.set_title("No valid estimates to map")
            self.canvas_cross_map.draw()
            return

        xs      = np.array([r['x']     for r in valid])
        ys      = np.array([r['y']     for r in valid])
        errors  = np.array([r['error'] for r in valid])
        ratios  = np.array([r['ratio'] if r['ratio'] != NO_VALUE else 0.0
                            for r in valid])

        # --- Fill colour: diverging scale centred on 0 ----------------------
        abs_max = np.abs(errors).max()
        if abs_max == 0:
            abs_max = 1.0
        norm = plt.Normalize(vmin=-abs_max, vmax=abs_max)
        cmap = plt.get_cmap('RdYlBu_r')   # blue<0, yellow~0, red>0
        fill_colors = cmap(norm(errors))

        # --- Edge colour: green if ratio <= 1, red if ratio > 1 -------------
        edge_colors = ['#e74c3c' if r > 1.0 else '#27ae60' for r in ratios]

        # --- Marker size: fixed, readable ------------------------------------
        marker_size = 60

        sc = ax.scatter(xs, ys,
                        c=fill_colors,
                        edgecolors=edge_colors,
                        linewidths=2.0,
                        s=marker_size,
                        zorder=3)

        # --- Equal spatial scale so geometry is never distorted -------------
        x_range = xs.max() - xs.min() if xs.max() != xs.min() else 1.0
        y_range = ys.max() - ys.min() if ys.max() != ys.min() else 1.0
        margin_x = x_range * 0.08
        margin_y = y_range * 0.08
        ax.set_xlim(xs.min() - margin_x, xs.max() + margin_x)
        ax.set_ylim(ys.min() - margin_y, ys.max() + margin_y)
        ax.set_aspect('equal', adjustable='datalim')

        # --- Colorbar for fill (error) ---------------------------------------
        sm = plt.cm.ScalarMappable(cmap=cmap, norm=norm)
        sm.set_array([])
        cbar = self.figure_cross_map.colorbar(sm, ax=ax, fraction=0.03, pad=0.04)
        cbar.set_label('Error (true - estimated)', fontsize=8)
        cbar.ax.tick_params(labelsize=7)

        # --- Legend for edge colour ------------------------------------------
        from matplotlib.lines import Line2D
        legend_elements = [
            Line2D([0], [0], marker='o', color='w', markerfacecolor='none',
                   markeredgecolor='#27ae60', markeredgewidth=2,
                   markersize=8, label='Error2/Var <= 1'),
            Line2D([0], [0], marker='o', color='w', markerfacecolor='none',
                   markeredgecolor='#e74c3c', markeredgewidth=2,
                   markersize=8, label='Error2/Var > 1'),
        ]
        ax.legend(handles=legend_elements, fontsize=7,
                  loc='upper left', framealpha=0.8)

        ax.set_xlabel('X', fontsize=8)
        ax.set_ylabel('Y', fontsize=8)
        ax.set_title('Cross-Validation Map', fontsize=10)
        ax.grid(True, linestyle=':', linewidth=0.4, alpha=0.5)
        ax.tick_params(axis='both', labelsize=7)

        self.figure_cross_map.tight_layout()
        self.canvas_cross_map.draw()

    # =========================================================================
    # Normal Score Transform
    # =========================================================================

    def _on_field_changed_nscore(self, field_name):
        """Update lineEdit_var_name_nscore_transform when the field changes."""
        if field_name:
            self.lineEdit_var_name_nscore_transform.setText(field_name + "_NSC_TRSF")
        else:
            self.lineEdit_var_name_nscore_transform.clear()

    def _on_raster_changed_backtransform(self, index):
        """Pre-fill lineEdit_raster_out when the raster combo changes."""
        raster_name = self.comboBox_raster.currentText().strip()
        if not raster_name:
            return
        base = raster_name + "_back_transformed"
        self.lineEdit_raster_out.setText(self._unique_filename(base))

    def _populate_nscore_layer_combo(self, *args, select_layer=None):
        """Populate comboBox_layer_table_nscore with all vector layers in the project.
        If select_layer is given, that layer is selected after populating."""
        if not hasattr(self, 'comboBox_layer_table_nscore'):
            return
        combo = self.comboBox_layer_table_nscore
        current_text = combo.currentText()
        combo.blockSignals(True)
        combo.clear()
        for lyr in QgsProject.instance().mapLayers().values():
            if isinstance(lyr, QgsVectorLayer) and lyr.isValid():
                combo.addItem(lyr.name(), lyr.id())
        # Select the requested layer, or restore previous selection
        target = select_layer.name() if select_layer else current_text
        idx = combo.findText(target)
        combo.setCurrentIndex(idx if idx >= 0 else 0)
        combo.blockSignals(False)
        # Cascade: update the variable combo for the now-selected layer
        self._populate_back_transform_variable_combo()

    def _populate_qqplot_ns_field_combo(self, *args):
        """Populate comboBox_qqplot_ns_field with fields of the layer currently
        selected in mMapLayerComboBox. Fields ending in '_NSC_TRSF' are listed
        first (most likely choice), followed by all other numeric-looking
        fields, so the combo is useful even on layers with a different
        naming convention."""
        if not hasattr(self, 'comboBox_qqplot_ns_field'):
            return
        combo = self.comboBox_qqplot_ns_field
        current_text = combo.currentText()
        combo.blockSignals(True)
        combo.clear()

        layer = self.mMapLayerComboBox.currentLayer()
        if layer is None:
            combo.blockSignals(False)
            return

        ns_fields, other_fields = [], []
        for field in layer.fields():
            if field.name().endswith("_NSC_TRSF"):
                ns_fields.append(field.name())
            elif field.typeName() not in ("String",):
                other_fields.append(field.name())

        for name in ns_fields + other_fields:
            combo.addItem(name)

        idx = combo.findText(current_text)
        combo.setCurrentIndex(idx if idx >= 0 else 0)
        combo.blockSignals(False)

    def run_qqplot_normality_check(self):
        """Draw side-by-side Q-Q plots for the originally selected field
        (mFieldComboBox) and its NS-transformed counterpart (chosen in
        comboBox_qqplot_ns_field), and report Shapiro-Wilk and
        Anderson-Darling normality test results for both in
        plainTextEdit_normality_test_result."""
        from scipy import stats as scipy_stats

        layer = self.mMapLayerComboBox.currentLayer()
        if layer is None:
            QtWidgets.QMessageBox.warning(self, "No Layer", "Please select a vector layer.")
            return

        field_orig = self.mFieldComboBox.currentField()
        field_ns = self.comboBox_qqplot_ns_field.currentText().strip()
        if not field_orig:
            QtWidgets.QMessageBox.warning(self, "No Field", "Please select a field in the variable combo.")
            return
        if not field_ns:
            QtWidgets.QMessageBox.warning(self, "No NS Field",
                "Please select the NS-transformed field to compare against.")
            return

        def collect_values(fname):
            vals = []
            for feat in layer.getFeatures():
                v = feat[fname]
                try:
                    if v is not None and v == v:  # skip None / NaN
                        vals.append(float(v))
                except (TypeError, ValueError):
                    continue
            return np.array(vals)

        vals_orig = collect_values(field_orig)
        vals_ns = collect_values(field_ns)

        if len(vals_orig) < 8 or len(vals_ns) < 8:
            QtWidgets.QMessageBox.critical(self, "Error",
                "Not enough valid values (need at least 8) to run a "
                "meaningful normality check.")
            return

        # --- Run normality tests on both variables -----------------------------
        def run_tests(vals):
            # Shapiro-Wilk: most reliable for small/medium samples; scipy
            # caps reliable behaviour around a few thousand points, which
            # covers typical geostatistical sample sizes.
            try:
                sw_stat, sw_p = scipy_stats.shapiro(vals)
            except Exception:
                sw_stat, sw_p = np.nan, np.nan

            # Anderson-Darling: gives critical values at fixed significance
            # levels rather than a single p-value.
            try:
                ad_result = scipy_stats.anderson(vals, dist='norm')
                ad_stat = ad_result.statistic
                # 5% significance level critical value (index 2 in scipy's
                # standard significance_level list: 15, 10, 5, 2.5, 1 %)
                ad_crit_5pct = ad_result.critical_values[2]
                ad_reject_5pct = ad_stat > ad_crit_5pct
            except Exception:
                ad_stat, ad_crit_5pct, ad_reject_5pct = np.nan, np.nan, None

            return sw_stat, sw_p, ad_stat, ad_crit_5pct, ad_reject_5pct

        sw_stat_o, sw_p_o, ad_stat_o, ad_crit_o, ad_reject_o = run_tests(vals_orig)
        sw_stat_n, sw_p_n, ad_stat_n, ad_crit_n, ad_reject_n = run_tests(vals_ns)

        # --- Draw the two Q-Q plots side by side --------------------------------
        self.figure_qqplot.clear()
        ax1 = self.figure_qqplot.add_subplot(121)
        ax2 = self.figure_qqplot.add_subplot(122)

        for ax, vals, title in [(ax1, vals_orig, field_orig), (ax2, vals_ns, field_ns)]:
            (osm, osr), (slope, intercept, r) = scipy_stats.probplot(
                vals, dist='norm', fit=True
            )
            ax.scatter(osm, osr, s=14, color='#1f77b4', alpha=0.7, zorder=3)
            line_x = np.array([osm.min(), osm.max()])
            ax.plot(line_x, slope * line_x + intercept, color='red',
                   linewidth=1.3, linestyle='--', zorder=2)
            ax.set_title(title, fontsize=9)
            ax.set_xlabel('Theoretical quantiles', fontsize=8)
            ax.set_ylabel('Sample quantiles', fontsize=8)
            ax.tick_params(axis='both', labelsize=7)
            ax.grid(True, linestyle=':', linewidth=0.4, alpha=0.5)

        self.figure_qqplot.tight_layout()
        self.canvas_qqplot.draw()

        # --- Compose the text summary --------------------------------------------
        def format_block(name, n, sw_stat, sw_p, ad_stat, ad_crit, ad_reject):
            sw_verdict = ("compatible with normality" if (sw_p is not None and not np.isnan(sw_p) and sw_p > 0.05)
                         else "deviates from normality" if not np.isnan(sw_p) else "n/a")
            if ad_reject is None:
                ad_verdict = "n/a"
            else:
                ad_verdict = "deviates from normality" if ad_reject else "compatible with normality"
            return (
                "%s (n=%d):\n"
                "  Shapiro-Wilk: W=%.4f, p=%.4g -> %s\n"
                "  Anderson-Darling: A2=%.4f, crit(5%%)=%.4f -> %s"
                % (name, n, sw_stat, sw_p, sw_verdict, ad_stat, ad_crit, ad_verdict)
            )

        summary = (
            format_block(field_orig, len(vals_orig), sw_stat_o, sw_p_o, ad_stat_o, ad_crit_o, ad_reject_o)
            + "\n\n" +
            format_block(field_ns, len(vals_ns), sw_stat_n, sw_p_n, ad_stat_n, ad_crit_n, ad_reject_n)
        )
        self.plainTextEdit_normality_test_result.setPlainText(summary)

    # =========================================================================
    # Cell declustering
    # =========================================================================

    @staticmethod
    def _cell_decluster_weights(coords, values, cell_size, n_offsets=4, rng=None):
        """Compute GSLIB-style cell declustering weights for one cell size.

        The study area is covered by a grid of square cells of the given
        size; each point's raw weight is 1/(number of occupied-cell points
        in its cell). To avoid the result depending on an arbitrary grid
        origin, the grid is shifted by several random offsets and the
        weights are averaged across offsets. Weights are then normalised so
        their mean is 1 (i.e. they sum to the number of points), matching
        the standard GSLIB convention.

        Returns (weights, weighted_mean).
        """
        if rng is None:
            rng = np.random.default_rng(seed=12345)

        n = len(values)
        if n == 0 or cell_size <= 0:
            return np.ones(n), float(np.mean(values)) if n > 0 else np.nan

        x_min, y_min = coords[:, 0].min(), coords[:, 1].min()
        accum_weights = np.zeros(n)

        for _ in range(n_offsets):
            off_x = rng.uniform(0, cell_size)
            off_y = rng.uniform(0, cell_size)
            cell_ix = np.floor((coords[:, 0] - x_min + off_x) / cell_size).astype(np.int64)
            cell_iy = np.floor((coords[:, 1] - y_min + off_y) / cell_size).astype(np.int64)
            cell_id = cell_ix.astype(np.int64) * 1_000_003 + cell_iy.astype(np.int64)

            # Count points per occupied cell, then map back to each point
            unique_cells, inverse, counts = np.unique(cell_id, return_inverse=True, return_counts=True)
            points_per_cell = counts[inverse]
            accum_weights += 1.0 / points_per_cell

        raw_weights = accum_weights / n_offsets
        # Normalise so the mean weight is 1 (GSLIB convention)
        norm_weights = raw_weights * (n / np.sum(raw_weights))

        weighted_mean = float(np.sum(norm_weights * values) / np.sum(norm_weights))
        return norm_weights, weighted_mean

    def run_declustering(self):
        """Run cell declustering: test a range of cell sizes (for the
        diagnostic plot, weighted mean vs cell size), then compute the final
        per-point weights for doubleSpinBox_cell_size and create a NEW
        in-memory layer with all the original columns plus a
        'decluster_weight' field.

        A new layer is created (rather than editing the active layer in
        place) so this works even on read-only sources (CSV, etc.) and never
        modifies the user's original data.
        """
        layer = self.mMapLayerComboBox.currentLayer()
        field_name = self.mFieldComboBox.currentField()
        if not layer or not field_name:
            QtWidgets.QMessageBox.warning(self, "Missing Input",
                "Please select a layer and a field.")
            return

        # Jump immediately to 10% so the user sees instant feedback that the
        # computation has started, instead of staying at 0% while the
        # feature-collection loop below runs (can be slow on CSV-backed
        # layers before the first progress update would otherwise appear).
        self.progressBar_decluster.setValue(10)
        QtWidgets.QApplication.processEvents()

        # --- Collect ALL features (not just the ones with a valid value),
        # so every original row is preserved in the output layer. ---------
        all_feats = list(layer.getFeatures())
        if len(all_feats) == 0:
            QtWidgets.QMessageBox.critical(self, "Error", "The layer has no features.")
            return

        coords_all = []
        values_all = []
        valid_mask = []
        for f in all_feats:
            geom = f.geometry()
            if geom and not geom.isNull():
                pt = geom.asPoint()
                coords_all.append([pt.x(), pt.y()])
            else:
                coords_all.append([np.nan, np.nan])

            val = f[field_name]
            try:
                if val != NULL and val is not None:
                    values_all.append(float(val))
                    valid_mask.append(True)
                else:
                    values_all.append(np.nan)
                    valid_mask.append(False)
            except (TypeError, ValueError):
                values_all.append(np.nan)
                valid_mask.append(False)

        coords_all = np.array(coords_all)
        values_all = np.array(values_all)
        valid_mask = np.array(valid_mask) & np.isfinite(coords_all[:, 0]) & np.isfinite(coords_all[:, 1])

        coords = coords_all[valid_mask]
        values = values_all[valid_mask]
        n = len(values)
        if n < 2:
            QtWidgets.QMessageBox.critical(self, "Error",
                "Not enough valid points (with both a value and a geometry) "
                "to run declustering.")
            return

        naive_mean = float(np.mean(values))

        # --- Diagnostic curve: weighted mean vs cell size -----------------------
        cs_min  = self.doubleSpinBox_cell_size_min.value()
        cs_max  = self.doubleSpinBox_cell_size_max.value()
        n_steps = int(self.spinBox_cell_size_steps.value())

        if cs_min > 0 and cs_max > cs_min and n_steps > 1:
            cell_sizes = np.linspace(cs_min, cs_max, n_steps)
            weighted_means = np.empty(n_steps)
            rng = np.random.default_rng(seed=12345)
            for i, cs in enumerate(cell_sizes):
                _, wmean = self._cell_decluster_weights(coords, values, cs, rng=rng)
                weighted_means[i] = wmean
                self.progressBar_decluster.setValue(10 + int((i + 1) / n_steps * 40))
                if i % 2 == 0:
                    QtWidgets.QApplication.processEvents()

            # Auto mode: pick the cell size at the minimum of the curve.
            # For right-skewed data the minimum weighted mean corresponds to
            # the most representative (least clustered) configuration.
            is_auto = not (hasattr(self, 'radioButton_manual_declustering') and
                           self.radioButton_manual_declustering.isChecked())
            if is_auto:
                best_idx = int(np.argmin(weighted_means))
                best_cell_size = float(cell_sizes[best_idx])
                if hasattr(self, 'doubleSpinBox_cell_size'):
                    self.doubleSpinBox_cell_size.blockSignals(True)
                    self.doubleSpinBox_cell_size.setValue(best_cell_size)
                    self.doubleSpinBox_cell_size.blockSignals(False)

            # Determine the cell size that will actually be used for weights
            # (needed for the marker on the diagnostic plot).
            final_cell_size_for_plot = (
                self.doubleSpinBox_cell_size.value()
                if hasattr(self, 'doubleSpinBox_cell_size')
                else (float(cell_sizes[int(np.argmin(weighted_means))]) if is_auto else None)
            )

            self.figure_decluster.clear()
            ax = self.figure_decluster.add_subplot(111)
            ax.plot(cell_sizes, weighted_means, marker='o', markersize=4,
                   color='#1f77b4', linewidth=1.3, label='Declustered mean')
            ax.axhline(naive_mean, color='red', linewidth=1.2, linestyle='--',
                      label='Naive mean (unweighted)')

            # Mark the cell size that will be used for the final weights
            if final_cell_size_for_plot is not None and cs_min <= final_cell_size_for_plot <= cs_max:
                # Interpolate the weighted mean at the chosen cell size
                wm_at_chosen = float(np.interp(final_cell_size_for_plot,
                                                cell_sizes, weighted_means))
                ax.axvline(final_cell_size_for_plot, color='#e67e22',
                           linewidth=1.2, linestyle=':', alpha=0.85)
                ax.plot(final_cell_size_for_plot, wm_at_chosen,
                        marker='*', markersize=14, color='#e67e22',
                        zorder=5, label='Selected cell size (%.4g)' % final_cell_size_for_plot)

            ax.set_xlabel('Cell size', fontsize=8)
            ax.set_ylabel('Weighted mean of %s' % field_name, fontsize=8)
            ax.set_title('Cell Declustering Diagnostic', fontsize=10)
            ax.grid(True, linestyle=':', linewidth=0.4, alpha=0.5)
            ax.tick_params(axis='both', labelsize=7)
            ax.legend(fontsize=7)
            self.figure_decluster.tight_layout()
            self.canvas_decluster.draw()

        # --- Final weights for the user-chosen cell size -------------------------
        final_cell_size = self.doubleSpinBox_cell_size.value()
        if final_cell_size <= 0:
            QtWidgets.QMessageBox.warning(self, "Invalid Cell Size",
                "Please set a positive cell size to compute the final weights.")
            return

        weights_valid, weighted_mean = self._cell_decluster_weights(coords, values, final_cell_size)
        self.progressBar_decluster.setValue(60)
        QtWidgets.QApplication.processEvents()

        # Map weights back to the full feature list (NULL for features that
        # were excluded, e.g. missing value or missing geometry).
        weights_full = np.full(len(all_feats), np.nan)
        weights_full[valid_mask] = weights_valid

        # --- Unique output layer name ---------------------------------------------
        base_lyr_name  = layer.name() + "_decluster"
        existing_names = {l.name() for l in QgsProject.instance().mapLayers().values()}
        out_lyr_name   = base_lyr_name
        suffix = 1
        while out_lyr_name in existing_names:
            out_lyr_name = "%s_%d" % (base_lyr_name, suffix)
            suffix += 1

        # --- Create memory layer (same geometry type and CRS as the source) -----
        geom_type_map = {
            0: "Point", 1: "LineString", 2: "Polygon",
            3: "MultiPoint", 4: "MultiLineString", 5: "MultiPolygon"
        }
        geom_type = geom_type_map.get(layer.geometryType(), "Point")
        crs = layer.crs()
        crs_str = (crs.authid() or crs.toWkt()) if (crs and crs.isValid()) else "EPSG:4326"
        out_layer = QgsVectorLayer("%s?crs=%s" % (geom_type, crs_str), out_lyr_name, "memory")
        if not out_layer.isValid():
            QtWidgets.QMessageBox.critical(self, "Error",
                "Failed to create the output memory layer.")
            return

        pr = out_layer.dataProvider()

        # Copy all original fields, then add the weight field
        original_fields = list(layer.fields())
        field_out_name = "decluster_weight"
        # Avoid a name collision with an existing column of the same name
        if field_out_name in {f.name() for f in original_fields}:
            i = 1
            while ("%s_%d" % (field_out_name, i)) in {f.name() for f in original_fields}:
                i += 1
            field_out_name = "%s_%d" % (field_out_name, i)

        pr.addAttributes(original_fields + [QgsField(field_out_name, QVariant.Double)])
        out_layer.updateFields()
        out_fields = out_layer.fields()
        weight_idx = out_fields.indexOf(field_out_name)

        # --- Build and add features, copying every original attribute -----------
        new_features = []
        n_feats = len(all_feats)
        for i, src_feat in enumerate(all_feats):
            new_feat = QgsFeature(out_fields)
            new_feat.setGeometry(src_feat.geometry())
            for j, field in enumerate(original_fields):
                new_feat.setAttribute(j, src_feat[field.name()])
            w = weights_full[i]
            new_feat.setAttribute(weight_idx, None if np.isnan(w) else float(w))
            new_features.append(new_feat)
            if i % 50 == 0:
                self.progressBar_decluster.setValue(60 + int((i + 1) / n_feats * 35))
                QtWidgets.QApplication.processEvents()

        ok, _ = pr.addFeatures(new_features)
        if not ok:
            QtWidgets.QMessageBox.critical(self, "Error",
                "Failed to add features to the output layer.")
            return

        out_layer.updateExtents()
        QgsProject.instance().addMapLayer(out_layer)
        self.progressBar_decluster.setValue(100)

        # Update the info text box with declustering results
        if hasattr(self, 'plainTextEdit_declustered_cell_size'):
            self.plainTextEdit_declustered_cell_size.setPlainText(
                "Cell size used:      %.6g\n"
                "Naive mean:          %.6g\n"
                "Declustered mean:    %.6g\n"
                "Difference:          %.6g\n"
                "Output layer:        %s\n"
                "Weight field:        %s" % (
                    final_cell_size,
                    naive_mean,
                    weighted_mean,
                    weighted_mean - naive_mean,
                    out_lyr_name,
                    field_out_name)
            )
        if hasattr(self, 'label_declustered_cell_size'):
            self.label_declustered_cell_size.setText(
                "Cell size: %.4g    Naive mean: %.4g    Declustered mean: %.4g" % (
                    final_cell_size, naive_mean, weighted_mean)
            )

        QtWidgets.QMessageBox.information(
            self, "Declustering Complete",
            "Cell size: %.4g\n"
            "Naive mean:        %.6g\n"
            "Declustered mean:  %.6g\n\n"
            "New layer '%s' added to the project, with all original "
            "columns plus '%s'." % (
                final_cell_size, naive_mean, weighted_mean,
                out_lyr_name, field_out_name)
        )

    def _populate_back_transform_variable_combo(self, *args):
        """Fill comboBox_back_transform_table_variable with the normal-score
        fields of the layer selected in comboBox_layer_table_nscore (fields
        ending in '_NSC_TRSF', the naming convention used by
        run_ns_transform). The layer's rows are already sorted by ascending
        original value, so this field plus its companion original-value
        field together ARE the transformation table -- no separate JSON
        column is needed."""
        if not hasattr(self, 'comboBox_back_transform_table_variable'):
            return
        combo = self.comboBox_back_transform_table_variable
        combo.clear()

        # Prefer the dedicated nscore-layer combo; fall back to mMapLayerComboBox
        layer = None
        if hasattr(self, 'comboBox_layer_table_nscore'):
            layer_id = self.comboBox_layer_table_nscore.currentData()
            if layer_id:
                layer = QgsProject.instance().mapLayer(layer_id)
        if layer is None:
            layer = self.mMapLayerComboBox.currentLayer()
        if layer is None:
            return

        for field in layer.fields():
            if field.name().endswith("_NSC_TRSF"):
                combo.addItem(field.name())

    def _populate_raster_combo(self, *args):
        """Populate comboBox_raster with all raster layers currently in the project."""
        if not hasattr(self, 'comboBox_raster'):
            return
        from qgis.core import QgsRasterLayer
        combo = self.comboBox_raster
        current = combo.currentText()
        combo.blockSignals(True)
        combo.clear()
        for lyr in QgsProject.instance().mapLayers().values():
            if isinstance(lyr, QgsRasterLayer) and lyr.isValid():
                combo.addItem(lyr.name())
        idx = combo.findText(current)
        combo.setCurrentIndex(idx if idx >= 0 else 0)
        combo.blockSignals(False)
        self._on_raster_changed_backtransform(combo.currentIndex())

    @staticmethod
    def _unique_filename(base):
        """Return base if it does not already exist as a layer field name in the
        project, otherwise return base_1, base_2, ... The check is done on the
        string only (callers must check against the actual layer when needed)."""
        return base   # actual uniqueness checked inside each run method

    def _unique_field_name(self, layer, base):
        """Return base if not in layer fields, else base_1, base_2, ..."""
        existing = {f.name() for f in layer.fields()}
        if base not in existing:
            return base
        i = 1
        while True:
            candidate = "%s_%d" % (base, i)
            if candidate not in existing:
                return candidate
            i += 1

    @staticmethod
    def _unique_path(base_path):
        """Return base_path if file does not exist, else add _1, _2, ... before ext."""
        import os
        if not os.path.exists(base_path):
            return base_path
        root, ext = os.path.splitext(base_path)
        i = 1
        while True:
            candidate = "%s_%d%s" % (root, i, ext)
            if not os.path.exists(candidate):
                return candidate
            i += 1

    # ------------------------------------------------------------------
    # Core NS transform (GSLIB nscore algorithm in Python)
    # ------------------------------------------------------------------

    @staticmethod
    def _nscore(values):
        """Normal score transform of 1-D array `values`.

        Returns
        -------
        ns_values : np.ndarray  - normal scores for each input value (same order)
        table_orig : np.ndarray - sorted original values (transformation table col 0)
        table_ns   : np.ndarray - corresponding normal scores  (transformation table col 1)
        sort_idx   : np.ndarray - indices that sort `values` ascending (table_orig = values[sort_idx]);
                                  callers can use this to reorder companion arrays (e.g. x, y
                                  coordinates) so they stay aligned row-by-row with the sorted table.
        """
        from scipy.stats import norm as scipy_norm

        vals = np.asarray(values, dtype=float)
        n = len(vals)

        # Sort indices; add tiny random jitter to break ties (like GSLIB EPSLON)
        rng = np.random.default_rng(seed=69069)
        jitter = rng.uniform(0, 1e-6, size=n)
        sort_idx = np.argsort(vals + jitter, kind='stable')

        # Cumulative probabilities at midpoints of rank intervals (equal weights)
        ranks = np.arange(1, n + 1)
        cp_hi = ranks / n
        cp_lo = np.concatenate(([0.0], cp_hi[:-1]))
        cp_mid = (cp_hi + cp_lo) / 2.0
        cp_mid = np.clip(cp_mid, 1e-10, 1 - 1e-10)

        ns_sorted = scipy_norm.ppf(cp_mid)

        # Build transformation table (sorted originals -> normal scores)
        table_orig = vals[sort_idx]
        table_ns = ns_sorted

        # Assign NS values back to original order
        ns_values = np.empty(n)
        ns_values[sort_idx] = ns_sorted

        return ns_values, table_orig, table_ns, sort_idx

    @staticmethod
    def _backtr(z_gauss, table_orig, table_ns):
        """Back-transform a Gaussian value to the original domain using the
        transformation table built by _nscore().

        Uses linear interpolation between table entries; clamps to [min, max]
        of the original data for extrapolation (ltail=utail=1 linear).
        """
        z = float(z_gauss)
        # Clamp to table range (linear tail extrapolation = clamp)
        if z <= table_ns[0]:
            return float(table_orig[0])
        if z >= table_ns[-1]:
            return float(table_orig[-1])
        # Linear interpolation
        idx = np.searchsorted(table_ns, z, side='right') - 1
        idx = int(np.clip(idx, 0, len(table_ns) - 2))
        t = (z - table_ns[idx]) / (table_ns[idx + 1] - table_ns[idx])
        return float(table_orig[idx] + t * (table_orig[idx + 1] - table_orig[idx]))

    # ------------------------------------------------------------------
    # Slot: run normal score transform
    # ------------------------------------------------------------------

    def run_ns_transform(self):
        """Compute NS transform and create a new memory layer with:
          - x, y  (coordinates from each feature's geometry centroid)
          - the original selected field
          - the normal-score column

        Unlike a typical "transformed copy" of the source layer, the output
        rows are sorted by ascending original value. This means the layer
        IS the GSLIB-style transformation table: column field_name holds the
        sorted original values, and column desired_ns_name holds the
        matching normal scores, row by row, with x/y kept aligned to the
        same point. No separate JSON/table column is needed, and
        run_back_transform() reads table_orig/table_ns directly from these
        two columns.
        """
        layer = self.mMapLayerComboBox.currentLayer()
        if layer is None:
            QtWidgets.QMessageBox.warning(self, "No Layer", "Please select a vector layer.")
            return

        field_name = self.mFieldComboBox.currentField()
        if not field_name:
            QtWidgets.QMessageBox.warning(self, "No Field", "Please select a field.")
            return

        # Output field names (no truncation needed for memory layers)
        desired_ns_name  = self.lineEdit_var_name_nscore_transform.text().strip() or (field_name + "_NSC_TRSF")

        # Jump immediately to 10% so the user sees instant feedback that the
        # computation has started, instead of staying at 0% during the
        # potentially slow feature-reading loop below (especially with
        # CSV-backed layers, where iterating features can take a moment
        # before the first progress update would otherwise appear).
        self.progressBar_nscore_transform.setValue(10)
        QtWidgets.QApplication.processEvents()

        # Check scipy
        try:
            from scipy.stats import norm as _scipy_norm  # noqa: F401
        except ImportError:
            QtWidgets.QMessageBox.critical(self, "Dependency Error",
                                           "scipy is required for NS transform.")
            return

        # --- Collect data from source layer ---
        n_source = layer.featureCount()
        xs, ys, raw_vals = [], [], []
        for i, feat in enumerate(layer.getFeatures()):
            geom = feat.geometry()
            if geom and not geom.isNull():
                pt = geom.centroid().asPoint()
                xs.append(pt.x())
                ys.append(pt.y())
            else:
                xs.append(np.nan)
                ys.append(np.nan)
            v = feat[field_name]
            try:
                raw_vals.append(float(v))
            except (TypeError, ValueError):
                raw_vals.append(np.nan)
            if n_source > 0 and i % 50 == 0:
                self.progressBar_nscore_transform.setValue(10 + int((i + 1) / n_source * 40))
                QtWidgets.QApplication.processEvents()

        xs_arr  = np.array(xs)
        ys_arr  = np.array(ys)
        vals_arr = np.array(raw_vals)

        if np.all(np.isnan(xs_arr)):
            QtWidgets.QMessageBox.critical(
                self, "No Geometry Found",
                "None of the features in the source layer have a valid "
                "geometry, so no coordinates could be extracted.\n\n"
                "If this layer comes from a CSV file, check that the X/Y "
                "columns were correctly recognised when the file was loaded "
                "(this commonly fails if the CSV starts with a UTF-8 BOM, "
                "which can prevent QGIS from matching the 'x'/'y' column "
                "names). Try re-saving the CSV without a BOM, or set the "
                "X/Y field names explicitly when adding the delimited text layer."
            )
            return

        # Only rows with both a valid value AND a valid geometry can be part
        # of the transformation table (need x, y to plot/use them, and need
        # the value to compute the normal score).
        valid_mask = ~np.isnan(vals_arr) & ~np.isnan(xs_arr) & ~np.isnan(ys_arr)
        valid_vals = vals_arr[valid_mask]
        valid_xs   = xs_arr[valid_mask]
        valid_ys   = ys_arr[valid_mask]

        if len(valid_vals) < 2:
            QtWidgets.QMessageBox.critical(self, "Error",
                                           "Not enough valid values to compute NS transform.")
            return

        # --- Compute NS transform ---
        # sort_idx reorders valid_vals ascending; table_orig == valid_vals[sort_idx]
        # and table_ns are exactly that sorted sequence and its normal scores.
        # Applying the same sort_idx to valid_xs/valid_ys keeps every row
        # pointing at the correct original point.
        _, table_orig, table_ns, sort_idx = self._nscore(valid_vals)
        sorted_xs = valid_xs[sort_idx]
        sorted_ys = valid_ys[sort_idx]
        self.progressBar_nscore_transform.setValue(50)
        QtWidgets.QApplication.processEvents()

        # --- Unique output layer name ---
        base_lyr_name  = layer.name() + "_NSC_TRSF"
        existing_names = {l.name() for l in QgsProject.instance().mapLayers().values()}
        out_lyr_name   = base_lyr_name
        suffix = 1
        while out_lyr_name in existing_names:
            out_lyr_name = "%s_%d" % (base_lyr_name, suffix)
            suffix += 1

        # --- Create memory layer (Point, same CRS) ---
        # Fall back to a default CRS if the source layer has none (this can
        # happen with CSV layers whose header was not parsed correctly, e.g.
        # a UTF-8 BOM corrupting the first column name so QGIS could not
        # auto-recognise the X/Y columns and never assigned a CRS). Without
        # this fallback, "Point?crs=" is an invalid URI and the new layer
        # silently fails to be created.
        crs = layer.crs()
        if crs is None or not crs.isValid():
            crs_str = "EPSG:4326"
            QtWidgets.QMessageBox.warning(
                self, "No CRS Found",
                "The source layer has no valid coordinate reference system "
                "(this can happen with CSV files that were not recognised "
                "correctly, for example due to encoding issues in the header).\n\n"
                "The new layer will be created with a default CRS "
                "(EPSG:4326). You may need to reproject it manually."
            )
        else:
            crs_str = crs.authid() or crs.toWkt()
            if not crs_str:
                crs_str = "EPSG:4326"
        out_layer = QgsVectorLayer("Point?crs=%s" % crs_str, out_lyr_name, "memory")
        if not out_layer.isValid():
            QtWidgets.QMessageBox.critical(
                self, "Error",
                "Failed to create the output memory layer (invalid CRS or "
                "geometry definition)."
            )
            return
        pr = out_layer.dataProvider()

        # Define exactly the columns we want:
        #   x, y  (Double) - coordinates of the point that has this value
        #   <field_name>   (Double) - original value, SORTED ascending
        #   <ns_name>      (Double) - corresponding normal score
        pr.addAttributes([
            QgsField("x",              QVariant.Double),
            QgsField("y",              QVariant.Double),
            QgsField(field_name,       QVariant.Double),
            QgsField(desired_ns_name,  QVariant.Double),
        ])
        out_layer.updateFields()

        out_fields = out_layer.fields()
        idx_x     = out_fields.indexOf("x")
        idx_y     = out_fields.indexOf("y")
        idx_orig  = out_fields.indexOf(field_name)
        idx_ns    = out_fields.indexOf(desired_ns_name)

        # --- Build features, one per row of the (sorted) transformation table ---
        new_features = []
        n_out = len(table_orig)
        for i in range(n_out):
            feat = QgsFeature(out_fields)
            feat.setGeometry(QgsGeometry.fromPointXY(QgsPointXY(float(sorted_xs[i]), float(sorted_ys[i]))))
            feat.setAttribute(idx_x,    float(sorted_xs[i]))
            feat.setAttribute(idx_y,    float(sorted_ys[i]))
            feat.setAttribute(idx_orig, float(table_orig[i]))
            feat.setAttribute(idx_ns,   float(table_ns[i]))
            new_features.append(feat)
            if n_out > 0 and i % 50 == 0:
                self.progressBar_nscore_transform.setValue(50 + int((i + 1) / n_out * 45))
                QtWidgets.QApplication.processEvents()

        ok, _ = pr.addFeatures(new_features)
        if not ok:
            QtWidgets.QMessageBox.critical(self, "Error",
                                           "Failed to add features to the output layer.")
            return

        out_layer.updateExtents()
        QgsProject.instance().addMapLayer(out_layer)
        self.progressBar_nscore_transform.setValue(100)

        # Refresh combos
        self._populate_nscore_layer_combo(select_layer=out_layer)
        self._populate_back_transform_variable_combo()
        self.mMapLayerComboBox.setLayer(out_layer)
        self.mFieldComboBox.setLayer(out_layer)
        self.mFieldComboBox.setField(desired_ns_name)

        QtWidgets.QMessageBox.information(
            self, "Done",
            "Normal Score Transform complete.\n"
            "New layer '%s' added to the project (%d rows, sorted by "
            "ascending value).\n"
            "  x, y : coordinates\n"
            "  %s   : original values (sorted ascending)\n"
            "  %s   : normal scores\n\n"
            "This layer itself is the GSLIB-style transformation table: "
            "no separate table column is stored." % (
                out_lyr_name, len(table_orig), field_name, desired_ns_name)
        )

    # ------------------------------------------------------------------
    # Slot: back transform a raster
    # ------------------------------------------------------------------

    def run_back_transform(self):
        """Apply GSLIB back-transform to a raster using the NS table from the layer."""
        import os

        # --- inputs ---
        # Layer containing the NS transformation table
        layer = None
        if hasattr(self, 'comboBox_layer_table_nscore'):
            layer_id = self.comboBox_layer_table_nscore.currentData()
            if layer_id:
                layer = QgsProject.instance().mapLayer(layer_id)
        if layer is None:
            layer = self.mMapLayerComboBox.currentLayer()
        if layer is None:
            QtWidgets.QMessageBox.warning(self, "No Layer",
                "Please select the layer containing the NS table in "
                "'NS Score Layer'.")
            return

        # Raster to back-transform
        raster_name = self.comboBox_raster.currentText().strip()
        raster_layer = None
        for lyr in QgsProject.instance().mapLayers().values():
            if lyr.name() == raster_name and isinstance(lyr, QgsRasterLayer):
                raster_layer = lyr
                break
        if raster_layer is None:
            QtWidgets.QMessageBox.warning(self, "Raster Not Found", "Could not find raster '%s' in the project." % raster_name)
            return

        # NS field (e.g. '<variable>_NSC_TRSF'), selected from
        # comboBox_back_transform_table_variable. Its companion
        # original-value column is the same name with the '_NSC_TRSF'
        # suffix stripped off, following run_ns_transform's naming
        # convention.
        ns_field = self.comboBox_back_transform_table_variable.currentText().strip()
        if not ns_field:
            QtWidgets.QMessageBox.warning(self, "No Table Field", "Please select the NS field.")
            return

        suffix = "_NSC_TRSF"
        if ns_field.endswith(suffix):
            orig_field = ns_field[: -len(suffix)]
        else:
            orig_field = None

        layer_field_names = {f.name() for f in layer.fields()}
        if orig_field is None or orig_field not in layer_field_names:
            QtWidgets.QMessageBox.critical(
                self, "Error",
                "Could not find the original-value column matching '%s' "
                "(expected a column named '%s'). The layer may not have "
                "been created by Normal Score Transform, or its columns "
                "were renamed." % (ns_field, orig_field or "<unknown>")
            )
            return

        # The layer's rows are already sorted by ascending original value
        # (run_ns_transform stores them that way), so these two columns
        # together ARE the transformation table -- read them directly,
        # without re-sorting, to preserve the exact original/ns pairing.
        table_orig_list, table_ns_list = [], []
        for feat in layer.getFeatures():
            o_val = feat[orig_field]
            n_val = feat[ns_field]
            if o_val != NULL and o_val is not None and n_val != NULL and n_val is not None:
                try:
                    table_orig_list.append(float(o_val))
                    table_ns_list.append(float(n_val))
                except (TypeError, ValueError):
                    continue

        if len(table_orig_list) < 2:
            QtWidgets.QMessageBox.critical(self, "Error",
                "Could not read a usable transformation table from columns "
                "'%s' / '%s'." % (orig_field, ns_field))
            return

        table_orig = np.array(table_orig_list)
        table_ns   = np.array(table_ns_list)

        # Defensive: _backtr() requires table_ns sorted ascending for
        # np.searchsorted to work correctly. run_ns_transform() already
        # writes the rows in that order, but sort again here in case the
        # layer's row order was changed afterwards (e.g. manual editing,
        # or a save/reload through a format that does not preserve order).
        order = np.argsort(table_ns)
        table_orig = table_orig[order]
        table_ns   = table_ns[order]

        # Output path
        out_name = self.lineEdit_raster_out.text().strip()
        if not out_name:
            out_name = raster_name + "_back_transformed"

        # Determine output directory (same as input raster)
        raster_path = raster_layer.source()
        out_dir = os.path.dirname(raster_path) if os.path.isabs(raster_path) else os.path.expanduser("~")
        if not out_name.endswith(".tif"):
            out_name += ".tif"
        out_path = self._unique_path(os.path.join(out_dir, out_name))

        # --- Process raster band 1 with GDAL ---
        try:
            from osgeo import gdal
        except ImportError:
            QtWidgets.QMessageBox.critical(self, "Dependency Error", "GDAL Python bindings are required.")
            return

        ds_in = gdal.Open(raster_path, gdal.GA_ReadOnly)
        if ds_in is None:
            QtWidgets.QMessageBox.critical(self, "Error", "Cannot open raster with GDAL.")
            return

        band   = ds_in.GetRasterBand(1)
        nodata = band.GetNoDataValue()
        arr    = band.ReadAsArray().astype(np.float64)

        # Back-transform each pixel
        valid_mask = ~np.isnan(arr)
        if nodata is not None:
            valid_mask &= (arr != nodata)

        out_arr = np.full_like(arr, nodata if nodata is not None else np.nan)
        flat_valid = arr[valid_mask]
        bt = np.array([self._backtr(v, table_orig, table_ns) for v in flat_valid])
        out_arr[valid_mask] = bt

        # Write output GeoTIFF
        driver   = gdal.GetDriverByName("GTiff")
        ds_out   = driver.Create(out_path, ds_in.RasterXSize, ds_in.RasterYSize, 1, gdal.GDT_Float64)
        ds_out.SetGeoTransform(ds_in.GetGeoTransform())
        ds_out.SetProjection(ds_in.GetProjection())
        band_out = ds_out.GetRasterBand(1)
        if nodata is not None:
            band_out.SetNoDataValue(nodata)
        band_out.WriteArray(out_arr)
        band_out.FlushCache()
        ds_out = None
        ds_in  = None

        # Load result into QGIS
        result_layer = QgsRasterLayer(out_path, os.path.splitext(os.path.basename(out_path))[0])
        if result_layer.isValid():
            QgsProject.instance().addMapLayer(result_layer)

        QtWidgets.QMessageBox.information(
            self, "Done",
            "Back-transform complete.\nOutput saved to:\n%s" % out_path
        )

    # =========================================================================
    # Probability maps
    # =========================================================================

    def _populate_probability_raster_combos(self, *args):
        """Populate comboBox_est_input_probab and comboBox_var_input_probab
        with all raster layers currently in the project."""
        for combo_name in ('comboBox_est_input_probab', 'comboBox_var_input_probab'):
            combo = getattr(self, combo_name)
            current_id = combo.currentData()
            combo.blockSignals(True)
            combo.clear()
            for lyr in QgsProject.instance().mapLayers().values():
                if isinstance(lyr, QgsRasterLayer) and lyr.isValid():
                    combo.addItem(lyr.name(), lyr.id())
            idx = combo.findData(current_id)
            combo.setCurrentIndex(idx if idx >= 0 else 0)
            combo.blockSignals(False)
        self._suggest_probability_output_name()

    def _suggest_probability_output_name(self, *args):
        """Pre-fill lineEdit_probability_output_map with
        '<input raster name>_probability_map', adding a numeric suffix if
        that name is already used by a project layer."""
        raster_name = self.comboBox_est_input_probab.currentText().strip()
        if not raster_name:
            return
        base = raster_name + "_probability_map"
        self.lineEdit_probability_output_map.setText(self._unique_layer_name(base))

    def run_probability_map(self):
        """Compute a probability-of-exceedance (or -of-non-exceedance) map
        from an estimated raster and its kriging-variance raster, assuming
        the estimation error is Gaussian with that variance.

        P(Z > threshold) = 1 - Phi((threshold - estimate) / sigma)   [higher]
        P(Z <= threshold) = Phi((threshold - estimate) / sigma)      [lower]

        where Phi is the standard normal CDF and sigma = sqrt(variance).
        The output is a new in-memory raster (GDAL /vsimem/), never written
        to disk, added to the QGIS project.
        """
        try:
            from osgeo import gdal
        except ImportError:
            QtWidgets.QMessageBox.critical(self, "Dependency Error",
                                           "GDAL Python bindings are required.")
            return
        try:
            from scipy.stats import norm as scipy_norm
        except ImportError:
            QtWidgets.QMessageBox.critical(self, "Dependency Error",
                                           "scipy is required for probability maps.")
            return

        # --- Resolve input rasters from the combos -----------------------------
        est_name = self.comboBox_est_input_probab.currentText().strip()
        var_name = self.comboBox_var_input_probab.currentText().strip()
        if not est_name or not var_name:
            QtWidgets.QMessageBox.warning(self, "Missing Input",
                "Please select both the estimated raster and the variance raster.")
            return

        est_layer = var_layer = None
        for lyr in QgsProject.instance().mapLayers().values():
            if isinstance(lyr, QgsRasterLayer) and lyr.name() == est_name:
                est_layer = lyr
            if isinstance(lyr, QgsRasterLayer) and lyr.name() == var_name:
                var_layer = lyr
        if est_layer is None or var_layer is None:
            QtWidgets.QMessageBox.warning(self, "Raster Not Found",
                "Could not find the selected raster(s) in the project.")
            return

        threshold = self.doubleSpinBox_probab_threshold.value()
        higher = self.radioButton_higher_probab.isChecked()

        # --- Read both rasters with GDAL ----------------------------------------
        ds_est = gdal.Open(est_layer.source(), gdal.GA_ReadOnly)
        ds_var = gdal.Open(var_layer.source(), gdal.GA_ReadOnly)
        if ds_est is None or ds_var is None:
            QtWidgets.QMessageBox.critical(self, "Error", "Cannot open the selected rasters with GDAL.")
            return

        if (ds_est.RasterXSize, ds_est.RasterYSize) != (ds_var.RasterXSize, ds_var.RasterYSize):
            QtWidgets.QMessageBox.critical(self, "Error",
                "The estimated raster and the variance raster do not have the "
                "same dimensions. They must come from the same kriging run.")
            return

        band_est = ds_est.GetRasterBand(1)
        band_var = ds_var.GetRasterBand(1)
        nodata_est = band_est.GetNoDataValue()
        nodata_var = band_var.GetNoDataValue()

        arr_est = band_est.ReadAsArray().astype(np.float64)
        arr_var = band_var.ReadAsArray().astype(np.float64)

        valid = np.isfinite(arr_est) & np.isfinite(arr_var) & (arr_var > 0)
        if nodata_est is not None:
            valid &= (arr_est != nodata_est)
        if nodata_var is not None:
            valid &= (arr_var != nodata_var)

        out_nodata = -9999.0
        prob = np.full(arr_est.shape, out_nodata, dtype=np.float64)

        sigma = np.sqrt(arr_var[valid])
        z = (threshold - arr_est[valid]) / sigma
        if higher:
            prob[valid] = 1.0 - scipy_norm.cdf(z)   # P(Z > threshold)
        else:
            prob[valid] = scipy_norm.cdf(z)         # P(Z <= threshold)

        # --- Output layer name: <variable>_prob_<threshold> ---------------------
        field_name = self.mFieldComboBox.currentField() or est_name
        threshold_str = ("%g" % threshold).replace(".", "_").replace("-", "m")
        suggested_name = "%s_prob_%s" % (field_name, threshold_str)

        out_name = self.lineEdit_probability_output_map.text().strip()
        if not out_name:
            out_name = suggested_name
        out_name = self._unique_layer_name(out_name)

        # --- Write the result to an in-memory GeoTIFF (GDAL /vsimem/) -----------
        # /vsimem/ keeps the raster entirely in RAM; nothing is written to disk,
        # while still letting QgsRasterLayer open it like a normal GDAL source.
        vsimem_path = "/vsimem/%s_%s.tif" % (out_name, id(self))
        driver = gdal.GetDriverByName("GTiff")
        ds_out = driver.Create(vsimem_path, ds_est.RasterXSize, ds_est.RasterYSize,
                               1, gdal.GDT_Float64)
        ds_out.SetGeoTransform(ds_est.GetGeoTransform())
        ds_out.SetProjection(ds_est.GetProjection())
        band_out = ds_out.GetRasterBand(1)
        band_out.SetNoDataValue(out_nodata)
        band_out.WriteArray(prob)
        band_out.FlushCache()
        ds_out = None
        ds_est = None
        ds_var = None

        result_layer = QgsRasterLayer(vsimem_path, out_name, "gdal")
        if not result_layer.isValid():
            QtWidgets.QMessageBox.critical(self, "Error",
                "Failed to create the in-memory probability raster layer.")
            return

        QgsProject.instance().addMapLayer(result_layer)
        self._populate_raster_combo()
        self._populate_probability_raster_combos()

        direction_txt = "exceeding" if higher else "not exceeding"
        QtWidgets.QMessageBox.information(
            self, "Done",
            "Probability map complete.\n"
            "New in-memory raster '%s' added to the project.\n"
            "Probability of %s threshold = %g." % (out_name, direction_txt, threshold)
        )

    # =========================================================================
    # Cross-validation: weights table + neighbor map navigation
    # =========================================================================

    def _cross_val_select_previous(self):
        """Select the previous point in the cross-validation results (wraps at 0)."""
        if not getattr(self, '_cross_val_results', None):
            return
        n = len(self._cross_val_results)
        idx = self._cross_val_current_idx - 1
        if idx < 0:
            idx = n - 1  # wrap to last
        self._show_cross_val_point(idx)

    def _cross_val_select_next(self):
        """Select the next point in the cross-validation results (wraps at end)."""
        if not getattr(self, '_cross_val_results', None):
            return
        n = len(self._cross_val_results)
        idx = self._cross_val_current_idx + 1
        if idx >= n:
            idx = 0  # wrap to first
        self._show_cross_val_point(idx)

    def _on_cross_val_table_clicked(self, row, column):
        """Allow the user to select a point directly by clicking its row."""
        if not getattr(self, '_cross_val_results', None):
            return
        self._show_cross_val_point(row)

    def _show_cross_val_point(self, idx):
        """Refresh the weights table and the neighbor map for the point at `idx`
        in the cross-validation results."""
        if not getattr(self, '_cross_val_results', None):
            return
        n = len(self._cross_val_results)
        idx = max(0, min(idx, n - 1))
        self._cross_val_current_idx = idx

        self._populate_cross_kriging_weights_table(idx)
        self._plot_cross_validation_neighbors(idx)

    def _populate_cross_kriging_weights_table(self, idx):
        """Fill tableWidget_cross_kriging_weights with ALL input points (one row
        each): X, Y, <field_name>, then one weight column per neighbor slot up
        to spinBox_kriging_num_points_max.

        Row colouring matches tableView_cross_kriging: light green when
        Error2/Variance <= 1 (good estimate), light red when > 1, no colour
        if the point could not be estimated.

        For the row corresponding to the currently selected point (`idx`):
          - shown in bold to mark it as selected (colour is reserved for
            estimate quality, so selection uses font weight instead)
          - its own weight columns show the weights used to estimate it
            (one value per neighbor actually used, aligned to W1..Wn in the
            order returned by the solver)
        For all other rows, the weight columns are left blank, since those
        weights only have meaning relative to the point being estimated.
        """
        tw = self.tableWidget_cross_kriging_weights
        results = self._cross_val_results
        details_selected = self._cross_val_details[idx]
        field_name = getattr(self, '_cross_val_field_name', 'Value')
        max_weights = self.spinBox_kriging_num_points_max.value()
        NO_VALUE = getattr(self, '_cross_val_NO_VALUE', -9999.0)

        headers = ['X', 'Y', field_name] + \
                 ['W%d' % (i + 1) for i in range(max_weights)]

        tw.setRowCount(len(results))
        tw.setColumnCount(len(headers))
        tw.setHorizontalHeaderLabels(headers)
        tw.verticalHeader().setVisible(False)
        tw.setEditTriggers(QtWidgets.QAbstractItemView.NoEditTriggers)
        tw.setSelectionBehavior(QtWidgets.QAbstractItemView.SelectRows)

        # Same palette as tableView_cross_kriging
        color_green = QtGui.QColor(198, 239, 206)  # light green: ratio <= 1
        color_red   = QtGui.QColor(255, 199, 206)  # light red:   ratio >  1

        def make_item(text, row_color=None, is_selected_row=False):
            item = QtWidgets.QTableWidgetItem(text)
            item.setTextAlignment(QtCore.Qt.AlignCenter)
            item.setFlags(QtCore.Qt.ItemIsEnabled | QtCore.Qt.ItemIsSelectable)
            if row_color is not None:
                item.setBackground(QtGui.QBrush(row_color))
            if is_selected_row:
                font = item.font()
                font.setBold(True)
                item.setFont(font)
            return item

        for row, result in enumerate(results):
            is_sel = (row == idx)

            ratio_val = result['ratio']
            if ratio_val != NO_VALUE:
                row_color = color_green if ratio_val <= 1.0 else color_red
            else:
                row_color = None

            tw.setItem(row, 0, make_item("%.4f" % result['x'], row_color, is_sel))
            tw.setItem(row, 1, make_item("%.4f" % result['y'], row_color, is_sel))
            tw.setItem(row, 2, make_item("%.4f" % result['true'], row_color, is_sel))

            if is_sel and details_selected is not None:
                weights = details_selected['weights']
                for w_col in range(max_weights):
                    col = 3 + w_col
                    text = "%.4f" % weights[w_col] if w_col < len(weights) else ""
                    tw.setItem(row, col, make_item(text, row_color, is_sel))
            else:
                for w_col in range(max_weights):
                    tw.setItem(row, 3 + w_col, make_item("", row_color, is_sel))

        tw.resizeColumnsToContents()
        tw.selectRow(idx)
        tw.scrollToItem(tw.item(idx, 0), QtWidgets.QAbstractItemView.PositionAtCenter)

        tw.resizeColumnsToContents()

    def _plot_cross_validation_neighbors(self, idx):
        """Draw the neighbor map for the selected cross-validation point on
        canvas_cross_neighb.

        - Selected point   : filled red circle
        - Used neighbors    : black edge, fill colour proportional to weight
        - Candidate-but-unused points (inside ellipse, excluded by filters)
          and all other points: grey edge, white fill
        - Search ellipse centred on the selected point, drawn from
          doubleSpinBox_searchR_max / _min / search_azimuth
        - Equal aspect ratio so the ellipse and point layout are not
          distorted (x scale == y scale)
        """
        result  = self._cross_val_results[idx]
        details = self._cross_val_details[idx]
        X_all   = self._cross_val_X
        Y_all   = self._cross_val_Y

        x_sel, y_sel = result['x'], result['y']

        self.figure_cross_neighb.clear()
        ax = self.figure_cross_neighb.add_subplot(111)

        n_all = len(X_all)
        all_idx = np.arange(n_all)

        if details is not None:
            used_idx = set(details['neighbor_idx'].tolist())
        else:
            used_idx = set()

        # Identify the selected point's own index, then everything else
        # that is neither the selected point nor a used neighbor
        sel_point_idx = int(np.argmin((X_all - x_sel)**2 + (Y_all - y_sel)**2))
        other_idx = [i for i in all_idx if i != sel_point_idx and i not in used_idx]

        # --- Unused / non-candidate points: grey edge, white fill -----------
        if other_idx:
            ax.scatter(X_all[other_idx], Y_all[other_idx],
                      facecolors='white', edgecolors='#999999',
                      linewidths=1.2, s=50, zorder=2, label='Not used')

        # --- Used neighbors: black edge, fill proportional to weight --------
        if used_idx:
            n_idx = details['neighbor_idx']
            n_x   = details['neighbor_x']
            n_y   = details['neighbor_y']
            w     = details['weights']
            cmap  = plt.get_cmap('viridis')
            w_min, w_max = w.min(), w.max()
            if w_max == w_min:
                norm_w = np.full_like(w, 0.5)
            else:
                norm_w = (w - w_min) / (w_max - w_min)
            colors = cmap(norm_w)
            sc = ax.scatter(n_x, n_y, c=colors, edgecolors='black',
                           linewidths=1.3, s=80, zorder=3, label='Neighbors (weight)')
            sm = plt.cm.ScalarMappable(cmap=cmap,
                                       norm=plt.Normalize(vmin=w_min, vmax=w_max))
            sm.set_array([])
            cbar = self.figure_cross_neighb.colorbar(sm, ax=ax, fraction=0.035, pad=0.04)
            cbar.set_label('Kriging weight', fontsize=8)
            cbar.ax.tick_params(labelsize=7)

        # --- Selected point: filled red circle ------------------------------
        ax.scatter([x_sel], [y_sel], facecolors='#e41a1c', edgecolors='black',
                  linewidths=1.3, s=110, zorder=4, label='Selected point')

        # --- Search ellipse -----------------------------------------------------
        r_max = self.doubleSpinBox_searchR_max.value()
        r_min = self.doubleSpinBox_searchR_min.value()
        if r_min <= 0:
            r_min = r_max
        azimuth = self.doubleSpinBox_search_azimuth.value()

        theta = np.linspace(0, 2 * np.pi, 200)
        ellipse_x_local = r_max * np.cos(theta)
        ellipse_y_local = r_min * np.sin(theta)
        az_rad = np.radians(azimuth)
        # Rotate from local ellipse frame to map frame (inverse of the
        # rotation used in _estimate_single_point's search-ellipse test)
        ellipse_x = x_sel + ellipse_x_local * np.cos(az_rad) - ellipse_y_local * np.sin(az_rad)
        ellipse_y = y_sel + ellipse_x_local * np.sin(az_rad) + ellipse_y_local * np.cos(az_rad)
        ax.plot(ellipse_x, ellipse_y, color='#1f77b4', linewidth=1.4,
               linestyle='--', zorder=1, label='Search ellipse')

        # --- Equal axis scale: never stretched in either direction ----------
        ax.set_aspect('equal', adjustable='datalim')

        ax.set_xlabel('X', fontsize=8)
        ax.set_ylabel('Y', fontsize=8)
        ax.set_title('Neighbors for point %d/%d' %
                     (idx + 1, len(self._cross_val_results)), fontsize=10)
        ax.grid(True, linestyle=':', linewidth=0.4, alpha=0.5)
        ax.tick_params(axis='both', labelsize=7)
        # Place legend outside the axes, further right than the colorbar
        # (which sits immediately right of the axes), so the two never
        # overlap regardless of point layout.
        legend_x = 1.32 if used_idx else 1.02
        ax.legend(fontsize=7, loc='center left', bbox_to_anchor=(legend_x, 0.5),
                 framealpha=0.9, borderaxespad=0.0)

        # tight_layout() does not reliably reserve space for artists placed
        # outside the axes via bbox_to_anchor; reserve the right margin
        # manually instead so the legend/colorbar are never clipped.
        right_margin = 0.62 if used_idx else 0.78
        self.figure_cross_neighb.subplots_adjust(left=0.12, right=right_margin,
                                                 top=0.90, bottom=0.12)
        self.canvas_cross_neighb.draw()

    def prompt_save_path(self):
            """Open a file-save dialog and return the chosen output path."""
            layer = self.mMapLayerComboBox.currentLayer()
            field_name = self.mFieldComboBox.currentField()
            
            if not layer or not field_name:
                QtWidgets.QMessageBox.warning(self, "Attenzione", "Seleziona un layer e una variabile validi.")
                return None
    
            # Suggested output file name
            # Set up the kriging type
            is_uk = self.radioButton_UniversalKriging.isChecked()
            is_sk = self.radioButton_SimpleKriging.isChecked()
            is_ok = self.radioButton_OrdinaryKriging.isChecked()
            if is_ok:
                 string_name_type="ok"
            elif is_uk:
                 string_name_type="uk"
            else:
                string_name_type="sk"
            suggested_name = f"{field_name}_{string_name_type}.tif"
            
            # Open the save-file dialog
            path, _ = QtWidgets.QFileDialog.getSaveFileName(
                self, "Save Estimated Raster", suggested_name, "GeoTIFF (*.tif)"
            )
            
            if path:
                # Check existence both on disk and inside the QGIS project
                final_path = self.get_unique_filename(path)
                self.lineEdit_estimated_layer_name.setText(final_path)
                return final_path
            return None
    def get_unique_filename(self, path):
            """Controlla se il file esiste su disco o nei layer di QGIS e aggiunge un indice."""
            base, ext = os.path.splitext(path)
            counter = 1
            current_path = path
            
            # Check if the output file already exists on disk
            # Check if a layer with this name already exists in the QGIS project
            while os.path.exists(current_path) or QgsProject.instance().mapLayersByName(os.path.basename(current_path)):
                current_path = f"{base}_{counter}{ext}"
                counter += 1
            return current_path
